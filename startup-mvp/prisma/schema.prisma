model LeaveApplication {
  id          String       @id @default(cuid())
  employeeId  String
  leaveTypeId String
  startDate   DateTime     @db.Date
  endDate     DateTime     @db.Date
  totalDays   Int
  reason      String?
  status      LeaveStatus  @default(PENDING)
  managerId   String?
  hrId        String?
  isTrash     Boolean      @default(false)
  createdBy   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attendances Attendance[]
  creator     User         @relation("LeaveAppCreator", fields: [createdBy], references: [id])
  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  hr          User?        @relation("LeaveHR", fields: [hrId], references: [id])
  leaveType   LeaveType    @relation(fields: [leaveTypeId], references: [id])
  manager     User?        @relation("LeaveManager", fields: [managerId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([managerId])
  @@index([hrId])
}

model Resignation {
  id            String            @id @default(cuid())
  employeeId    String
  resignDate    DateTime          @db.Date
  effectiveDate DateTime          @db.Date
  reason        String?
  status        ResignationStatus @default(PENDING)
  managerId     String?
  adminId       String?
  isTrash       Boolean           @default(false)
  createdBy     String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  
  employee      Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  creator       User              @relation("ResignationCreator", fields: [createdBy], references: [id])
  manager       User?             @relation("ResignationManager", fields: [managerId], references: [id])
  admin         User?             @relation("ResignationAdmin", fields: [adminId], references: [id])

  @@index([employeeId])
  @@index([status])
}

model AttendanceLog {
  id         String           @id @default(cuid())
  employeeId String
  timestamp  DateTime
  source     AttendanceSource
  deviceId   String?
  createdAt  DateTime         @default(now())
  device     BiometricDevice? @relation(fields: [deviceId], references: [id])
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, timestamp])
  @@index([employeeId])
  @@index([timestamp])
}

model Attendance {
  id                       String            @id @default(cuid())
  employeeId               String
  date                     DateTime          @db.Date
  shiftId                  String?
  checkIn                  DateTime?
  checkOut                 DateTime?
  breakCheckOut            DateTime?
  breakCheckIn             DateTime?
  breakLateMinutes         Int               @default(0)
  breakLateCountValue      Decimal           @default(0) @db.Decimal(5, 2)
  workHours                Decimal           @default(0) @db.Decimal(5, 2)
  otHours                  Decimal           @default(0) @db.Decimal(5, 2)
  status                   AttendanceStatus
  isManual                 Boolean           @default(false)
  notes                    String?
  isLocked                 Boolean           @default(false)
  createdBy                String?
  updatedBy                String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  leaveApplicationId       String?
  creator                  User?             @relation("AttendanceCreator", fields: [createdBy], references: [id])
  employee                 Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveApplication         LeaveApplication? @relation(fields: [leaveApplicationId], references: [id])
  shift                    Shift?            @relation(fields: [shiftId], references: [id])
  updater                  User?             @relation("AttendanceUpdater", fields: [updatedBy], references: [id])
  lateMinutes              Int               @default(0)
  lateCountValue           Decimal           @default(0) @db.Decimal(5, 2)
  lateDeductionAmount      Decimal           @default(0) @db.Decimal(12, 2)
  tiffinBillAmount         Decimal           @default(0) @db.Decimal(12, 2)
  nightBillAmount          Decimal           @default(0) @db.Decimal(12, 2)
  holidayBillAmount        Decimal           @default(0) @db.Decimal(12, 2)
  calculatedOvertimeAmount Decimal           @default(0) @db.Decimal(12, 2)
  policyCalculationNote    String?

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
  @@index([employeeId, date])
  @@index([isLocked])
}

model Overtime {
  id          String   @id @default(cuid())
  employeeId  String
  date        DateTime @db.Date
  hours       Decimal  @db.Decimal(5, 2)
  ratePerHour Decimal  @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(12, 2)
  status      String   @default("approved")
  isLocked    Boolean  @default(false)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  creator     User     @relation("OvertimeCreator", fields: [createdBy], references: [id])
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([date])
  @@index([status])
}

model EmployeeLoan {
  id                 String     @id @default(cuid())
  employeeId         String
  amount             Decimal    @db.Decimal(12, 2)
  monthlyInstallment Decimal    @db.Decimal(12, 2)
  remainingBalance   Decimal    @db.Decimal(12, 2)
  issueDate          DateTime   @db.Date
  tenureMonths       Int
  purpose            String?
  status             LoanStatus @default(PENDING)
  voucherId          String?
  approvedBy         String?
  createdBy          String
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  approver           User?      @relation("LoanApprover", fields: [approvedBy], references: [id])
  employee           Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  voucher            Voucher?   @relation(fields: [voucherId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([status])
  @@index([voucherId])
}

model EmployeeSalary {
  id            String   @id @default(cuid())
  employeeId    String   @unique
  basic         Decimal  @default(0) @db.Decimal(12, 2)
  houseRent     Decimal  @default(0) @db.Decimal(12, 2)
  medical       Decimal  @default(0) @db.Decimal(12, 2)
  transport     Decimal  @default(0) @db.Decimal(12, 2)
  foodAllowance Decimal  @default(0) @db.Decimal(12, 2)
  taxPercentage Decimal  @default(0) @db.Decimal(5, 2)
  pfPercentage  Decimal  @default(0) @db.Decimal(5, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Payroll {
  id             String        @id @default(cuid())
  payrollNumber  String        @unique
  month          Int
  year           Int
  dateGenerated  DateTime      @default(now())
  status         PayrollStatus @default(DRAFT)
  totalAmount    Decimal       @default(0) @db.Decimal(12, 2)
  voucherId      String?       @unique
  paymentVchId   String?       @unique
  notes          String?
  isTrash        Boolean       @default(false)
  createdBy      String
  approvedBy     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  approver       User?         @relation("PayrollApprover", fields: [approvedBy], references: [id])
  creator        User          @relation("PayrollCreator", fields: [createdBy], references: [id])
  paymentVoucher Voucher?      @relation("PayrollPaymentVoucher", fields: [paymentVchId], references: [id], onDelete: Restrict)
  voucher        Voucher?      @relation("PayrollVoucher", fields: [voucherId], references: [id], onDelete: Restrict)
  items          PayrollItem[]
  fines          EmployeeFine[]
  bonuses        EmployeeBonus[]

  @@index([month, year])
  @@index([status])
  @@index([voucherId])
  @@index([month, year, status])
}

model PayrollItem {
  id               String   @id @default(cuid())
  payrollId        String
  employeeId       String
  basic            Decimal  @default(0) @db.Decimal(12, 2)
  houseRent        Decimal  @default(0) @db.Decimal(12, 2)
  medical          Decimal  @default(0) @db.Decimal(12, 2)
  transport        Decimal  @default(0) @db.Decimal(12, 2)
  foodAllowance    Decimal  @default(0) @db.Decimal(12, 2)
  otAmount         Decimal  @default(0) @db.Decimal(12, 2)
  bonus            Decimal  @default(0) @db.Decimal(12, 2)
  grossPay         Decimal  @default(0) @db.Decimal(12, 2)
  absentDeduction  Decimal  @default(0) @db.Decimal(12, 2)
  loanDeduction    Decimal  @default(0) @db.Decimal(12, 2)
  taxDeduction     Decimal  @default(0) @db.Decimal(12, 2)
  pfDeduction      Decimal  @default(0) @db.Decimal(12, 2)
  totalDeduction   Decimal  @default(0) @db.Decimal(12, 2)
  netPay           Decimal  @default(0) @db.Decimal(12, 2)
  status           String   @default("unpaid")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  employee         Employee @relation(fields: [employeeId], references: [id])
  payroll          Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  tiffinAllowance  Decimal  @default(0) @db.Decimal(12, 2)
  nightAllowance   Decimal  @default(0) @db.Decimal(12, 2)
  holidayAllowance Decimal  @default(0) @db.Decimal(12, 2)
  otherAllowance   Decimal  @default(0) @db.Decimal(12, 2)
  lateDeduction    Decimal  @default(0) @db.Decimal(12, 2)
  otherDeduction   Decimal  @default(0) @db.Decimal(12, 2)
  customFine       Decimal  @default(0) @db.Decimal(12, 2)
  customBonus      Decimal  @default(0) @db.Decimal(12, 2)

  @@unique([payrollId, employeeId])
  @@index([employeeId])
  @@index([status])
  @@index([employeeId, status])
}

model BiometricSyncLog {
  id           String           @id @default(cuid())
  syncTime     DateTime         @default(now())
  vendor       String
  deviceId     String?
  recordsCount Int              @default(0)
  status       String           @default("SUCCESS")
  errorMessage String?
  syncedBy     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  device       BiometricDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  user         User?            @relation(fields: [syncedBy], references: [id], onDelete: SetNull)

  @@index([syncTime])
  @@index([vendor])
}

model BiometricDevice {
  id             String              @id @default(cuid())
  name           String
  vendor         String
  connectionType String              @default("IP")
  deviceType     String              @default("ATTENDANCE")
  connectionMode String              @default("ADMS")
  ipAddress      String?
  port           Int?                @default(4370)
  apiKey         String?
  serialNumber   String?             @unique
  location       String?
  username       String?
  password       String?
  status         String              @default("active")
  isActive       Boolean             @default(true)
  lastSyncAt     DateTime?
  lastPingAt     DateTime?
  createdBy      String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  warehouseId    String?
  warehouse      Warehouse?          @relation(fields: [warehouseId], references: [id])
  attendanceLogs AttendanceLog[]
  syncLogs       BiometricSyncLog[]
  deviceMappings EmployeeDeviceMap[]
  commands       BiometricCommand[]

  @@index([vendor])
  @@index([status])
  @@index([warehouseId])
}

enum BiometricUserSyncStatus {
  NOT_SYNCED
  READY
  DRY_RUN_READY
  SYNCED
  FAILED
  DISABLED
}

model EmployeeDeviceMap {
  id             String                   @id @default(cuid())
  employeeId     String
  deviceId       String
  deviceUserId   String
  isActive       Boolean                  @default(true)
  syncStatus     BiometricUserSyncStatus  @default(NOT_SYNCED)
  lastSyncedAt   DateTime?
  lastSyncStatus String?
  lastSyncError  String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  device         BiometricDevice          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee       Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([deviceId, deviceUserId])
  @@unique([employeeId, deviceId])
  @@index([employeeId])
  @@index([deviceId])
}

model BiometricRawLog {
  id                 String    @id @default(cuid())
  deviceId           String?
  deviceSerialNumber String?
  deviceUserId       String?
  punchTime          DateTime?
  rawData            String    @db.Text
  source             String
  syncStatus         String    @default("PENDING")
  createdAt          DateTime  @default(now())

  @@index([deviceId])
  @@index([deviceSerialNumber])
  @@index([syncStatus])
  @@unique([deviceSerialNumber, deviceUserId, punchTime])
}

model UnmappedBiometricLog {
  id                 String   @id @default(cuid())
  deviceSerialNumber String?
  deviceUserId       String
  punchTime          DateTime
  rawData            String?  @db.Text
  reason             String   @default("EMPLOYEE_NOT_FOUND")
  status             String   @default("UNRESOLVED")
  createdAt          DateTime @default(now())

  @@index([deviceSerialNumber, deviceUserId])
  @@index([createdAt])
  @@unique([deviceSerialNumber, deviceUserId, punchTime])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum VoucherType {
  PAYMENT
  RECEIPT
  JOURNAL
  CONTRA
  SALES
  PURCHASE
  RETURN
  DAMAGE
}

enum CashBankAccountType {
  CASH
  BANK
  MFS
}

enum PurchaseStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  RETURNED
}

enum ProductionOrderStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
  RETURN
}

enum OrderType {
  READY_PRODUCT
  RETAIL
  WHOLESALE
  RETURN
  ECOM
  EXCHANGE
}

enum ItemType {
  RAW_MATERIAL
  READY_PRODUCT
  RETAIL
  WHOLESALE
}

enum StockTransactionType {
  IN
  OUT
  ADJUSTMENT
  DAMAGE
  PRODUCTION
  PURCHASE_RETURN
  TRANSFER
}

enum EmploymentType {
  PERMANENT
  TEMPORARY
  CONTRACT
  INTERN
  DAILY_WORKER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  LATE
  HALF_DAY
  HOLIDAY
  WEEKEND
}

enum LeaveCategory {
  CASUAL
  SICK
  ANNUAL
  MATERNITY
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  MANAGER_APPROVED
  HR_APPROVED
  REJECTED
  CANCELLED
}

enum ResignationStatus {
  PENDING
  MANAGER_APPROVED
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  REVIEWED
  APPROVED
  POSTED
  PAID
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  CLOSED
}

enum AttendanceSource {
  MANUAL
  WEB
  MOBILE
  BIOMETRIC
  API
}

enum NotificationType {
  SYSTEM
  ADMIN
  INFO
  WARNING
  ERROR
  SUCCESS
}

enum InventoryDamageStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum InventoryAdjustmentStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

// ============================================
// GARMENTS BRAND ERP EXTENSIONS (PHASE 1)
// ============================================

model Season {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  styles    Item[]
  createdAt DateTime @default(now())
}

model Collection {
  id        String   @id @default(cuid())
  name      String   @unique
  styles    Item[]
  createdAt DateTime @default(now())
}

model Fabric {
  id          String   @id @default(cuid())
  name        String   @unique
  gsm         Int?
  composition String?
  styles      Item[]
  createdAt   DateTime @default(now())
}

model ProductVariant {
  id                       String                     @id @default(cuid())
  sku                      String                     @unique
  barcode                  String?                    @unique
  size                     String
  color                    String
  costPrice                Decimal?                   @db.Decimal(12, 2)
  salesPrice               Decimal?                   @db.Decimal(12, 2)
  wholesalePrice           Decimal?                   @db.Decimal(12, 2)
  wholesaleDiscountAmount  Decimal?                   @db.Decimal(12, 2)
  image                    String?
  itemId                   String
  item                     Item                       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  stocks                   Stock[]
  stockLedgers             StockLedger[]
  purchaseItems            PurchaseItem[]
  inventoryDamageItems     InventoryDamageItem[]
  saleItems                SaleItem[]
  clientDiscounts          ClientItemDiscount[]
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  returnToVendorItems      ReturnToVendorItem[]
  tpnItems                 TransferPurchaseNoteItem[]
  grnItems                 GRNItem[]
  inventoryAdjustmentItems InventoryAdjustmentItem[]
  inventoryCountEntries    InventoryCountEntry[]

  @@index([itemId])
  @@index([sku])
  @@index([barcode])
}

model GarmentProductionStage {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  stageName         String
  piecesTarget      Int
  piecesPassed      Int             @default(0)
  piecesDefect      Int             @default(0)
  status            String          @default("PENDING")
  updatedAt         DateTime        @updatedAt
}

model CuttingJob {
  id                 String                 @id @default(cuid())
  productionOrderId  String
  productionOrder    ProductionOrder        @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  fabricRollsCount   Int
  fabricWeightIssued Decimal                @db.Decimal(10, 2)
  markerLengthMeter  Decimal                @db.Decimal(6, 2)
  pliesCount         Int
  piecesExpected     Int
  piecesCutActual    Int
  fabricWastageKg    Decimal                @db.Decimal(10, 2)
  createdAt          DateTime               @default(now())
  fabricRolls        CuttingJobFabricRoll[]
  bundles            ProductionBundle[]
}

model SewingLineTrack {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  lineCode          String
  operatorCount     Int
  targetPerHour     Int
  actualPieces      Int             @default(0)
  sewingDefects     Int             @default(0)
  hoursTracked      Decimal         @db.Decimal(4, 2)
  createdAt         DateTime        @default(now())
}

model WashingJob {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  washType          String
  shrinkageTarget   Decimal         @map("shrinkageTargetPercent") @db.Decimal(4, 2)
  shrinkageActual   Decimal         @map("shrinkageActualPercent") @db.Decimal(4, 2)
  temperatureC      Int
  chemicalRatios    Json?
  createdAt         DateTime        @default(now())
}

model CMTCostBreakdown {
  id                String          @id @default(cuid())
  productionOrderId String          @unique
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  cuttingCostPiece  Decimal         @db.Decimal(8, 2)
  sewingCostPiece   Decimal         @db.Decimal(8, 2)
  trimCostPiece     Decimal         @db.Decimal(8, 2)
  washingCostPiece  Decimal         @db.Decimal(8, 2)
  packingCostPiece  Decimal         @db.Decimal(8, 2)
}

model ClientItemDiscount {
  id            String          @id @default(cuid())
  clientId      String
  client        Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  itemId        String?
  item          Item?           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  discountType  String          @default("PERCENTAGE") // "FLAT" or "PERCENTAGE"
  discountValue Decimal         @db.Decimal(12, 2)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([clientId])
  @@index([itemId])
  @@index([variantId])
}

// ============================================
// GARMENTS BRAND ERP EXTENSIONS (PHASE 2)
// ============================================

model IndustrialEngineeringBreakdown {
  id               String             @id @default(cuid())
  itemId           String             @unique
  item             Item               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  totalSAM         Decimal            @db.Decimal(6, 2)
  targetEffPercent Decimal            @default(100.00) @db.Decimal(5, 2)
  operatorCount    Int                @default(0)
  helperCount      Int                @default(0)
  pitchTime        Decimal?           @db.Decimal(6, 2)
  operations       GarmentOperation[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([itemId])
}

model GarmentOperation {
  id            String                         @id @default(cuid())
  breakdownId   String
  breakdown     IndustrialEngineeringBreakdown @relation(fields: [breakdownId], references: [id], onDelete: Cascade)
  sequence      Int
  operationName String
  machineType   String
  sam           Decimal                        @db.Decimal(5, 2)
  operatorGrade String?
  targetPerHour Int?
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt

  @@index([breakdownId])
  @@index([sequence])
}

model FabricRoll {
  id             String                 @id @default(cuid())
  rollNumber     String                 @unique
  itemId         String
  item           Item                   @relation(fields: [itemId], references: [id])
  supplierRollId String?
  shade          String?
  gsmActual      Int?
  widthInch      Decimal?               @db.Decimal(5, 2)
  weightKg       Decimal                @db.Decimal(8, 2)
  lengthMeter    Decimal?               @db.Decimal(8, 2)
  status         String                 @default("AVAILABLE") // AVAILABLE, RESERVED, ISSUED, CONSUMED
  warehouseId    String?
  warehouse      Warehouse?             @relation(fields: [warehouseId], references: [id])
  cuttingJobs    CuttingJobFabricRoll[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([itemId])
  @@index([warehouseId])
  @@index([status])
}

model CuttingJobFabricRoll {
  id           String     @id @default(cuid())
  cuttingJobId String
  cuttingJob   CuttingJob @relation(fields: [cuttingJobId], references: [id], onDelete: Cascade)
  fabricRollId String
  fabricRoll   FabricRoll @relation(fields: [fabricRollId], references: [id], onDelete: Cascade)
  weightUsedKg Decimal    @db.Decimal(8, 2)
  allocatedAt  DateTime   @default(now())

  @@unique([cuttingJobId, fabricRollId])
  @@index([cuttingJobId])
  @@index([fabricRollId])
}

model ProductionBundle {
  id           String           @id @default(cuid())
  bundleNumber String           @unique
  cuttingJobId String
  cuttingJob   CuttingJob       @relation(fields: [cuttingJobId], references: [id], onDelete: Cascade)
  size         String
  color        String
  quantity     Int
  plyStart     Int?
  plyEnd       Int?
  status       String           @default("CUTTING_COMPLETED")
  scans        RFIDBundleScan[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([cuttingJobId])
  @@index([status])
}

model RFIDBundleScan {
  id          String           @id @default(cuid())
  bundleId    String
  bundle      ProductionBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  rfidTag     String?
  station     String
  lineCode    String?
  scannedById String?
  scannedBy   User?            @relation(fields: [scannedById], references: [id])
  scanTime    DateTime         @default(now())
  status      String           @default("SUCCESS")

  @@index([bundleId])
  @@index([rfidTag])
  @@index([station])
  @@index([scanTime])
}

model ReturnToVendor {
  id          String               @id @default(cuid())
  rtvNumber   String               @unique
  purchaseId  String? // Optional link to original purchase
  supplierId  String
  warehouseId String
  date        DateTime             @default(now())
  status      ReturnToVendorStatus @default(DRAFT)
  notes       String?
  subTotal    Decimal              @db.Decimal(12, 2)
  tax         Decimal?             @db.Decimal(5, 2)
  grandTotal  Decimal              @db.Decimal(12, 2)
  createdBy   String
  updatedBy   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  voucherId   String? // Link to financial debit note

  // Relations
  purchase  Purchase?            @relation(fields: [purchaseId], references: [id])
  supplier  Supplier             @relation(fields: [supplierId], references: [id])
  warehouse Warehouse            @relation(fields: [warehouseId], references: [id])
  voucher   Voucher?             @relation(fields: [voucherId], references: [id])
  items     ReturnToVendorItem[]

  @@index([purchaseId])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([voucherId])
  @@index([status])
  @@index([date])
