  Project   Project?   @relation(fields: [projectId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([projectId])
  @@index([milestoneId])
  @@index([issueId])
  // Timeline optimization index
  @@index([entityType, entityId, createdAt(sort: Desc)], map: "idx_doc_entity_created")
}

model settings {
