  revisedContractAmount     Decimal? @db.Decimal(12, 2)

  // Approval & Lifecycle Timestamps
  approvalRequestId String?
  submittedAt       DateTime?
  analyzedAt        DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  appliedAt         DateTime?
  cancelledAt       DateTime?
  rejectionReason   String?

  createdById            String
  updatedById            String?
  idempotencyKey         String?  @unique
  idempotencyPayloadHash String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  Organization    Organization        @relation(fields: [organizationId], references: [id])
  Project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  Client          Client?             @relation(fields: [clientId], references: [id])
  Agreement       Agreement?          @relation(fields: [agreementId], references: [id])
  ServiceSale     ServiceSale?        @relation(fields: [serviceSaleId], references: [id])
  BillingPlan     ProjectBillingPlan? @relation(fields: [billingPlanId], references: [id])
  SupportTicket   SupportTicket?      @relation(fields: [supportTicketId], references: [id])
  ApprovalRequest ApprovalRequest?    @relation(fields: [approvalRequestId], references: [id])
  CreatedBy       User                @relation("CRCreatedBy", fields: [createdById], references: [id])

  CommercialAmendments CommercialAmendment[]
  IssueLinks           ChangeRequestIssueLink[]
  TaskLinks            ChangeRequestTaskLink[]
  AuditLogs            ChangeRequestAuditLog[]

  @@index([organizationId])
  @@index([projectId])
  @@index([clientId])
  @@index([status])
  @@index([approvalRequestId])
}

