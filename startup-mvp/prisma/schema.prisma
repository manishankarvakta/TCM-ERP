  feedback     String? // Review comments from Admin/Manager
  reviewedAt   DateTime?
  reviewedById String?
  comments     String?   @db.Text
  completed    String?   @db.Text
  pending      String?   @db.Text
  blocked      String?   @db.Text
  newWork      String?   @db.Text
