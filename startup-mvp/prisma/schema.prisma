  order   Int      @default(0)
  addedAt DateTime @default(now())

  User User @relation("MyDayUser", fields: [userId], references: [id], onDelete: Cascade)
  Task Task @relation("MyDayTask", fields: [taskId], references: [id], onDelete: Cascade)

