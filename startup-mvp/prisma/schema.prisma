}

model TransferPurchaseNote {
  id                     String         @id @default(cuid())
  tpnNumber              String         @unique
  sourceWarehouseId      String
  destinationWarehouseId String
  date                   DateTime       @default(now())
  status                 TransferStatus @default(DRAFT)
  notes                  String?
  isTrash                Boolean        @default(false)
  createdBy              String
  updatedBy              String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  sourceWarehouse      Warehouse                  @relation("TPNSource", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse Warehouse                  @relation("TPNDestination", fields: [destinationWarehouseId], references: [id])
  createdByUser        User                       @relation("TPNCreatedBy", fields: [createdBy], references: [id])
  updatedByUser        User?                      @relation("TPNUpdatedBy", fields: [updatedBy], references: [id])
  items                TransferPurchaseNoteItem[]
  grns                 GRN[]

  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@index([status])
  @@index([date])
}

model TransferPurchaseNoteItem {
  id        String  @id @default(cuid())
  tpnId     String
  itemId    String
  variantId String?
  quantity  Decimal @db.Decimal(10, 2)

  tpn      TransferPurchaseNote @relation(fields: [tpnId], references: [id], onDelete: Cascade)
  item     Item                 @relation(fields: [itemId], references: [id])
  variant  ProductVariant?      @relation(fields: [variantId], references: [id])
  grnItems GRNItem[]

  @@index([tpnId])
  @@index([itemId])
  @@index([variantId])
}

enum TransferStatus {
  DRAFT
  SHIPPED
  RECEIVED
  CANCELLED
}

enum GRNStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model GRN {
  id          String    @id @default(cuid())
  grnNumber   String    @unique
  purchaseId  String?
  tpnId       String?
  warehouseId String
  date        DateTime  @default(now())
  status      GRNStatus @default(DRAFT)
  notes       String?
  isTrash     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String
  updatedBy   String?
  voucherId   String?

  purchase  Purchase?             @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  tpn       TransferPurchaseNote? @relation(fields: [tpnId], references: [id], onDelete: Cascade)
  warehouse Warehouse             @relation(fields: [warehouseId], references: [id])
  creator   User                  @relation("GRNCreator", fields: [createdBy], references: [id])
  updater   User?                 @relation("GRNUpdater", fields: [updatedBy], references: [id])
  voucher   Voucher?              @relation(fields: [voucherId], references: [id])
  items     GRNItem[]

  @@index([purchaseId])
  @@index([tpnId])
  @@index([warehouseId])
  @@index([voucherId])
  @@index([status])
  @@index([date])
  @@index([grnNumber])
  @@index([createdBy])
  @@index([isTrash])
}

model GRNItem {
  id               String   @id @default(cuid())
  grnId            String
  purchaseItemId   String?
  tpnItemId        String?
  itemId           String?
  variantId        String?
  receivedQuantity Decimal  @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  grn          GRN                       @relation(fields: [grnId], references: [id], onDelete: Cascade)
  purchaseItem PurchaseItem?             @relation(fields: [purchaseItemId], references: [id], onDelete: Cascade)
  tpnItem      TransferPurchaseNoteItem? @relation(fields: [tpnItemId], references: [id], onDelete: Cascade)
  item         Item?                     @relation(fields: [itemId], references: [id])
  variant      ProductVariant?           @relation(fields: [variantId], references: [id])

  @@index([grnId])
  @@index([purchaseItemId])
  @@index([tpnItemId])
  @@index([itemId])
  @@index([variantId])
}

model BiometricCommand {
