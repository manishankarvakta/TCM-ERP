generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                               String                 @id @default(cuid())
  name                             String?
  email                            String                 @unique
  emailVerified                    DateTime?
  password                         String
  image                            String?
  role                             String                 @default("user")
  status                           String                 @default("active")
  createdAt                        DateTime               @default(now())
  updatedAt                        DateTime               @updatedAt
  designationTemplateId            String?
  permissions                      Json?
  inchargeId                       String?
  defaultWarehouseId               String?
  isActive                         String                 @default("")
  accounts                         Account[]
  createdAttendances               Attendance[]           @relation("AttendanceCreator")
  updatedAttendances               Attendance[]           @relation("AttendanceUpdater")
  createdBOMs                      BOM[]                  @relation("BOMCreator")
  biometricSyncLogs                BiometricSyncLog[]
  biometricCommands                BiometricCommand[]

  CashBankAccount                  CashBankAccount[]
  ChartOfAccount                   ChartOfAccount[]
  createdClients                   Client[]               @relation("ClientCreator")
  Employee                         Employee?              @relation("UserEmployee")
  approvedLoans                    EmployeeLoan[]         @relation("LoanApprover")
  files                            File[]
  createdHolidays                  Holiday[]              @relation("HolidayCreator")
  InventoryAdjustmentCreated       InventoryAdjustment[]  @relation("InventoryAdjustment_createdBy")
  InventoryAdjustmentUpdated       InventoryAdjustment[]  @relation("InventoryAdjustment_updatedBy")
  createdItems                     Item[]                 @relation("ItemCreator")
  JournalEntryLine                 JournalEntryLine[]
  createdLeaveApps                 LeaveApplication[]     @relation("LeaveAppCreator")
  hrLeaves                         LeaveApplication[]     @relation("LeaveHR")
  managedLeaves                    LeaveApplication[]     @relation("LeaveManager")
  createdLeaveTypes                LeaveType[]            @relation("LeaveTypeCreator")
  createdResignations              Resignation[]          @relation("ResignationCreator")
  managedResignations              Resignation[]          @relation("ResignationManager")
  adminResignations                Resignation[]          @relation("ResignationAdmin")
  createdEmployeeTypes             EmployeeType[]         @relation("EmployeeTypeCreator")
  createdDepartments             Department[]           @relation("DepartmentCreator")
  createdDesignations            Designation[]          @relation("DesignationCreator")
  createdFloors                  Floor[]                @relation("FloorCreator")
  createdLines                   Line[]                 @relation("LineCreator")
  createdNotifications             Notification[]         @relation("NotificationCreator")
  notifications                    Notification[]
  createdOrganizations             Organization[]         @relation("OrganizationCreator")
  createdOvertimes                 Overtime[]             @relation("OvertimeCreator")
  approvedPayrolls                 Payroll[]              @relation("PayrollApprover")
  createdPayrolls                  Payroll[]              @relation("PayrollCreator")
  createdProductionOrders          ProductionOrder[]      @relation("ProductionOrderCreator")
  createdPurchases                 Purchase[]             @relation("PurchaseCreatedBy")
  updatedPurchases                 Purchase[]             @relation("PurchaseUpdatedBy")
  createdSales                     Sale[]                 @relation("SaleCreatedBy")
  updatedSales                     Sale[]                 @relation("SaleUpdatedBy")
  sessions                         Session[]
  createdShifts                    Shift[]                @relation("ShiftCreator")
  createdStockLedgers              StockLedger[]          @relation("StockLedgerCreator")
  createdSuppliers                 Supplier[]             @relation("SupplierCreator")
  createdUnits                     Unit[]                 @relation("UnitCreator")
  defaultWarehouse                 Warehouse?             @relation("UserDefaultWarehouse", fields: [defaultWarehouseId], references: [id])
  designationTemplate              PermissionTemplate?    @relation("UserDesignationTemplate", fields: [designationTemplateId], references: [id])
  incharge                         User?                  @relation("UserIncharge", fields: [inchargeId], references: [id])
  inchargeOf                       User[]                 @relation("UserIncharge")
  userLogs                         UserLog[]
  userPermissions                  UserPermission[]
  Voucher_Voucher_createdByToUser  Voucher[]              @relation("Voucher_createdByToUser")
  Voucher_Voucher_postedByIdToUser Voucher[]              @relation("Voucher_postedByIdToUser")
  Voucher_Voucher_userIdToUser     Voucher[]              @relation("Voucher_userIdToUser")
  VoucherLine                      VoucherLine[]
  createdWarehouses                Warehouse[]            @relation("WarehouseCreator")
  createdSettings                  Settings[]             @relation("SettingsCreator")
  settings                         Settings[]             @relation("SettingsUser")
  billerClosingSessions            POSClosingSession[]    @relation("BillerClosingSessions")
  managerClosingVerifications       POSClosingSession[]    @relation("ManagerClosingVerifications")
  createdMembershipTiers           MembershipTier[]       @relation("MembershipTierCreator")
  rfidBundleScans                  RFIDBundleScan[]
  createdTPNs                      TransferPurchaseNote[] @relation("TPNCreatedBy")
  updatedTPNs                      TransferPurchaseNote[] @relation("TPNUpdatedBy")
  createdGRNs                      GRN[]                  @relation("GRNCreator")
  updatedGRNs                      GRN[]                  @relation("GRNUpdater")
  inventoryDamages                 InventoryDamage[]
  createdSalaryStructurePolicies   SalaryStructurePolicy[] @relation("SalaryStructurePolicyCreator")
  createdAttendancePolicies        AttendancePolicy[]      @relation("AttendancePolicyCreator")
  createdLatePolicies              LatePolicy[]            @relation("LatePolicyCreator")
  createdOvertimePolicies          OvertimePolicy[]        @relation("OvertimePolicyCreator")
  createdTiffinBillPolicies        TiffinBillPolicy[]      @relation("TiffinBillPolicyCreator")
  createdNightBillPolicies         NightBillPolicy[]       @relation("NightBillPolicyCreator")
  createdHolidayBillPolicies       HolidayBillPolicy[]     @relation("HolidayBillPolicyCreator")
  inventoryCountEntries            InventoryCountEntry[]   @relation("InventoryCountCreator")
  createdFines                     EmployeeFine[]          @relation("FineCreator")
  approvedFines                    EmployeeFine[]          @relation("FineApprover")
  createdBonuses                   EmployeeBonus[]         @relation("BonusCreator")
  approvedBonuses                  EmployeeBonus[]         @relation("BonusApprover")

  @@index([status])
  @@index([designationTemplateId])
  @@index([inchargeId])
}

model Employee {
  id                     String              @id @default(cuid())
  name                   String
  employeeCode           String?             @unique
  email                  String?
  phone                  String?
  userId                 String?             @unique
  status                 String              @default("active")
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  salaryPayableAccountId String?
  advanceAccountId       String?
  address                Json?
  dateOfBirth            DateTime?
  department             String?
  designation            String?
  emergencyContact       Json?
  gender                 String?
  bloodGroup             String?
  joiningDate            DateTime?
  nationalId             String?
  photo                  String?
  salary                 Decimal?            @db.Decimal(12, 2)
  warehouseId            String?
  employmentType         EmploymentType?     @default(PERMANENT)
  type                   String?
  employeeTypeId         String?
  employeeType           EmployeeType?       @relation(fields: [employeeTypeId], references: [id], onDelete: Restrict)
  departmentId           String?
  departmentRelation     Department?         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designationId          String?
  designationRelation    Designation?        @relation(fields: [designationId], references: [id], onDelete: Restrict)
  floorId                String?
  floorRelation          Floor?              @relation(fields: [floorId], references: [id], onDelete: Restrict)
  lineId                 String?
  lineRelation           Line?               @relation(fields: [lineId], references: [id], onDelete: Restrict)
  skills                 Json?
  biometricDeviceId      String?
  nominee                Json?
  shiftId                String?
  attendances            Attendance[]
  attendanceLogs         AttendanceLog[]
  advanceAccount         ChartOfAccount?     @relation("Employee_advanceAccountIdToChartOfAccount", fields: [advanceAccountId], references: [id])
  salaryPayableAccount   ChartOfAccount?     @relation("Employee_salaryPayableAccountIdToChartOfAccount", fields: [salaryPayableAccountId], references: [id])
  shift                  Shift?              @relation("EmployeeShift", fields: [shiftId], references: [id])
  user                   User?               @relation("UserEmployee", fields: [userId], references: [id])
  warehouse              Warehouse?          @relation("WarehouseEmployees", fields: [warehouseId], references: [id])
  loans                  EmployeeLoan[]
  salaryStructure        EmployeeSalary?
  leaveApps              LeaveApplication[]
  resignations           Resignation[]
  overtimes              Overtime[]
  payrollItems           PayrollItem[]
  deviceMappings         EmployeeDeviceMap[]
  assistedSales          Sale[]              @relation("SaleSalesAssistant")
  fines                  EmployeeFine[]
  bonuses                EmployeeBonus[]

  @@index([userId])
  @@index([status])
  @@index([employeeCode])
  @@index([email])
  @@index([salaryPayableAccountId])
  @@index([advanceAccountId])
  @@index([warehouseId])
  @@index([departmentId])
  @@index([designationId])
  @@index([floorId])
  @@index([lineId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  code      String
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([code])
  @@index([expires])
}

model UserLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model File {
  id         String   @id @default(cuid())
  ownerId    String
  name       String
  path       String
  storageKey String   @unique
  size       Int
  mimeType   String
  isFolder   Boolean  @default(false)
  etag       String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([storageKey])
  @@index([path])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType
  userId    String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  readAt    DateTime?
  createdBy String?
  creator   User?            @relation("NotificationCreator", fields: [createdBy], references: [id])
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
  @@index([createdBy])
}

model Unit {
  id        String   @id @default(cuid())
  details   String
  symbol    String   @unique
  status    String   @default("active")
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     Item[]
  creator   User     @relation("UnitCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdBy])
}

model Organization {
  id               String             @id @default(cuid())
  name             String
  details          String?
  address          String?
  phone            String?
  email            String?
  website          String?
  logo             String?
  status           String             @default("active")
  createdBy        String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  JournalEntryLine JournalEntryLine[]
  creator          User               @relation("OrganizationCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  Voucher          Voucher[]
  VoucherLine      VoucherLine[]

  @@index([status])
  @@index([createdBy])
  @@index([name])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  description String?
  slug        String?    @unique
  image       String?
  status      String     @default("active")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items            Item[]     @relation("ItemCategory")
  subCategoryItems Item[]     @relation("ItemSubCategory")

  // Hierarchical relations
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryHierarchy")

  @@index([name])
  @@index([status])
  @@index([parentId])
}

model Brand {
  id          String   @id @default(cuid())
  name        String
  description String?
  slug        String?  @unique
  image       String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       Item[]

  @@index([name])
  @@index([status])
}

model Item {
  id                      String                    @id @default(cuid())
  code                    String                    @unique
  slug                    String?                   @unique
  description             String?
  unitId                  String
  costPrice               Decimal                   @db.Decimal(12, 2)
  status                  String                    @default("active")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  categoryId              String?
  brandId                 String?
  name                    String
  itemType                ItemType
  salesPrice              Decimal?                  @db.Decimal(12, 2)
  trackInventory          Boolean                   @default(false)
  isTrash                 Boolean                   @default(false)
  createdBy               String
  colors                  String[]
  discount                Decimal?                  @db.Decimal(12, 2)
  images                  Json?
  isEnableEcom            Boolean                   @default(false)
  sizes                   String[]
  wholesalePrice          Decimal?                  @db.Decimal(12, 2)
  wholesaleDiscountAmount Decimal?                  @db.Decimal(12, 2)
  featuredImage           String?
  isPromo                 Boolean                   @default(false)
  promoEndsAt             DateTime?
  bomAsFinishedGood       BOM[]                     @relation("BOMFinishedGood")
  bomAsRawMaterial        BOMItem[]                 @relation("BOMRawMaterial")
  InventoryAdjustmentItem InventoryAdjustmentItem[]
  subCategoryId           String?
  category                Category?                 @relation("ItemCategory", fields: [categoryId], references: [id])
  subCategory             Category?                 @relation("ItemSubCategory", fields: [subCategoryId], references: [id])
  brand                   Brand?                    @relation(fields: [brandId], references: [id])
  creator                 User                      @relation("ItemCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  unit                    Unit                      @relation(fields: [unitId], references: [id])
  productionOrders        ProductionOrder[]         @relation("ProductionOrderFG")
  purchaseItems           PurchaseItem[]
  saleItems               SaleItem[]
  stocks                  Stock[]
  stockLedgers            StockLedger[]

  // New Apparel Relations (Optional)
  seasonId                       String?
  season                         Season?                         @relation(fields: [seasonId], references: [id])
  collectionId                   String?
  collection                     Collection?                     @relation(fields: [collectionId], references: [id])
  fabricId                       String?
  fabric                         Fabric?                         @relation(fields: [fabricId], references: [id])
  fit                            String? // e.g., "Slim", "Relaxed"
  isVatEnabled                   Boolean                         @default(false)
  vatPercentage                  Decimal                         @default(0) @db.Decimal(5, 2)
  barcode                        String?                         @unique
  variants                       ProductVariant[]
  clientDiscounts                ClientItemDiscount[]
  industrialEngineeringBreakdown IndustrialEngineeringBreakdown?
  fabricRolls                    FabricRoll[]
  returnToVendorItems            ReturnToVendorItem[]
  tpnItems                       TransferPurchaseNoteItem[]
  grnItems                       GRNItem[]
  inventoryDamageItems           InventoryDamageItem[]
  inventoryCountEntries          InventoryCountEntry[]

  @@index([code])
  @@index([name])
  @@index([itemType])
  @@index([categoryId])
  @@index([unitId])
  @@index([status])
  @@index([isTrash])
  @@index([createdBy])
  @@index([barcode])
  @@index([subCategoryId])
}

model Warehouse {
  id                  String                 @id @default(cuid())
  name                String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  code                String                 @unique
  createdBy           String
  isTrash             Boolean                @default(false)
  status              String                 @default("active")
  address             String?
  city                String?
  country             String?
  state               String?
  zip                 String?
  employees           Employee[]             @relation("WarehouseEmployees")
  holidays            Holiday[]
  createdDamages      InventoryDamage[]
  InventoryAdjustment InventoryAdjustment[]
  productionOrders    ProductionOrder[]
  purchases           Purchase[]
  sales               Sale[]
  stocks              Stock[]
  stockLedgers        StockLedger[]
  defaultUsers        User[]                 @relation("UserDefaultWarehouse")
  creator             User                   @relation("WarehouseCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  cashBankAccounts    CashBankAccount[]      @relation("WarehouseCashBankAccounts")
  fabricRolls         FabricRoll[]
  returnToVendors     ReturnToVendor[]
  tpnSources          TransferPurchaseNote[] @relation("TPNSource")
  tpnDestinations     TransferPurchaseNote[] @relation("TPNDestination")
  grns                GRN[]
  biometricDevices    BiometricDevice[]
  inventoryCountEntries InventoryCountEntry[]
  vouchers            Voucher[]              @relation("WarehouseVouchers")
  clients             Client[]
  suppliers           Supplier[]
  posClosingSessions  POSClosingSession[]

  @@index([code])
  @@index([name])
  @@index([status])
  @@index([isTrash])
  @@index([createdBy])
}

model Stock {
  id               String          @id @default(cuid())
  itemId           String? // Optional for backward compatibility
  variantId        String? // New variant (SKU) relation
  warehouseId      String
  quantity         Decimal         @default(0) @db.Decimal(12, 2)
  reservedQuantity Decimal         @default(0) @db.Decimal(12, 2)
  lastUpdated      DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  item             Item?           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse        Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([itemId, warehouseId])
  @@unique([variantId, warehouseId])
  @@index([itemId])
  @@index([variantId])
  @@index([warehouseId])
  @@index([lastUpdated])
}

model StockLedger {
  id              String               @id @default(cuid())
  itemId          String? // Optional
  variantId       String? // New variant relation
  warehouseId     String
  transactionType StockTransactionType
  quantity        Decimal              @db.Decimal(12, 2)
  referenceType   String?
  referenceId     String?
  notes           String?
  createdAt       DateTime             @default(now())
  createdBy       String
  rate            Decimal?             @db.Decimal(12, 2)
  creator         User                 @relation("StockLedgerCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  item            Item?                @relation(fields: [itemId], references: [id], onDelete: Cascade)
  variant         ProductVariant?      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse       Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([variantId])
  @@index([warehouseId])
  @@index([transactionType])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@index([createdBy])
}

model BOM {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  description      String?
  itemId           String
  quantityPerUnit  Decimal           @db.Decimal(12, 2)
  status           String            @default("active")
  isTrash          Boolean           @default(false)
  createdBy        String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  creator          User              @relation("BOMCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  item             Item              @relation("BOMFinishedGood", fields: [itemId], references: [id])
  items            BOMItem[]
  productionOrders ProductionOrder[]

  @@index([code])
  @@index([itemId])
  @@index([status])
  @@index([isTrash])
  @@index([createdBy])
}

model BOMItem {
  id               String   @id @default(cuid())
  bomId            String
  itemId           String
  quantityRequired Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  bom              BOM      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  item             Item     @relation("BOMRawMaterial", fields: [itemId], references: [id])

  @@unique([bomId, itemId])
  @@index([bomId])
  @@index([itemId])
}

model ProductionOrder {
  id               String                   @id @default(cuid())
  code             String                   @unique
  bomId            String
  itemId           String
  warehouseId      String
  quantity         Decimal                  @db.Decimal(12, 2)
  status           ProductionOrderStatus    @default(PLANNED)
  notes            String?
  isTrash          Boolean                  @default(false)
  createdBy        String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  completedAt      DateTime?
  voucherId        String?
  bom              BOM                      @relation(fields: [bomId], references: [id])
  creator          User                     @relation("ProductionOrderCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  item             Item                     @relation("ProductionOrderFG", fields: [itemId], references: [id])
  voucher          Voucher?                 @relation(fields: [voucherId], references: [id])
  warehouse        Warehouse                @relation(fields: [warehouseId], references: [id])
  garmentStages    GarmentProductionStage[]
  cuttingJobs      CuttingJob[]
  sewingLineTracks SewingLineTrack[]
  washingJobs      WashingJob[]
  cmtCostBreakdown CMTCostBreakdown?

  @@index([code])
  @@index([bomId])
  @@index([itemId])
  @@index([warehouseId])
  @@index([status])
  @@index([voucherId])
  @@index([isTrash])
  @@index([createdBy])
}

model Client {
  id               String               @id @default(cuid())
  name             String?
  email            String?              @unique
  phone            String?
  address          String?
  city             String?
  state            String?
  zip              String?
  country          String?
  company          String?
  image            String?
  createdBy        String
  status           String               @default("active")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  chartOfAccountId String?
  warehouseId      String?
  clientCode       String?              @unique
  openingBalance   Decimal              @default(0) @db.Decimal(12, 2)
  ChartOfAccount   ChartOfAccount?      @relation(fields: [chartOfAccountId], references: [id])
  warehouse        Warehouse?           @relation(fields: [warehouseId], references: [id])
  createdByUser    User                 @relation("ClientCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  JournalEntryLine JournalEntryLine[]
  sales            Sale[]
  Voucher          Voucher[]
  VoucherLine      VoucherLine[]
  clientType       String               @default("regular")
  itemDiscounts    ClientItemDiscount[]
  membershipNumber String?              @unique
  membershipTier   String               @default("NONE")
  membershipTierId String?              @map("membership_tier_id")
  membershipTierRel MembershipTier?     @relation("ClientMembershipTier", fields: [membershipTierId], references: [id])
  membershipStatus String               @default("INACTIVE")
  membershipPoints Int                  @default(0)
  membershipExpiry DateTime?
  passwordHash            String?
  isLoginEnabled          Boolean              @default(false)
  lastLoginAt             DateTime?
  phoneVerifiedAt         DateTime?
  resetPasswordToken      String?
  resetPasswordExpiresAt  DateTime?
  addresses               ClientAddress[]
  documents               Json?

  @@index([status])
  @@index([createdBy])
  @@index([email])
  @@index([chartOfAccountId])
  @@index([warehouseId])
  @@index([clientCode])
  @@index([membershipNumber])
}

model ClientAddress {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  recipientName String
  phone         String
  addressLine   String
  area          String?
  city          String?
  district      String?
  division      String?
  country       String   @default("Bangladesh")
  isDefault     Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId])
  @@index([isDefault])
}

model Supplier {
  id               String             @id @default(cuid())
  name             String?
  email            String?            @unique
  phone            String?
  address          String?
  city             String?
  state            String?
  zip              String?
  country          String?
  company          String?
  image            String?
  createdBy        String
  status           String             @default("active")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  chartOfAccountId String?
  warehouseId      String?
  supplierCode     String?            @unique
  openingBalance   Decimal            @default(0) @db.Decimal(12, 2)
  JournalEntryLine JournalEntryLine[]
  Purchase         Purchase[]
  ChartOfAccount   ChartOfAccount?    @relation(fields: [chartOfAccountId], references: [id])
  warehouse        Warehouse?         @relation(fields: [warehouseId], references: [id])
