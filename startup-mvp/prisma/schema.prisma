  details         Json?
  createdAt       DateTime @default(now())

  Organization  Organization  @relation(fields: [organizationId], references: [id])
  ChangeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([changeRequestId])
  @@index([actorUserId])
}

// Phase 20 — CEO Command Center Models

model CeoCommandCenterSettings {
  id                                String   @id @default(cuid())
  organizationId                    String   @unique
  arOverdueWarningDays              Int      @default(30)
  approvalAgingThresholdHours       Int      @default(48)
  projectMarginWarningPercent       Decimal  @default(20.00) @db.Decimal(5, 2)
  projectOverdueWarningDays         Int      @default(7)
  resourceUtilizationWarningPercent Decimal  @default(90.00) @db.Decimal(5, 2)
  slaCriticalityThresholdHours      Int      @default(24)
  largeCrAmountThreshold            Decimal  @default(50000.00) @db.Decimal(12, 2)
  cashWarningThreshold              Decimal  @default(100000.00) @db.Decimal(12, 2)
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt

  Organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model CeoKpiSnapshot {
  id                   String   @id @default(cuid())
  organizationId       String
  snapshotDate         DateTime
  recognizedRevenue    Decimal  @db.Decimal(14, 2)
  invoicedAmount       Decimal  @db.Decimal(14, 2)
  collectedAmount      Decimal  @db.Decimal(14, 2)
  accountsReceivable   Decimal  @db.Decimal(14, 2)
  accountsPayable      Decimal  @db.Decimal(14, 2)
  cashBankBalance      Decimal  @db.Decimal(14, 2)
  activeProjectCount   Int
  atRiskProjectCount   Int
  criticalProjectCount Int
  pendingApprovalCount Int
  openSlaBreachCount   Int
  createdAt            DateTime @default(now())

  Organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, snapshotDate])
  @@index([organizationId])
  @@index([snapshotDate])
}

model CeoExecutiveAlert {
  id             String    @id @default(cuid())
  organizationId String
  sourceType     String
  sourceId       String
  idempotencyKey String    @unique
  severity       String
  reason         String
  details        Json?
  resolved       Boolean   @default(false)
  resolvedAt     DateTime?
  detectedAt     DateTime  @default(now())

  Organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([sourceType, sourceId])
  @@index([severity])
  @@index([resolved])
}

// Phase 21 — Client Portal Models

model PortalUser {
  id             String   @id @default(cuid())
  userId         String   @unique
  clientId       String
  organizationId String
  status         String   @default("active") // "active", "revoked", "expired"
  permissions    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  User         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  Client       Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  Organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Acceptances  ClientAcceptance[]

  @@index([userId])
  @@index([clientId])
  @@index([organizationId])
  @@index([status])
}

model PortalInvitation {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  email          String
  tokenHash      String   @unique
  expiresAt      DateTime
  status         String   @default("PENDING") // "PENDING", "ACCEPTED", "REVOKED"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  Client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  Organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clientId])
  @@index([email])
  @@index([status])
}

model PortalFileShare {
  id              String   @id @default(cuid())
  organizationId  String
  fileId          String
  clientId        String
  projectId       String?
  visibleToPortal Boolean  @default(true)
  sharedAt        DateTime @default(now())
  sharedById      String

  File         File         @relation(fields: [fileId], references: [id], onDelete: Cascade)
  Client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  Project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  Organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([fileId])
  @@index([clientId])
  @@index([projectId])
}

model ClientAcceptance {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  portalUserId   String
  artifactType   String // "QUOTATION", "CHANGE_REQUEST", "DELIVERABLE", "MILESTONE"
  artifactId     String
  status         String // "APPROVED", "REJECTED"
  feedback       String?
  createdAt      DateTime @default(now())
  ipAddress      String?

  Organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  PortalUser   PortalUser   @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clientId])
  @@index([portalUserId])
  @@index([artifactType, artifactId])
}

// Phase 22 — Integrations & Automation Models

model IntegrationConnection {
  id                   String    @id @default(cuid())
  organizationId       String
  name                 String
  provider             String
  category             String // "API", "WEBHOOK", "ECOMMERCE", "PAYMENT", "ACCOUNTING", "CRM", "HR", "MESSAGING", "STORAGE", "CUSTOM"
  status               String // "ACTIVE", "INACTIVE", "ERROR", "REVOKED"
  direction            String // "INBOUND", "OUTBOUND", "BIDIRECTIONAL"
  authenticationType   String // "API_KEY", "OAUTH2", "WEBHOOK_SECRET", "BASIC", "NONE"
  encryptedCredentials String?
  configuration        Json      @default("{}")
  lastConnectedAt      DateTime?
  lastSuccessfulAt     DateTime?
  lastFailureAt        DateTime?
  failureCount         Int       @default(0)
  createdBy            String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  Organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Events       IntegrationEvent[]

  @@index([organizationId])
  @@index([status])
}

model WebhookEndpoint {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  url              String
  secret           String
  status           String // "ACTIVE", "INACTIVE"
  subscribedEvents String[] @default([])
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  Organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Deliveries   WebhookDelivery[]

  @@index([organizationId])
  @@index([status])
}

model WebhookDelivery {
  id                  String    @id @default(cuid())
  organizationId      String
  endpointId          String
  eventId             String
  eventType           String
  payloadHash         String
  status              String // "PENDING", "SUCCEEDED", "FAILED"
  attemptCount        Int       @default(0)
  nextAttemptAt       DateTime?
  responseStatus      Int?
  responseBodySummary String?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())

  Organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Endpoint     WebhookEndpoint          @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  Attempts     WebhookDeliveryAttempt[]

  @@index([organizationId])
  @@index([endpointId])
  @@index([eventId])
  @@index([status])
}

model WebhookDeliveryAttempt {
  id              String   @id @default(cuid())
  organizationId  String
  deliveryId      String
  attempt         Int
  requestHeaders  Json?
  requestBody     String?
  responseHeaders Json?
  responseBody    String?
  responseStatus  Int?
  durationMs      Int?
  errorSummary    String?
  createdAt       DateTime @default(now())

  Organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Delivery     WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([deliveryId])
}

model IntegrationEvent {
  id              String    @id @default(cuid())
  organizationId  String
  connectionId    String
  externalEventId String
  eventType       String
  payloadHash     String
  payload         Json?
  receivedAt      DateTime  @default(now())
  verifiedAt      DateTime?
  processedAt     DateTime?
  status          String // "RECEIVED", "VERIFIED", "PROCESSED", "FAILED"
  attemptCount    Int       @default(0)
  errorCode       String?
  errorSummary    String?

  Organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, connectionId, externalEventId])
  @@index([organizationId])
  @@index([connectionId])
  @@index([status])
}

model AutomationRule {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  status         String // "DRAFT", "ACTIVE", "PAUSED", "DISABLED"
  triggerType    String // "DOMAIN_EVENT", "SCHEDULE", "RECORD_STATE", "MANUAL"
  triggerConfig  Json     @default("{}")
  conditions     Json     @default("[]")
  actionType     String // "NOTIFICATION", "EMAIL", "WEBHOOK", "TASK", "TICKET", "APPROVAL", "CRM_UPDATE", "INTEGRATION"
  actionConfig   Json     @default("{}")
  version        Int      @default(1)
  createdBy      String
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  Organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Executions   AutomationExecution[]

  @@index([organizationId])
  @@index([status])
}

model AutomationExecution {
  id               String    @id @default(cuid())
  organizationId   String
  automationRuleId String
  ruleVersion      Int
  triggerEventId   String?
  idempotencyKey   String    @unique
  status           String // "RUNNING", "SUCCEEDED", "FAILED"
  attempt          Int       @default(1)
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  errorCode        String?
  errorSummary     String?
  outputSummary    String?

  Organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Rule         AutomationRule @relation(fields: [automationRuleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([automationRuleId])
  @@index([status])
}

model DomainOutboxEvent {
  id             String    @id @default(cuid())
  organizationId String
  aggregateType  String
  aggregateId    String
  eventType      String
  payload        Json
  createdAt      DateTime  @default(now())
  publishedAt    DateTime?
  attemptCount   Int       @default(0)
  nextAttemptAt  DateTime?

  Organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([publishedAt])
  @@index([nextAttemptAt])
}

model QueueJob {
  id             String    @id @default(cuid())
  organizationId String
  type           String // "WEBHOOK_DELIVERY", "AUTOMATION_EXECUTION", "OUTBOX_PUBLISH", "SCHEDULED_AUTOMATION"
  referenceId    String? // reference ID of WebhookDelivery, AutomationExecution, DomainOutboxEvent, or AutomationRule
  payload        Json
  status         String // "PENDING", "CLAIMED", "RUNNING", "SUCCEEDED", "FAILED", "DEAD_LETTER"
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  availableAt    DateTime  @default(now())
  claimedAt      DateTime?
  claimedBy      String?
  leaseUntil     DateTime?
  errorCode      String?
  errorSummary   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  Organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([availableAt])
  @@index([claimedBy])
}

model BusinessSequence {
  id             String   @id
  organizationId String   @default("default-org")
  key            String
  year           Int
  currentValue   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  Organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key, year])
  @@index([organizationId, key])
}

model FixedAssetItem {
  id                      String         @id @default(cuid())
  assetTag                String         @unique
  name                    String
  serialNumber            String?
  chartOfAccountId        String
  purchaseDate            DateTime       @default(now())
  purchaseCost            Decimal        @db.Decimal(12, 2)
  salvageValue            Decimal        @default(0) @db.Decimal(12, 2)
  usefulLifeYears         Int            @default(5)
  accumulatedDepreciation Decimal        @default(0) @db.Decimal(12, 2)
  status                  String         @default("in_use")
  location                String?
  assignedToEmployeeId    String?
  notes                   String?
  organizationId          String?
  createdBy               String
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  ChartOfAccount          ChartOfAccount @relation(fields: [chartOfAccountId], references: [id])
  Organization            Organization?  @relation(fields: [organizationId], references: [id])
  Employee                Employee?      @relation(fields: [assignedToEmployeeId], references: [id])
  User                    User           @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([assetTag])
  @@index([chartOfAccountId])
  @@index([status])
  @@index([organizationId])
  @@index([assignedToEmployeeId])
}
