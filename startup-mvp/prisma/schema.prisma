model Attendance {
  id                 String            @id @default(cuid())
  employeeId         String
  date               DateTime          @db.Date
  shiftId            String?
  checkIn            DateTime?
  checkOut           DateTime?
  workHours          Decimal           @default(0) @db.Decimal(5, 2)
  otHours            Decimal           @default(0) @db.Decimal(5, 2)
  tiffinBill         Decimal           @default(0) @db.Decimal(12, 2)
  nightBill          Decimal           @default(0) @db.Decimal(12, 2)
  holidayBill        Decimal           @default(0) @db.Decimal(12, 2)
