  createdBy                          String
  postedById                         String?
  postedAt                           DateTime?
  createdAt                          DateTime       @default(now())
  updatedAt                          DateTime       @updatedAt
  clientId                           String?
  supplierId                         String?
  userId                             String?
  organizationId                     String
  invoiceId                          String?
  orderId                            String?
  Invoice_Invoice_voucherIdToVoucher Invoice?       @relation("Invoice_voucherIdToVoucher")
  JournalEntry                       JournalEntry[]
  Client                             Client?        @relation(fields: [clientId], references: [id])
  User_Voucher_createdByToUser       User           @relation("Voucher_createdByToUser", fields: [createdBy], references: [id], onDelete: Cascade)
  Invoice_Voucher_invoiceIdToInvoice Invoice?       @relation("Voucher_invoiceIdToInvoice", fields: [invoiceId], references: [id])
  Order                              Order?         @relation(fields: [orderId], references: [id])
  Organization                       Organization?  @relation(fields: [organizationId], references: [id])
  User_Voucher_postedByIdToUser      User?          @relation("Voucher_postedByIdToUser", fields: [postedById], references: [id])
  Supplier                           Supplier?      @relation(fields: [supplierId], references: [id])
  User_Voucher_userIdToUser          User?          @relation("Voucher_userIdToUser", fields: [userId], references: [id])
