enum ApprovalRequestStatus {
  DRAFT
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
  STALE
}

enum ApprovalSourceType {
  CREATIVE_COMPLETION
  MARKETING_COMPLETION
  DEVELOPMENT_COMPLETION
  QA_COMPLETION
  UAT_READINESS
  CHANGE_REQUEST
}

enum ApprovalMode {
  ANY
  ALL
  MINIMUM_COUNT
}

enum ApprovalStepStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  BYPASSED
  STALE
}

enum ApprovalDecisionType {
  APPROVED
  REJECTED
}

model ApprovalPolicy {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  code           String
  sourceType     ApprovalSourceType
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  Organization Organization         @relation(fields: [organizationId], references: [id])
  Steps        ApprovalPolicyStep[]
  Requests     ApprovalRequest[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([sourceType])
}

model ApprovalPolicyStep {
  id               String       @id @default(cuid())
  organizationId   String
  policyId         String
  sequence         Int
  name             String
  approvalMode     ApprovalMode @default(ANY)
  minimumApprovals Int          @default(1)
  required         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  Organization Organization   @relation(fields: [organizationId], references: [id])
  Policy       ApprovalPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, sequence])
  @@index([organizationId])
  @@index([policyId])
}

model ApprovalRequest {
  id                  String                @id @default(cuid())
  organizationId      String
  requestNumber       String
  policyId            String
  sourceType          ApprovalSourceType
  sourceId            String
  sourceVersion       String?
  sourceFingerprint   String?
  title               String
  description         String?
  status              ApprovalRequestStatus @default(DRAFT)
  currentStepSequence Int                   @default(1)
  requestedById       String
  requestedAt         DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  staleAt             DateTime?
  staleReason         String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  Organization   Organization           @relation(fields: [organizationId], references: [id])
  Policy         ApprovalPolicy         @relation(fields: [policyId], references: [id])
  RequestedBy    User                   @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  StepInstances  ApprovalStepInstance[]
  Decisions      ApprovalDecision[]
  ChangeRequests ChangeRequest[]

  @@index([organizationId])
  @@index([sourceType, sourceId])
  @@index([status])
}

model ApprovalStepInstance {
  id                String             @id @default(cuid())
  organizationId    String
  approvalRequestId String
  sequence          Int
  nameSnapshot      String
  approvalMode      ApprovalMode       @default(ANY)
  minimumApprovals  Int                @default(1)
  status            ApprovalStepStatus @default(PENDING)
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  Organization    Organization           @relation(fields: [organizationId], references: [id])
  ApprovalRequest ApprovalRequest        @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  Approvers       ApprovalStepApprover[]
  Decisions       ApprovalDecision[]

  @@unique([approvalRequestId, sequence])
  @@index([organizationId])
  @@index([approvalRequestId])
}

model ApprovalStepApprover {
  id             String   @id @default(cuid())
  organizationId String
  stepInstanceId String
  approverUserId String
  approverRole   String?
  createdAt      DateTime @default(now())

  Organization Organization         @relation(fields: [organizationId], references: [id])
