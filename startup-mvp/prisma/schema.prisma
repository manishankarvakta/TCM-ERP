generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum VoucherType {
  PAYMENT
  RECEIPT
  JOURNAL
  CONTRA
  SALES
  PURCHASE
}

enum CashBankAccountType {
  CASH
  BANK
}

enum PurchaseStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ItemType {
  RAW_MATERIAL
  FINISHED_GOOD
  RETAIL
}

model User {
  id                               String              @id @default(cuid())
  name                             String?
  email                            String              @unique
  emailVerified                    DateTime?
  password                         String
  image                            String?
  role                             String              @default("user")
  status                           String              @default("active")
  createdAt                        DateTime            @default(now())
  updatedAt                        DateTime            @updatedAt
  designationTemplateId            String?
  permissions                      Json?
  inchargeId                       String?
  accounts                         Account[]
  CashBankAccount                  CashBankAccount[]
  ChartOfAccount                   ChartOfAccount[]
  createdClients                   Client[]            @relation("ClientCreator")
  Employee                         Employee?           @relation("UserEmployee")
  files                            File[]
  JournalEntryLine                 JournalEntryLine[]
  createdNotifications             Notification[]      @relation("NotificationCreator")
  notifications                    Notification[]
  createdOrganizations             Organization[]      @relation("OrganizationCreator")
  sessions                         Session[]
  createdSuppliers                 Supplier[]          @relation("SupplierCreator")
  createdUnits                     Unit[]              @relation("UnitCreator")
  designationTemplate              PermissionTemplate? @relation("UserDesignationTemplate", fields: [designationTemplateId], references: [id])
  incharge                         User?               @relation("UserIncharge", fields: [inchargeId], references: [id])
  inchargeOf                       User[]              @relation("UserIncharge")
  userLogs                         UserLog[]
  userPermissions                  UserPermission[]
  Voucher_Voucher_createdByToUser  Voucher[]           @relation("Voucher_createdByToUser")
  Voucher_Voucher_postedByIdToUser  Voucher[]           @relation("Voucher_postedByIdToUser")
  Voucher_Voucher_userIdToUser     Voucher[]           @relation("Voucher_userIdToUser")
  VoucherLine                      VoucherLine[]
  createdSettings                  Settings[]          @relation("SettingsCreator")
  settings                         Settings[]          @relation("SettingsUser")
  createdPurchases                 Purchase[]          @relation("PurchaseCreatedBy")
  updatedPurchases                 Purchase[]          @relation("PurchaseUpdatedBy")
  createdItems                     Item[]              @relation("ItemCreator")

  @@index([status])
  @@index([designationTemplateId])
  @@index([inchargeId])
}

model Employee {
  id           String   @id @default(cuid())
  name         String
  employeeCode String?  @unique
  email        String?
  phone        String?
  userId       String?  @unique
  user         User?    @relation("UserEmployee", fields: [userId], references: [id], onDelete: SetNull)
  status       String   @default("active") // active, inactive
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Payroll accounting relations
  salaryPayableAccountId String?
  salaryPayableAccount   ChartOfAccount? @relation("Employee_salaryPayableAccountIdToChartOfAccount", fields: [salaryPayableAccountId], references: [id], onDelete: SetNull)
  advanceAccountId       String?
  advanceAccount         ChartOfAccount? @relation("Employee_advanceAccountIdToChartOfAccount", fields: [advanceAccountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([employeeCode])
  @@index([email])
  @@index([salaryPayableAccountId])
  @@index([advanceAccountId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  code      String
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([code])
  @@index([expires])
}

model UserLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model File {
  id         String   @id @default(cuid())
  ownerId    String
  name       String
  path       String
  storageKey String   @unique
  size       Int
  mimeType   String
  isFolder   Boolean  @default(false)
  etag       String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([storageKey])
  @@index([path])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType
  userId    String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  readAt    DateTime?
  createdBy String?
  creator   User?            @relation("NotificationCreator", fields: [createdBy], references: [id])
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
  @@index([createdBy])
}

model Unit {
  id        String   @id @default(cuid())
  details   String
  symbol    String   @unique
  status    String   @default("active")
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator   User     @relation("UnitCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  items     Item[]

  @@index([status])
  @@index([createdBy])
}

model Organization {
  id               String             @id @default(cuid())
  name             String
  details          String?
  address          String?
  phone            String?
  email            String?
  website          String?
  logo             String?
  status           String             @default("active")
  createdBy        String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  JournalEntryLine JournalEntryLine[]
  creator          User               @relation("OrganizationCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  Voucher          Voucher[]
  VoucherLine      VoucherLine[]

  @@index([status])
  @@index([createdBy])
  @@index([name])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       Item[]

  @@index([name])
  @@index([status])
}

model Item {
  id                String    @id @default(cuid())
  code              String    @unique // Auto-generated: RM-2026-0001, FG-2026-0001, RT-2026-0001
  name              String
  description       String?
  itemType          ItemType
  categoryId        String?
  unitId            String
  costPrice         Decimal   @db.Decimal(12, 2) // Purchase/cost price
  salesPrice        Decimal?  @db.Decimal(12, 2) // Selling price (required for FINISHED_GOOD)
  trackInventory    Boolean   @default(false) // Inventory tracking flag
  image             String?   // Image URL/path
  status            String    @default("active") // active, inactive, trash
  isTrash           Boolean   @default(false)
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit              Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  creator           User      @relation("ItemCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([name])
  @@index([itemType])
  @@index([categoryId])
  @@index([unitId])
  @@index([status])
  @@index([isTrash])
  @@index([createdBy])
}

model Client {
  id               String             @id @default(cuid())
  name             String?
  email            String             @unique
  phone            String?
  address          String?
  city             String?
  state            String?
  zip              String?
  country          String?
  company          String?
  image            String?
  createdBy        String
  status           String             @default("active")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  chartOfAccountId String?
  clientCode       String?            @unique
  ChartOfAccount   ChartOfAccount?    @relation(fields: [chartOfAccountId], references: [id])
  createdByUser    User               @relation("ClientCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  JournalEntryLine JournalEntryLine[]
  Voucher          Voucher[]
  VoucherLine      VoucherLine[]

  @@index([status])
  @@index([createdBy])
  @@index([email])
  @@index([chartOfAccountId])
  @@index([clientCode])
}

model Supplier {
  id               String             @id @default(cuid())
  name             String?
  email            String             @unique
  phone            String?
  address          String?
  city             String?
  state            String?
  zip              String?
  country          String?
  company          String?
  image            String?
  createdBy        String
  status           String             @default("active")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  chartOfAccountId String?
  supplierCode     String?            @unique
  JournalEntryLine JournalEntryLine[]
  ChartOfAccount   ChartOfAccount?    @relation(fields: [chartOfAccountId], references: [id])
  createdByUser    User               @relation("SupplierCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  Voucher          Voucher[]
  VoucherLine      VoucherLine[]
  Purchase         Purchase[]

  @@index([status])
  @@index([createdBy])
  @@index([email])
  @@index([chartOfAccountId])
  @@index([supplierCode])
}

model Purchase {
  id             String         @id @default(cuid())
  purchaseNumber String         @unique
  supplierId     String
  date           DateTime       @default(now())
  status         PurchaseStatus @default(DRAFT)
  notes          String?
  attachmentUrl  String?
  subTotal       Decimal        @db.Decimal(12, 2)
  discount       Decimal?       @db.Decimal(5, 2)
  tax            Decimal?       @db.Decimal(5, 2)
  grandTotal     Decimal        @db.Decimal(12, 2)
  isTrash        Boolean        @default(false)
  createdBy      String
  updatedBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  createdByUser  User           @relation("PurchaseCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  updatedByUser  User?          @relation("PurchaseUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  items          PurchaseItem[]

  @@index([supplierId])
  @@index([status])
  @@index([date])
  @@index([isTrash])
  @@index([purchaseNumber])
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  itemId      String?
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}

model Settings {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  title        String   @db.VarChar(255)
  code         String   @db.VarChar(100)
  category     String   @db.VarChar(100)
  settings     Json
  isActive     Boolean  @default(true) @map("is_active")
  isDefault    Boolean  @default(false) @map("is_default")
  isGlobal     Boolean  @default(false) @map("is_global")
  displayOrder Int      @default(0) @map("display_order")
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  creator      User?    @relation("SettingsCreator", fields: [createdBy], references: [id])
  user         User?    @relation("SettingsUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
  @@index([category])
  @@index([userId, code])
  @@index([userId, category])
  @@index([isGlobal])
  @@index([settings(ops: JsonbPathOps)], type: Gin)
  @@map("settings")
}

model PermissionTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]   @relation("UserDesignationTemplate")

  @@index([isActive])
  @@index([name])
}

model UserPermission {
  id         String   @id @default(cuid())
  userId     String
  module     String
  operations Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@index([userId])
  @@index([module])
}

model ModuleOperation {
  id          String   @id @default(cuid())
  module      String
  operation   String
  label       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([module, operation])
  @@index([module])
  @@index([isActive])
}

model CashBankAccount {
  id               String              @id
  chartOfAccountId String              @unique
  type             CashBankAccountType
  status           String              @default("active")
  createdBy        String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime
  ChartOfAccount   ChartOfAccount      @relation(fields: [chartOfAccountId], references: [id], onDelete: Cascade)
  User             User                @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([chartOfAccountId])
  @@index([createdBy])
  @@index([status])
  @@index([type])
}

model ChartOfAccount {
  id                                                       String             @id
  code                                                     String             @unique
  name                                                     String
  type                                                     AccountType
  parentId                                                 String?
  description                                              String?
  status                                                   String             @default("active")
  createdBy                                                String
  createdAt                                                DateTime           @default(now())
  updatedAt                                                DateTime
  CashBankAccount                                          CashBankAccount?
  User                                                     User               @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  ChartOfAccount                                           ChartOfAccount?    @relation("ChartOfAccountToChartOfAccount", fields: [parentId], references: [id])
  other_ChartOfAccount                                     ChartOfAccount[]   @relation("ChartOfAccountToChartOfAccount")
  Client                                                   Client[]
  Employee_Employee_advanceAccountIdToChartOfAccount       Employee[]         @relation("Employee_advanceAccountIdToChartOfAccount")
  Employee_Employee_salaryPayableAccountIdToChartOfAccount Employee[]         @relation("Employee_salaryPayableAccountIdToChartOfAccount")
  JournalEntryLine                                         JournalEntryLine[]
  Supplier                                                 Supplier[]
  VoucherLine                                              VoucherLine[]

  @@index([code])
  @@index([createdBy])
  @@index([parentId])
  @@index([status])
  @@index([type])
}

model JournalEntry {
  id               String             @id
  entryNumber      String             @unique
  date             DateTime           @default(now())
  voucherId        String
  description      String?
  status           String             @default("posted")
  createdBy        String
  postedBy         String
  postedAt         DateTime
  createdAt        DateTime           @default(now())
  Voucher          Voucher            @relation(fields: [voucherId], references: [id])
  JournalEntryLine JournalEntryLine[]

  @@index([date])
  @@index([entryNumber])
  @@index([status])
  @@index([voucherId])
}

model JournalEntryLine {
  id               String         @id
  lineNumber       Int
  debitAmount      Decimal        @default(0) @db.Decimal(12, 2)
  creditAmount     Decimal        @default(0) @db.Decimal(12, 2)
  description      String?
  journalEntryId   String
  chartOfAccountId String
  createdAt        DateTime       @default(now())
  clientId         String?
  supplierId       String?
  userId           String?
  organizationId   String?
  ChartOfAccount   ChartOfAccount @relation(fields: [chartOfAccountId], references: [id])
  Client           Client?        @relation(fields: [clientId], references: [id])
  JournalEntry     JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  Organization     Organization?  @relation(fields: [organizationId], references: [id])
  Supplier         Supplier?      @relation(fields: [supplierId], references: [id])
  User             User?          @relation(fields: [userId], references: [id])

  @@index([chartOfAccountId])
  @@index([clientId])
  @@index([journalEntryId])
  @@index([organizationId])
  @@index([supplierId])
  @@index([userId])
}

model Voucher {
  id                            String         @id
  voucherNumber                 String         @unique
  date                          DateTime       @default(now())
  type                          VoucherType
  reference                     String?
  description                   String?
  status                        String         @default("draft")
  createdBy                     String
  postedById                    String?
  postedAt                      DateTime?
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime
  clientId                      String?
  supplierId                    String?
  userId                        String?
  organizationId                String?
  JournalEntry                  JournalEntry[]
  Client                        Client?        @relation(fields: [clientId], references: [id])
  User_Voucher_createdByToUser  User           @relation("Voucher_createdByToUser", fields: [createdBy], references: [id], onDelete: Cascade)
  Organization                  Organization?  @relation(fields: [organizationId], references: [id])
  User_Voucher_postedByIdToUser User?          @relation("Voucher_postedByIdToUser", fields: [postedById], references: [id])
  Supplier                      Supplier?      @relation(fields: [supplierId], references: [id])
  User_Voucher_userIdToUser     User?          @relation("Voucher_userIdToUser", fields: [userId], references: [id])
  VoucherLine                   VoucherLine[]

  @@index([clientId])
  @@index([createdBy])
  @@index([date])
  @@index([organizationId])
  @@index([postedById])
  @@index([status])
  @@index([supplierId])
  @@index([type])
  @@index([userId])
  @@index([voucherNumber])
}

model VoucherLine {
  id               String         @id
  lineNumber       Int
  debitAmount      Decimal        @default(0) @db.Decimal(12, 2)
  creditAmount     Decimal        @default(0) @db.Decimal(12, 2)
  description      String?
  voucherId        String
  chartOfAccountId String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime
  clientId         String?
  supplierId       String?
  userId           String?
  organizationId   String?
  ChartOfAccount   ChartOfAccount @relation(fields: [chartOfAccountId], references: [id])
  Client           Client?        @relation(fields: [clientId], references: [id])
  Organization     Organization?  @relation(fields: [organizationId], references: [id])
  Supplier         Supplier?      @relation(fields: [supplierId], references: [id])
  User             User?          @relation(fields: [userId], references: [id])
  Voucher          Voucher        @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([chartOfAccountId])
  @@index([clientId])
  @@index([organizationId])
  @@index([supplierId])
  @@index([userId])
  @@index([voucherId])
}

enum NotificationType {
  SYSTEM
  ADMIN
  INFO
  WARNING
  ERROR
  SUCCESS
}
