  @@index([entityType, entityId])
  @@index([userId])
  @@index([contactId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([projectId])
  @@index([milestoneId])
  @@index([issueId])
  // Timeline optimization index
  @@index([entityType, entityId, createdAt(sort: Desc)], map: "idx_note_entity_created")
