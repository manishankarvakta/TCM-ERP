  baselineSourceType     String?   @default("PROJECT_BUDGET")
  baselineSourceId       String?
  baselineVersion        Int       @default(1)
  baselineContractAmount Decimal?  @db.Decimal(12, 2)
  baselinePlannedEndDate DateTime?
  isStale                Boolean   @default(false)
  staleAt                DateTime?
