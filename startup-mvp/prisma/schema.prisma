// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================
// ENUMS
// ============================================

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  REVISED
}



model User {
  id                   String         @id @default(cuid())
  name                 String?
  email                String         @unique
  emailVerified        DateTime?
  password             String
  image                String?
  role                 String         @default("user")
  status               String         @default("active") // active, inactive, trash
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  accounts             Account[]
  sessions             Session[]
  userLogs             UserLog[]
  files                File[]
  notifications        Notification[]
  createdNotifications Notification[] @relation("NotificationCreator")
  createdUnits         Unit[]         @relation("UnitCreator")
  createdOrganizations Organization[] @relation("OrganizationCreator")
  createdClients       Client[]       @relation("ClientCreator")
  createdSuppliers     Supplier[]     @relation("SupplierCreator")
  quotations           Quotation[]    @relation("SubmittedBy")
  updatedQuotations    Quotation[]    @relation("UpdatedBy")
  sections             Section[]      @relation("PreparedBy")
  createdCoverLetters  CoverLetter[]  @relation("CoverLetterCreator")
  settings             Settings[]     @relation("SettingsUser")
  createdSettings      Settings[]     @relation("SettingsCreator")

  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  code      String
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([code])
  @@index([expires])
}

model UserLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?  @db.Text
  ipAddress String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model File {
  id         String   @id @default(cuid())
  ownerId    String
  name       String
  path       String
  storageKey String   @unique
  size       Int
  mimeType   String
  isFolder   Boolean  @default(false)
  etag       String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([storageKey])
  @@index([path])
  @@index([createdAt])
}

enum NotificationType {
  SYSTEM
  ADMIN
  INFO
  WARNING
  ERROR
  SUCCESS
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType
  userId    String? // null = broadcast to all users
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  readAt    DateTime?
  createdBy String? // User ID who created the notification (null = system)
  creator   User?            @relation("NotificationCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
  @@index([createdBy])
}

model Unit {
  id        String   @id @default(cuid())
  details   String
  symbol    String   @unique
  status    String   @default("active") // active, inactive, trash
  createdBy String
  creator   User     @relation("UnitCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     Item[]   @relation("unit")

  @@index([status])
  @@index([createdBy])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  details   String?
  address   String?
  phone     String?
  email     String?
  website   String?
  logo      String?
  status    String   @default("active") // active, inactive, trash
  createdBy String
  creator   User     @relation("OrganizationCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  quotations Quotation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdBy])
  @@index([name])
}

model Category {
  id          String         @id @default(cuid())
  name        String
  description String?
  status      String         @default("active") // active, inactive, trash
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       ItemCategory[]

  @@index([name])
  @@index([status])
}

model Item {
  id          String         @id @default(cuid())
  code        String         @unique
  description String
  unitId      String
  unit        Unit           @relation("unit", fields: [unitId], references: [id], onDelete: Restrict)
  unitPrice   Decimal        @db.Decimal(10, 2)
  image       String?
  status      String         @default("active") // active, inactive, trash
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  categories  ItemCategory[]
  quotationItems QuotationItem[]

  @@index([code])
  @@index([unitId])
  @@index([status])
}

model ItemCategory {
  id         String   @id @default(cuid())
  itemId     String
  categoryId String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([itemId, categoryId])
  @@index([itemId])
  @@index([categoryId])
}

model Client {
  id            String      @id @default(cuid())
  name          String?
  email         String      @unique
  phone         String?
  address       String?
  city          String?
  state         String?
  zip           String?
  country       String?
  company       String?
  image         String?
  createdBy     String
  createdByUser User        @relation("ClientCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  status        String      @default("active") // active, inactive, trash
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  Quotation     Quotation[]

  @@index([status])
  @@index([createdBy])
  @@index([email])
}

model Supplier {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  phone         String?
  address       String?
  city          String?
  state         String?
  zip           String?
  country       String?
  company       String?
  image         String?
  createdBy     String
  createdByUser User     @relation("SupplierCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  status        String   @default("active") // active, inactive, trash
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdBy])
  @@index([email])
}

// ============================================
// QUOTATIONS
// ============================================

// Main Quotation model
model Quotation {
  id                 String          @id @default(cuid())
  quotationNumber    String          @unique // Auto-generated quotation number
  subject            String
  date               DateTime        @default(now())
  coverLetter        String?         @db.Text
  financialStatement String?         @db.Text
  tos                String?         @db.Text // Terms of Service
  total              Decimal?        @db.Decimal(12, 2)
  discount           Decimal?        @db.Decimal(5, 2) // Percentage discount
  grandTotal         Decimal?        @db.Decimal(12, 2)
  status             QuotationStatus @default(DRAFT) // DRAFT, SENT, ACCEPTED, REJECTED, EXPIRED, REVISED

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  submittedById String
  submittedBy   User   @relation("SubmittedBy", fields: [submittedById], references: [id])

  updatedById String?
  updatedBy   User?   @relation("UpdatedBy", fields: [updatedById], references: [id])

  // Additional fields
  shippingCharges Decimal? @db.Decimal(10, 2)
  vatIncluded     Boolean? @default(false)
  projectLocation String?
  isTrash         Boolean  @default(false) // Trash management - true if in trash

  section Section[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([organizationId])
  @@index([submittedById])
  @@index([updatedById])
  @@index([status])
  @@index([isTrash])
}

// Section within a quotation (e.g., different sections/phases)
model Section {
  id        String   @id @default(cuid())
  title     String
  note      String?  @db.Text
  discount  Decimal? @db.Decimal(5, 2) // Percentage discount
  total     Decimal? @db.Decimal(12, 2)
  grandTotal Decimal? @db.Decimal(12, 2)
  sortOrder Int      @default(0)

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  preparedById String?
  preparedBy   User?   @relation("PreparedBy", fields: [preparedById], references: [id])

  groups ItemGroup[]
  items  QuotationItem[] // Direct items not in groups

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quotationId])
}

// Item Group (optional grouping within a module)
model ItemGroup {
  id          String   @id @default(cuid())
  code        String?
  description String
  quantity    Decimal? @db.Decimal(10, 2) // Group-level quantity if applicable
  number      Int?     // Additional number field
  sortOrder   Int      @default(0)

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  items QuotationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
}

// Quotation Item (links Item catalog to quotation with specific details)
model QuotationItem {
  id          String  @id @default(cuid())
  sl          Int // Serial number/line number
  code        String? // Can override or use catalog code
  description String? // Can override catalog description

  // Dimensions
  height Decimal? @db.Decimal(10, 2)
  width  Decimal? @db.Decimal(10, 2)
  depth  Decimal? @db.Decimal(10, 2)

  unit        String? // Unit of measurement
  unitPrice   Decimal  @db.Decimal(10, 2)
  quantity    Decimal  @db.Decimal(10, 2)
  unitShutter Decimal? @db.Decimal(10, 2) // Shutters per unit
  totalShutter Decimal? @db.Decimal(10, 2) // Total shutters (calculated)
  amount      Decimal  @db.Decimal(12, 2) // Total amount for this item

  note      String? @db.Text
  sortOrder Int     @default(0)

  itemId String? // Optional: reference to catalog item
  item   Item?   @relation(fields: [itemId], references: [id])

  // Item can be directly in section or in a group
  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  groupId String?
  group   ItemGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId])
  @@index([sectionId])
  @@index([groupId])
}

// ============================================
// COVER LETTERS
// ============================================

model CoverLetter {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  status    String   @default("active") // active, inactive, trash
  createdBy String
  creator   User     @relation("CoverLetterCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdBy])
  @@index([title])
}


//SETTING DATA FOR MODULES
model Settings {
  id          String   @id @default(cuid())
  userId      String?  @map("user_id")  // NULL = global/system settings
  
  title       String   @db.VarChar(255)
  code        String   @db.VarChar(100)
  category    String   @db.VarChar(100)
  
  settings    Json     @db.JsonB
  
  isActive    Boolean  @default(true) @map("is_active")
  isDefault   Boolean  @default(false) @map("is_default")
  isGlobal    Boolean  @default(false) @map("is_global")  // TRUE = system-wide, FALSE = user-specific
  
  displayOrder Int     @default(0) @map("display_order")
  
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  
  // Relations
  user        User?    @relation("SettingsUser", fields: [userId], references: [id], onDelete: Cascade)
  creator     User?    @relation("SettingsCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  
  // Indexes
  @@index([userId])
  @@index([code])
  @@index([category])
  @@index([userId, code])
  @@index([userId, category])
  @@index([isGlobal])
  @@index([settings(ops: JsonbPathOps)], type: Gin)
  
  @@map("settings")
}

