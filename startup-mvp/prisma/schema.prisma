generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum VoucherType {
  PAYMENT
  RECEIPT
  JOURNAL
  CONTRA
  SALES
  PURCHASE
}

enum CashBankAccountType {
  CASH
  BANK
}

enum PurchaseStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ProductionOrderStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum ItemType {
  RAW_MATERIAL
  READY_PRODUCT
  RETAIL
}

enum StockTransactionType {
  IN // Stock received (Purchase, Production output)
  OUT // Stock issued (Production input, Sales)
  ADJUSTMENT // Manual adjustment (increase or decrease)
  PRODUCTION // Production-related movement
}

enum EmploymentType {
  PERMANENT
  TEMPORARY
  CONTRACT
  INTERN
  DAILY_WORKER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  LATE
  HALF_DAY
  HOLIDAY
  WEEKEND
}

enum LeaveCategory {
  CASUAL
  SICK
  ANNUAL
  MATERNITY
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  MANAGER_APPROVED
  HR_APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  REVIEWED
  APPROVED
  POSTED
  PAID
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  CLOSED
}

enum AttendanceSource {
  MANUAL
  WEB
  MOBILE
  BIOMETRIC
  API
}

model User {
  id                               String                @id @default(cuid())
  name                             String?
  email                            String                @unique
  emailVerified                    DateTime?
  password                         String
  image                            String?
  role                             String                @default("user")
  status                           String                @default("active")
  isActive                         String                @default("")
  createdAt                        DateTime              @default(now())
  updatedAt                        DateTime              @updatedAt
  designationTemplateId            String?
  permissions                      Json?
  inchargeId                       String?
  accounts                         Account[]
  CashBankAccount                  CashBankAccount[]
  ChartOfAccount                   ChartOfAccount[]
  createdClients                   Client[]              @relation("ClientCreator")
  Employee                         Employee?             @relation("UserEmployee")
  files                            File[]
  JournalEntryLine                 JournalEntryLine[]
  createdNotifications             Notification[]        @relation("NotificationCreator")
  notifications                    Notification[]
  createdOrganizations             Organization[]        @relation("OrganizationCreator")
  sessions                         Session[]
  createdSuppliers                 Supplier[]            @relation("SupplierCreator")
  createdUnits                     Unit[]                @relation("UnitCreator")
  designationTemplate              PermissionTemplate?   @relation("UserDesignationTemplate", fields: [designationTemplateId], references: [id])
  incharge                         User?                 @relation("UserIncharge", fields: [inchargeId], references: [id])
  inchargeOf                       User[]                @relation("UserIncharge")
  userLogs                         UserLog[]
  userPermissions                  UserPermission[]
  Voucher_Voucher_createdByToUser  Voucher[]             @relation("Voucher_createdByToUser")
  Voucher_Voucher_postedByIdToUser Voucher[]             @relation("Voucher_postedByIdToUser")
  Voucher_Voucher_userIdToUser     Voucher[]             @relation("Voucher_userIdToUser")
  VoucherLine                      VoucherLine[]
  createdSettings                  Settings[]            @relation("SettingsCreator")
  settings                         Settings[]            @relation("SettingsUser")
  createdPurchases                 Purchase[]            @relation("PurchaseCreatedBy")
  updatedPurchases                 Purchase[]            @relation("PurchaseUpdatedBy")
  createdItems                     Item[]                @relation("ItemCreator")
  createdWarehouses                Warehouse[]           @relation("WarehouseCreator")
  createdStockLedgers              StockLedger[]         @relation("StockLedgerCreator")
  createdBOMs                      BOM[]                 @relation("BOMCreator")
  createdProductionOrders          ProductionOrder[]     @relation("ProductionOrderCreator")
  createdSales                     Sale[]                @relation("SaleCreatedBy")
  updatedSales                     Sale[]                @relation("SaleUpdatedBy")
  InventoryAdjustmentCreated       InventoryAdjustment[] @relation("InventoryAdjustment_createdBy")
  InventoryAdjustmentUpdated       InventoryAdjustment[] @relation("InventoryAdjustment_updatedBy")
  defaultWarehouseId               String?
  defaultWarehouse                 Warehouse?            @relation("UserDefaultWarehouse", fields: [defaultWarehouseId], references: [id])

  // HR Module Inverse Relations
  createdShifts      Shift[]            @relation("ShiftCreator")
  createdHolidays    Holiday[]          @relation("HolidayCreator")
  createdLeaveTypes  LeaveType[]        @relation("LeaveTypeCreator")
  managedLeaves      LeaveApplication[] @relation("LeaveManager")
  hrLeaves           LeaveApplication[] @relation("LeaveHR")
  createdLeaveApps   LeaveApplication[] @relation("LeaveAppCreator")
  createdAttendances Attendance[]       @relation("AttendanceCreator")
  updatedAttendances Attendance[]       @relation("AttendanceUpdater")
  createdOvertimes   Overtime[]         @relation("OvertimeCreator")
  approvedLoans      EmployeeLoan[]     @relation("LoanApprover")
  createdPayrolls    Payroll[]          @relation("PayrollCreator")
  approvedPayrolls   Payroll[]          @relation("PayrollApprover")
  biometricSyncLogs  BiometricSyncLog[]

  @@index([status])
  @@index([designationTemplateId])
  @@index([inchargeId])
}

model Employee {
  id           String   @id @default(cuid())
  name         String
  employeeCode String?  @unique
  email        String?
  phone        String?
  userId       String?  @unique
  user         User?    @relation("UserEmployee", fields: [userId], references: [id], onDelete: SetNull)
  status       String   @default("active") // active, inactive
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Personal Information
  designation      String?
  department       String?
  salary           Decimal?  @db.Decimal(12, 2)
  joiningDate      DateTime?
  gender           String?
  dateOfBirth      DateTime?
  nationalId       String?
  address          Json?
  emergencyContact Json?
  photo            String?

  // Warehouse relation
  warehouseId String?
  warehouse   Warehouse? @relation("WarehouseEmployees", fields: [warehouseId], references: [id], onDelete: SetNull)

  // Payroll accounting relations
  salaryPayableAccountId String?
  salaryPayableAccount   ChartOfAccount? @relation("Employee_salaryPayableAccountIdToChartOfAccount", fields: [salaryPayableAccountId], references: [id], onDelete: SetNull)
  advanceAccountId       String?
  advanceAccount         ChartOfAccount? @relation("Employee_advanceAccountIdToChartOfAccount", fields: [advanceAccountId], references: [id], onDelete: SetNull)

  // New HR Fields
  employmentType EmploymentType? @default(PERMANENT)
  shiftId        String?
  shift          Shift?          @relation("EmployeeShift", fields: [shiftId], references: [id], onDelete: SetNull)

  // New Inverse Relations
  attendances     Attendance[]
  attendanceLogs  AttendanceLog[]
  leaveApps       LeaveApplication[]
  salaryStructure EmployeeSalary?
  overtimes       Overtime[]
  loans           EmployeeLoan[]
  payrollItems    PayrollItem[]

  @@index([userId])
  @@index([status])
  @@index([employeeCode])
  @@index([email])
  @@index([salaryPayableAccountId])
  @@index([advanceAccountId])
  @@index([warehouseId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  code      String
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([code])
  @@index([expires])
}

model UserLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model File {
  id         String   @id @default(cuid())
  ownerId    String
  name       String
  path       String
  storageKey String   @unique
  size       Int
  mimeType   String
  isFolder   Boolean  @default(false)
  etag       String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([storageKey])
  @@index([path])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType
  userId    String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  readAt    DateTime?
  createdBy String?
  creator   User?            @relation("NotificationCreator", fields: [createdBy], references: [id])
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
  @@index([createdBy])
}

model Unit {
  id        String   @id @default(cuid())
  details   String
  symbol    String   @unique
  status    String   @default("active")
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator   User     @relation("UnitCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  items     Item[]

  @@index([status])
  @@index([createdBy])
}

model Organization {
  id               String             @id @default(cuid())
  name             String
  details          String?
  address          String?
  phone            String?
  email            String?
  website          String?
  logo             String?
  status           String             @default("active")
  createdBy        String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  JournalEntryLine JournalEntryLine[]
  creator          User               @relation("OrganizationCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  Voucher          Voucher[]
  VoucherLine      VoucherLine[]

  @@index([status])
  @@index([createdBy])
  @@index([name])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       Item[]

  @@index([name])
  @@index([status])
}

model Item {
  id             String   @id @default(cuid())
  code           String   @unique // Auto-generated: RM-2026-0001, FG-2026-0001, RT-2026-0001
  name           String
  description    String?
  itemType       ItemType
  categoryId     String?
  unitId         String
  costPrice      Decimal  @db.Decimal(12, 2) // Purchase/cost price
  salesPrice     Decimal? @db.Decimal(12, 2) // Selling price (required for READY_PRODUCT)
  wholesalePrice Decimal? @db.Decimal(12, 2) // Wholesale price
  discount       Decimal? @db.Decimal(12, 2) // Discount amount or percentage
  trackInventory Boolean  @default(false) // Inventory tracking flag
  images         Json? // Array of image URLs/paths
  featuredImage  String? // URL/path of the featured image
  sizes          String[] // Available sizes
  colors         String[] // Available colors
  isEnableEcom   Boolean  @default(false) // Whether to show in e-commerce
  status         String   @default("active") // active, inactive, trash
  isTrash        Boolean  @default(false)
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category                Category?                 @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit                    Unit                      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  creator                 User                      @relation("ItemCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  stocks                  Stock[]
  stockLedgers            StockLedger[]
  bomAsFinishedGood       BOM[]                     @relation("BOMFinishedGood")
  bomAsRawMaterial        BOMItem[]                 @relation("BOMRawMaterial")
  productionOrders        ProductionOrder[]         @relation("ProductionOrderFG")
  purchaseItems           PurchaseItem[]
  saleItems               SaleItem[]
  InventoryAdjustmentItem InventoryAdjustmentItem[]

  @@index([code])
  @@index([name])
  @@index([itemType])
  @@index([categoryId])
  @@index([unitId])
  @@index([status])
  @@index([isTrash])
  @@index([createdBy])
}

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique // Auto-generated: WH-2026-0001
  name      String
  address   String?
  city      String?
  state     String?
  zip       String?
  country   String?
  status    String   @default("active") // active, inactive, trash
  isTrash   Boolean  @default(false)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator             User                  @relation("WarehouseCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  stocks              Stock[]
  stockLedgers        StockLedger[]
  productionOrders    ProductionOrder[]
  purchases           Purchase[]
  sales               Sale[]
  InventoryAdjustment InventoryAdjustment[]
  defaultUsers        User[]                @relation("UserDefaultWarehouse")
  employees           Employee[]            @relation("WarehouseEmployees")
  holidays            Holiday[]

  @@index([code])
  @@index([name])
  @@index([status])
  @@index([isTrash])
  @@index([createdBy])
}

model Stock {
  id               String   @id @default(cuid())
  itemId           String
  warehouseId      String
  quantity         Decimal  @default(0) @db.Decimal(12, 2)
  reservedQuantity Decimal  @default(0) @db.Decimal(12, 2) // Reserved for production orders
  lastUpdated      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([itemId, warehouseId])
  @@index([itemId])
  @@index([warehouseId])
  @@index([lastUpdated])
}

model StockLedger {
  id              String               @id @default(cuid())
  itemId          String
  warehouseId     String
  transactionType StockTransactionType
  quantity        Decimal              @db.Decimal(12, 2) // Positive for IN, negative for OUT
  rate            Decimal?             @db.Decimal(12, 2) // Unit cost/rate for this transaction
  referenceType   String? // "PURCHASE", "PRODUCTION", "SALE", "ADJUSTMENT"
  referenceId     String? // ID of related document (Purchase.id, ProductionOrder.id, etc.)
  notes           String?
  createdAt       DateTime             @default(now())
  createdBy       String

  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  creator   User      @relation("StockLedgerCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([warehouseId])
  @@index([transactionType])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@index([createdBy])
}

model BOM {
  id              String   @id @default(cuid())
  code            String   @unique // Auto-generated: BOM-2026-0001
  name            String
  description     String?
  itemId          String // Ready Product item
  quantityPerUnit Decimal  @db.Decimal(12, 2) // Quantity of FG produced (e.g., 10 pieces)
  status          String   @default("active") // active, inactive, trash
  isTrash         Boolean  @default(false)
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  item             Item              @relation("BOMFinishedGood", fields: [itemId], references: [id], onDelete: Restrict)
  creator          User              @relation("BOMCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  items            BOMItem[]
  productionOrders ProductionOrder[]

  @@index([code])
  @@index([itemId])
  @@index([status])
  @@index([isTrash])
  @@index([createdBy])
}

model BOMItem {
  id               String   @id @default(cuid())
  bomId            String
  itemId           String // Raw Material item
  quantityRequired Decimal  @db.Decimal(12, 2) // Quantity required per FG unit
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bom  BOM  @relation(fields: [bomId], references: [id], onDelete: Cascade)
  item Item @relation("BOMRawMaterial", fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([bomId, itemId])
  @@index([bomId])
  @@index([itemId])
}

model ProductionOrder {
  id          String                @id @default(cuid())
  code        String                @unique // Auto-generated: PROD-2026-0001
  bomId       String // Link to BOM
  itemId      String // Ready Product item (for quick access)
  warehouseId String // Production warehouse
  quantity    Decimal               @db.Decimal(12, 2) // Quantity to produce
  status      ProductionOrderStatus @default(PLANNED)
  voucherId   String? // Link to accounting voucher
  notes       String?
  isTrash     Boolean               @default(false)
  createdBy   String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  completedAt DateTime? // When status = COMPLETED

  bom       BOM       @relation(fields: [bomId], references: [id], onDelete: Restrict)
  item      Item      @relation("ProductionOrderFG", fields: [itemId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  voucher   Voucher?  @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  creator   User      @relation("ProductionOrderCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([bomId])
  @@index([itemId])
  @@index([warehouseId])
  @@index([status])
  @@index([voucherId])
  @@index([isTrash])
  @@index([createdBy])
}

model Client {
  id               String             @id @default(cuid())
  name             String?
  email            String             @unique
  phone            String?
  address          String?
  city             String?
  state            String?
  zip              String?
  country          String?
  company          String?
  image            String?
  openingBalance   Decimal            @default(0) @db.Decimal(12, 2)
  createdBy        String
  status           String             @default("active")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  chartOfAccountId String?
  clientCode       String?            @unique
  ChartOfAccount   ChartOfAccount?    @relation(fields: [chartOfAccountId], references: [id])
  createdByUser    User               @relation("ClientCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  JournalEntryLine JournalEntryLine[]
  Voucher          Voucher[]
  VoucherLine      VoucherLine[]
  sales            Sale[]

  @@index([status])
  @@index([createdBy])
  @@index([email])
  @@index([chartOfAccountId])
  @@index([clientCode])
}

model Supplier {
  id               String             @id @default(cuid())
  name             String?
  email            String             @unique
  phone            String?
  address          String?
  city             String?
  state            String?
  zip              String?
  country          String?
  company          String?
  image            String?
  openingBalance   Decimal            @default(0) @db.Decimal(12, 2)
  createdBy        String
  status           String             @default("active")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  chartOfAccountId String?
  supplierCode     String?            @unique
  JournalEntryLine JournalEntryLine[]
  ChartOfAccount   ChartOfAccount?    @relation(fields: [chartOfAccountId], references: [id])
  createdByUser    User               @relation("SupplierCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  Voucher          Voucher[]
  VoucherLine      VoucherLine[]
  Purchase         Purchase[]

  @@index([status])
  @@index([createdBy])
  @@index([email])
  @@index([chartOfAccountId])
  @@index([supplierCode])
}

model Purchase {
  id             String         @id @default(cuid())
  purchaseNumber String         @unique
  supplierId     String
  warehouseId    String? // Warehouse for all items in purchase
  voucherId      String? // Link to accounting voucher
  date           DateTime       @default(now())
  status         PurchaseStatus @default(DRAFT)
  notes          String?
  attachmentUrl  String?
  subTotal       Decimal        @db.Decimal(12, 2)
  discount       Decimal?       @db.Decimal(5, 2)
  tax            Decimal?       @db.Decimal(5, 2)
  grandTotal     Decimal        @db.Decimal(12, 2)
  isTrash        Boolean        @default(false)
  createdBy      String
  updatedBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  warehouse     Warehouse?     @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  voucher       Voucher?       @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  createdByUser User           @relation("PurchaseCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  updatedByUser User?          @relation("PurchaseUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  items         PurchaseItem[]

  @@index([supplierId])
  @@index([warehouseId])
  @@index([voucherId])
  @@index([status])
  @@index([date])
  @@index([isTrash])
  @@index([purchaseNumber])
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  itemId      String?
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item     Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([itemId])
}

model Sale {
  id            String     @id @default(cuid())
  saleNumber    String     @unique // Auto-generated: SAL-2026-0001
  clientId      String
  warehouseId   String
  voucherId     String? // Link to accounting voucher
  date          DateTime   @default(now())
  status        SaleStatus @default(DRAFT)
  notes         String?
  attachmentUrl String?
  subTotal      Decimal    @db.Decimal(12, 2)
  discount      Decimal?   @db.Decimal(5, 2)
  tax           Decimal?   @db.Decimal(5, 2)
  grandTotal    Decimal    @db.Decimal(12, 2)
  isTrash       Boolean    @default(false)
  createdBy     String
  updatedBy     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  completedAt   DateTime? // When status = COMPLETED

  client        Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  warehouse     Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  voucher       Voucher?   @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  createdByUser User       @relation("SaleCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  updatedByUser User?      @relation("SaleUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  items         SaleItem[]

  @@index([clientId])
  @@index([warehouseId])
  @@index([voucherId])
  @@index([status])
  @@index([date])
  @@index([isTrash])
  @@index([saleNumber])
  @@index([createdBy])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  itemId      String // Required - only FG and RETAIL items
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([itemId])
}

model Settings {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  title        String   @db.VarChar(255)
  code         String   @db.VarChar(100)
  category     String   @db.VarChar(100)
  settings     Json
  isActive     Boolean  @default(true) @map("is_active")
  isDefault    Boolean  @default(false) @map("is_default")
  isGlobal     Boolean  @default(false) @map("is_global")
  displayOrder Int      @default(0) @map("display_order")
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  creator      User?    @relation("SettingsCreator", fields: [createdBy], references: [id])
  user         User?    @relation("SettingsUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
  @@index([category])
  @@index([userId, code])
  @@index([userId, category])
  @@index([isGlobal])
  @@index([settings(ops: JsonbPathOps)], type: Gin)
  @@map("settings")
}

model PermissionTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]   @relation("UserDesignationTemplate")

  @@index([isActive])
  @@index([name])
}

model UserPermission {
  id         String   @id @default(cuid())
  userId     String
  module     String
  operations Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@index([userId])
  @@index([module])
}

model ModuleOperation {
  id          String   @id @default(cuid())
  module      String
  operation   String
  label       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([module, operation])
  @@index([module])
  @@index([isActive])
}

model CashBankAccount {
  id               String              @id @default(cuid())
  chartOfAccountId String              @unique
  type             CashBankAccountType
  status           String              @default("active")
  createdBy        String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime
  ChartOfAccount   ChartOfAccount      @relation(fields: [chartOfAccountId], references: [id], onDelete: Cascade)
  User             User                @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([chartOfAccountId])
  @@index([createdBy])
  @@index([status])
  @@index([type])
}

model ChartOfAccount {
  id                                                       String             @id @default(cuid())
  code                                                     String             @unique
  name                                                     String
  type                                                     AccountType
  parentId                                                 String?
  description                                              String?
  isControl                                                Boolean            @default(false)
  status                                                   String             @default("active")
  createdBy                                                String
  createdAt                                                DateTime           @default(now())
  updatedAt                                                DateTime           @updatedAt
  CashBankAccount                                          CashBankAccount?
  User                                                     User               @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  ChartOfAccount                                           ChartOfAccount?    @relation("ChartOfAccountToChartOfAccount", fields: [parentId], references: [id])
  other_ChartOfAccount                                     ChartOfAccount[]   @relation("ChartOfAccountToChartOfAccount")
  Client                                                   Client[]
  Employee_Employee_advanceAccountIdToChartOfAccount       Employee[]         @relation("Employee_advanceAccountIdToChartOfAccount")
  Employee_Employee_salaryPayableAccountIdToChartOfAccount Employee[]         @relation("Employee_salaryPayableAccountIdToChartOfAccount")
  JournalEntryLine                                         JournalEntryLine[]
  Supplier                                                 Supplier[]
  VoucherLine                                              VoucherLine[]

  @@index([code])
  @@index([createdBy])
  @@index([parentId])
  @@index([status])
  @@index([type])
}

model JournalEntry {
  id               String             @id @default(cuid())
  entryNumber      String             @unique
  date             DateTime           @default(now())
  voucherId        String
  description      String?
  status           String             @default("posted")
  createdBy        String
  postedBy         String
  postedAt         DateTime
  createdAt        DateTime           @default(now())
  Voucher          Voucher            @relation(fields: [voucherId], references: [id])
  JournalEntryLine JournalEntryLine[]

  @@index([date])
  @@index([entryNumber])
  @@index([status])
  @@index([voucherId])
}

model JournalEntryLine {
  id               String         @id @default(cuid())
  lineNumber       Int
  debitAmount      Decimal        @default(0) @db.Decimal(12, 2)
  creditAmount     Decimal        @default(0) @db.Decimal(12, 2)
  description      String?
  journalEntryId   String
  chartOfAccountId String
  createdAt        DateTime       @default(now())
  clientId         String?
  supplierId       String?
  userId           String?
  organizationId   String?
  ChartOfAccount   ChartOfAccount @relation(fields: [chartOfAccountId], references: [id])
  Client           Client?        @relation(fields: [clientId], references: [id])
  JournalEntry     JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  Organization     Organization?  @relation(fields: [organizationId], references: [id])
  Supplier         Supplier?      @relation(fields: [supplierId], references: [id])
  User             User?          @relation(fields: [userId], references: [id])

  @@index([chartOfAccountId])
  @@index([clientId])
  @@index([journalEntryId])
  @@index([organizationId])
  @@index([supplierId])
  @@index([userId])
}

model Voucher {
  id                            String               @id @default(cuid())
  voucherNumber                 String               @unique
  date                          DateTime             @default(now())
  type                          VoucherType
  reference                     String?
  description                   String?
  status                        String               @default("draft")
  createdBy                     String
  postedById                    String?
  postedAt                      DateTime?
  createdAt                     DateTime             @default(now())
  updatedAt                     DateTime             @updatedAt
  clientId                      String?
  supplierId                    String?
  userId                        String?
  organizationId                String?
  JournalEntry                  JournalEntry[]
  Client                        Client?              @relation(fields: [clientId], references: [id])
  User_Voucher_createdByToUser  User                 @relation("Voucher_createdByToUser", fields: [createdBy], references: [id], onDelete: Cascade)
  Organization                  Organization?        @relation(fields: [organizationId], references: [id])
  User_Voucher_postedByIdToUser User?                @relation("Voucher_postedByIdToUser", fields: [postedById], references: [id])
  Supplier                      Supplier?            @relation(fields: [supplierId], references: [id])
  User_Voucher_userIdToUser     User?                @relation("Voucher_userIdToUser", fields: [userId], references: [id])
  VoucherLine                   VoucherLine[]
  purchases                     Purchase[]
  sales                         Sale[]
  productionOrders              ProductionOrder[]
  inventoryAdjustment           InventoryAdjustment?
  isLocked                      Boolean              @default(false)

  // Linking vouchers to payroll and advances
  payrollAccrual Payroll?       @relation("PayrollVoucher")
  payrollPayment Payroll?       @relation("PayrollPaymentVoucher")
  employeeLoans  EmployeeLoan[]

  @@index([clientId])
  @@index([createdBy])
  @@index([date])
  @@index([organizationId])
  @@index([postedById])
  @@index([status])
  @@index([supplierId])
  @@index([type])
  @@index([userId])
  @@index([voucherNumber])
}

model VoucherLine {
  id               String         @id @default(cuid())
  lineNumber       Int
  debitAmount      Decimal        @default(0) @db.Decimal(12, 2)
  creditAmount     Decimal        @default(0) @db.Decimal(12, 2)
  description      String?
  voucherId        String
  chartOfAccountId String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  clientId         String?
  supplierId       String?
  userId           String?
  organizationId   String?
  ChartOfAccount   ChartOfAccount @relation(fields: [chartOfAccountId], references: [id])
  Client           Client?        @relation(fields: [clientId], references: [id])
  Organization     Organization?  @relation(fields: [organizationId], references: [id])
  Supplier         Supplier?      @relation(fields: [supplierId], references: [id])
  User             User?          @relation(fields: [userId], references: [id])
  Voucher          Voucher        @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([chartOfAccountId])
  @@index([clientId])
  @@index([organizationId])
  @@index([supplierId])
  @@index([userId])
  @@index([voucherId])
}

enum NotificationType {
  SYSTEM
  ADMIN
  INFO
  WARNING
  ERROR
  SUCCESS
}

model AccountingPeriod {
  id        String    @id @default(cuid())
  name      String    @unique // e.g., "Jan 2026"
  startDate DateTime
  endDate   DateTime
  isLocked  Boolean   @default(false)
  lockedAt  DateTime?
  lockedBy  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([startDate, endDate])
  @@index([isLocked])
}

enum InventoryAdjustmentStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model InventoryAdjustment {
  id               String                    @id @default(cuid())
  adjustmentNumber String                    @unique
  warehouseId      String
  date             DateTime                  @default(now())
  status           InventoryAdjustmentStatus @default(DRAFT)
  notes            String?
  voucherId        String?                   @unique
  createdBy        String
  updatedBy        String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  warehouse     Warehouse                 @relation(fields: [warehouseId], references: [id])
  voucher       Voucher?                  @relation(fields: [voucherId], references: [id])
  createdByUser User                      @relation("InventoryAdjustment_createdBy", fields: [createdBy], references: [id])
  updatedByUser User?                     @relation("InventoryAdjustment_updatedBy", fields: [updatedBy], references: [id])
  items         InventoryAdjustmentItem[]

  @@index([warehouseId])
  @@index([voucherId])
  @@index([createdBy])
  @@index([date])
  @@index([status])
}

model InventoryAdjustmentItem {
  id                    String   @id @default(cuid())
  inventoryAdjustmentId String
  itemId                String
  quantity              Decimal  @db.Decimal(12, 2) // Positive for Gain, Negative for Loss
  unitRate              Decimal  @default(0) @db.Decimal(12, 2) // Current Cost Price
  amount                Decimal  @default(0) @db.Decimal(12, 2) // quantity * unitRate (Absolute value for display/accounting logic)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  inventoryAdjustment InventoryAdjustment @relation(fields: [inventoryAdjustmentId], references: [id], onDelete: Cascade)
  item                Item                @relation(fields: [itemId], references: [id])

  @@index([inventoryAdjustmentId])
  @@index([itemId])
}

model Shift {
  id           String @id @default(cuid())
  name         String
  startTime    String // Format: "09:00"
  endTime      String // Format: "18:00"
  graceMinutes Int    @default(0)
  lateAfter    Int    @default(15) // Minutes after start time
  halfDayAfter Int    @default(120) // Minutes after start time
  otStartAfter Int    @default(30) // Minutes after end time

  status    String   @default("active")
  isTrash   Boolean  @default(false)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator     User         @relation("ShiftCreator", fields: [createdBy], references: [id])
  employees   Employee[]   @relation("EmployeeShift")
  attendances Attendance[]

  @@index([status])
  @@index([isTrash])
  @@index([createdBy])
}

model Holiday {
  id          String   @id @default(cuid())
  name        String
  date        DateTime @db.Date
  warehouseId String? // Optional: If null, it's a global company holiday

  status    String   @default("active")
  isTrash   Boolean  @default(false)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  creator   User       @relation("HolidayCreator", fields: [createdBy], references: [id])

  @@index([date])
  @@index([warehouseId])
  @@index([createdBy])
}

model LeaveType {
  id          String        @id @default(cuid())
  name        String
  category    LeaveCategory
  defaultDays Int           @default(0)
  isPaid      Boolean       @default(true)

  status    String   @default("active")
  isTrash   Boolean  @default(false)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator      User               @relation("LeaveTypeCreator", fields: [createdBy], references: [id])
  applications LeaveApplication[]
}

model LeaveApplication {
  id          String      @id @default(cuid())
  employeeId  String
  leaveTypeId String
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  totalDays   Int
  reason      String?
  status      LeaveStatus @default(PENDING)
  managerId   String?
  hrId        String?

  isTrash   Boolean  @default(false)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  manager   User?     @relation("LeaveManager", fields: [managerId], references: [id], onDelete: SetNull)
  hr        User?     @relation("LeaveHR", fields: [hrId], references: [id], onDelete: SetNull)
  creator   User      @relation("LeaveAppCreator", fields: [createdBy], references: [id])
  
  attendances Attendance[]

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([managerId])
  @@index([hrId])
}

model AttendanceLog {
  id         String           @id @default(cuid())
  employeeId String
  timestamp  DateTime
  source     AttendanceSource
  deviceId   String? // E.g., ID from BiometricDevice model
  device     BiometricDevice? @relation(fields: [deviceId], references: [id])
  createdAt  DateTime         @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, timestamp]) // Crucial for preventing duplicate biometric syncs
  @@index([employeeId])
  @@index([timestamp])
}

model Attendance {
  id         String           @id @default(cuid())
  employeeId String
  date       DateTime         @db.Date
  shiftId    String?
  checkIn    DateTime?
  checkOut   DateTime?
  workHours  Decimal          @default(0) @db.Decimal(5, 2)
  otHours    Decimal          @default(0) @db.Decimal(5, 2)
  status     AttendanceStatus
  isManual   Boolean          @default(false)
  notes      String?
  isLocked   Boolean          @default(false) // Locked after payroll is posted
  
  leaveApplicationId String?
  leaveApplication   LeaveApplication? @relation(fields: [leaveApplicationId], references: [id], onDelete: SetNull)

  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  creator  User?    @relation("AttendanceCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updater  User?    @relation("AttendanceUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([employeeId, date]) // Only one processed attendance record per day per employee
  @@index([date])
  @@index([status])
  @@index([employeeId, date])
  @@index([isLocked])
}

model Overtime {
  id          String   @id @default(cuid())
  employeeId  String
  date        DateTime @db.Date
  hours       Decimal  @db.Decimal(5, 2)
  ratePerHour Decimal  @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(12, 2)
  status      String   @default("approved") // pending, approved, paid
  isLocked    Boolean  @default(false) // True when payroll generated

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  creator  User     @relation("OvertimeCreator", fields: [createdBy], references: [id])

  @@index([employeeId])
  @@index([date])
  @@index([status])
}

model EmployeeLoan {
  id                 String     @id @default(cuid())
  employeeId         String
  amount             Decimal    @db.Decimal(12, 2)
  monthlyInstallment Decimal    @db.Decimal(12, 2)
  remainingBalance   Decimal    @db.Decimal(12, 2)
  issueDate          DateTime   @db.Date
  status             LoanStatus @default(PENDING)
  voucherId          String? // Links to the PAYMENT voucher generated when advance is given
  approvedBy         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  voucher  Voucher? @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  approver User?    @relation("LoanApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
  @@index([voucherId])
}

model EmployeeSalary {
  id            String  @id @default(cuid())
  employeeId    String  @unique
  basic         Decimal @default(0) @db.Decimal(12, 2)
  houseRent     Decimal @default(0) @db.Decimal(12, 2)
  medical       Decimal @default(0) @db.Decimal(12, 2)
  transport     Decimal @default(0) @db.Decimal(12, 2)
  foodAllowance Decimal @default(0) @db.Decimal(12, 2)
  taxPercentage Decimal @default(0) @db.Decimal(5, 2)
  pfPercentage  Decimal @default(0) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Payroll {
  id            String        @id @default(cuid())
  payrollNumber String        @unique // Auto-generated: PR-2026-05
  month         Int // 1-12
  year          Int
  dateGenerated DateTime      @default(now())
  status        PayrollStatus @default(DRAFT)
  totalAmount   Decimal       @default(0) @db.Decimal(12, 2)
  voucherId     String?       @unique // Links to accounting JOURNAL voucher (accrual mapping)
  paymentVchId  String?       @unique // Links to PAYMENT voucher (actual cash/bank payout)
  notes         String?

  isTrash    Boolean  @default(false)
  createdBy  String
  approvedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  voucher        Voucher?      @relation("PayrollVoucher", fields: [voucherId], references: [id], onDelete: Restrict)
  paymentVoucher Voucher?      @relation("PayrollPaymentVoucher", fields: [paymentVchId], references: [id], onDelete: Restrict)
  creator        User          @relation("PayrollCreator", fields: [createdBy], references: [id])
  approver       User?         @relation("PayrollApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  items          PayrollItem[]

  @@index([month, year])
  @@index([status])
  @@index([voucherId])
  @@index([month, year, status])
}

model PayrollItem {
  id         String @id @default(cuid())
  payrollId  String
  employeeId String

  // Earnings snapshot
  basic         Decimal @default(0) @db.Decimal(12, 2)
  houseRent     Decimal @default(0) @db.Decimal(12, 2)
  medical       Decimal @default(0) @db.Decimal(12, 2)
  transport     Decimal @default(0) @db.Decimal(12, 2)
  foodAllowance Decimal @default(0) @db.Decimal(12, 2)
  otAmount      Decimal @default(0) @db.Decimal(12, 2)
  bonus         Decimal @default(0) @db.Decimal(12, 2)
  grossPay      Decimal @default(0) @db.Decimal(12, 2)

  // Deductions snapshot
  absentDeduction Decimal @default(0) @db.Decimal(12, 2)
  loanDeduction   Decimal @default(0) @db.Decimal(12, 2) // Deducted from advanceAccountId
  taxDeduction    Decimal @default(0) @db.Decimal(12, 2)
  pfDeduction     Decimal @default(0) @db.Decimal(12, 2)
  totalDeduction  Decimal @default(0) @db.Decimal(12, 2)

  netPay Decimal @default(0) @db.Decimal(12, 2)

  status    String   @default("unpaid") // unpaid, paid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payroll  Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([payrollId, employeeId])
  @@index([employeeId])
  @@index([status])
  @@index([employeeId, status])
}

model BiometricSyncLog {
  id           String   @id @default(cuid())
  syncTime     DateTime @default(now())
  vendor       String // ZKTeco, eSSL, FingerTec
  deviceId     String?
  device       BiometricDevice? @relation(fields: [deviceId], references: [id])
  recordsCount Int      @default(0)
  status       String   @default("SUCCESS") // SUCCESS, FAILED
  errorMessage String?
  syncedBy     String
  user         User     @relation(fields: [syncedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([syncTime])
  @@index([vendor])
}

model BiometricDevice {
  id          String   @id @default(cuid())
  name        String
  vendor      String // ZKTeco, eSSL, FingerTec
  connectionType String @default("IP") // IP, WEB_API, USB
  ipAddress   String?
  port        Int?      @default(4370)
  apiKey      String?
  serialNumber String?  @unique
  location    String?
  status      String   @default("active") // active, inactive, disconnected
  lastSyncAt  DateTime?
  
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  syncLogs    BiometricSyncLog[]
  attendanceLogs AttendanceLog[]

  @@index([vendor])
  @@index([status])
}
