generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                               String                @id @default(cuid())
  name                             String?
  email                            String                @unique
  emailVerified                    DateTime?
  password                         String
  image                            String?
  role                             String                @default("user")
  status                           String                @default("active")
  createdAt                        DateTime              @default(now())
  updatedAt                        DateTime              @updatedAt
  designationTemplateId            String?
  permissions                      Json?
  inchargeId                       String?
  defaultWarehouseId               String?
  isActive                         String                @default("")
  accounts                         Account[]
  createdAttendances               Attendance[]          @relation("AttendanceCreator")
  updatedAttendances               Attendance[]          @relation("AttendanceUpdater")
  createdBOMs                      BOM[]                 @relation("BOMCreator")
  biometricSyncLogs                BiometricSyncLog[]
  CashBankAccount                  CashBankAccount[]
  ChartOfAccount                   ChartOfAccount[]
  createdClients                   Client[]              @relation("ClientCreator")
  Employee                         Employee?             @relation("UserEmployee")
  approvedLoans                    EmployeeLoan[]        @relation("LoanApprover")
  files                            File[]
  createdHolidays                  Holiday[]             @relation("HolidayCreator")
  InventoryAdjustmentCreated       InventoryAdjustment[] @relation("InventoryAdjustment_createdBy")
  InventoryAdjustmentUpdated       InventoryAdjustment[] @relation("InventoryAdjustment_updatedBy")
  createdItems                     Item[]                @relation("ItemCreator")
  JournalEntryLine                 JournalEntryLine[]
  createdLeaveApps                 LeaveApplication[]    @relation("LeaveAppCreator")
  hrLeaves                         LeaveApplication[]    @relation("LeaveHR")
  managedLeaves                    LeaveApplication[]    @relation("LeaveManager")
  createdLeaveTypes                LeaveType[]           @relation("LeaveTypeCreator")
  createdNotifications             Notification[]        @relation("NotificationCreator")
  notifications                    Notification[]
  createdOrganizations             Organization[]        @relation("OrganizationCreator")
  createdOvertimes                 Overtime[]            @relation("OvertimeCreator")
  approvedPayrolls                 Payroll[]             @relation("PayrollApprover")
  createdPayrolls                  Payroll[]             @relation("PayrollCreator")
  createdProductionOrders          ProductionOrder[]     @relation("ProductionOrderCreator")
  createdPurchases                 Purchase[]            @relation("PurchaseCreatedBy")
  updatedPurchases                 Purchase[]            @relation("PurchaseUpdatedBy")
  createdSales                     Sale[]                @relation("SaleCreatedBy")
  updatedSales                     Sale[]                @relation("SaleUpdatedBy")
  sessions                         Session[]
  createdShifts                    Shift[]               @relation("ShiftCreator")
  createdStockLedgers              StockLedger[]         @relation("StockLedgerCreator")
  createdSuppliers                 Supplier[]            @relation("SupplierCreator")
  createdUnits                     Unit[]                @relation("UnitCreator")
  defaultWarehouse                 Warehouse?            @relation("UserDefaultWarehouse", fields: [defaultWarehouseId], references: [id])
  designationTemplate              PermissionTemplate?   @relation("UserDesignationTemplate", fields: [designationTemplateId], references: [id])
  incharge                         User?                 @relation("UserIncharge", fields: [inchargeId], references: [id])
  inchargeOf                       User[]                @relation("UserIncharge")
  userLogs                         UserLog[]
  userPermissions                  UserPermission[]
  Voucher_Voucher_createdByToUser  Voucher[]             @relation("Voucher_createdByToUser")
  Voucher_Voucher_postedByIdToUser Voucher[]             @relation("Voucher_postedByIdToUser")
  Voucher_Voucher_userIdToUser     Voucher[]             @relation("Voucher_userIdToUser")
  VoucherLine                      VoucherLine[]
  createdWarehouses                Warehouse[]           @relation("WarehouseCreator")
  createdSettings                  Settings[]            @relation("SettingsCreator")
  settings                         Settings[]            @relation("SettingsUser")

  @@index([status])
  @@index([designationTemplateId])
  @@index([inchargeId])
}

model Employee {
  id                     String             @id @default(cuid())
  name                   String
  employeeCode           String?            @unique
  email                  String?
  phone                  String?
  userId                 String?            @unique
  status                 String             @default("active")
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  salaryPayableAccountId String?
  advanceAccountId       String?
  address                Json?
  dateOfBirth            DateTime?
  department             String?
  designation            String?
  emergencyContact       Json?
  gender                 String?
  joiningDate            DateTime?
  nationalId             String?
  photo                  String?
  salary                 Decimal?           @db.Decimal(12, 2)
  warehouseId            String?
  employmentType         EmploymentType?    @default(PERMANENT)
  shiftId                String?
  attendances            Attendance[]
  attendanceLogs         AttendanceLog[]
  advanceAccount         ChartOfAccount?    @relation("Employee_advanceAccountIdToChartOfAccount", fields: [advanceAccountId], references: [id])
  salaryPayableAccount   ChartOfAccount?    @relation("Employee_salaryPayableAccountIdToChartOfAccount", fields: [salaryPayableAccountId], references: [id])
  shift                  Shift?             @relation("EmployeeShift", fields: [shiftId], references: [id])
  user                   User?              @relation("UserEmployee", fields: [userId], references: [id])
  warehouse              Warehouse?         @relation("WarehouseEmployees", fields: [warehouseId], references: [id])
  loans                  EmployeeLoan[]
  salaryStructure        EmployeeSalary?
  leaveApps              LeaveApplication[]
  overtimes              Overtime[]
  payrollItems           PayrollItem[]

  @@index([userId])
  @@index([status])
  @@index([employeeCode])
  @@index([email])
  @@index([salaryPayableAccountId])
  @@index([advanceAccountId])
  @@index([warehouseId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  code      String
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([code])
  @@index([expires])
}

model UserLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model File {
  id         String   @id @default(cuid())
  ownerId    String
  name       String
  path       String
  storageKey String   @unique
  size       Int
  mimeType   String
  isFolder   Boolean  @default(false)
  etag       String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([storageKey])
  @@index([path])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType
  userId    String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  readAt    DateTime?
  createdBy String?
  creator   User?            @relation("NotificationCreator", fields: [createdBy], references: [id])
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
  @@index([createdBy])
}

model Unit {
  id        String   @id @default(cuid())
  details   String
  symbol    String   @unique
  status    String   @default("active")
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     Item[]
  creator   User     @relation("UnitCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdBy])
}

model Organization {
  id               String             @id @default(cuid())
  name             String
  details          String?
  address          String?
  phone            String?
  email            String?
  website          String?
  logo             String?
  status           String             @default("active")
  createdBy        String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  JournalEntryLine JournalEntryLine[]
  creator          User               @relation("OrganizationCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  Voucher          Voucher[]
  VoucherLine      VoucherLine[]

  @@index([status])
  @@index([createdBy])
  @@index([name])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       Item[]

  @@index([name])
  @@index([status])
}

model Item {
  id                      String                    @id @default(cuid())
  code                    String                    @unique
  description             String?
  unitId                  String
  costPrice               Decimal                   @db.Decimal(12, 2)
  status                  String                    @default("active")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  categoryId              String?
  name                    String
  itemType                ItemType
  salesPrice              Decimal?                  @db.Decimal(12, 2)
  trackInventory          Boolean                   @default(false)
  isTrash                 Boolean                   @default(false)
  createdBy               String
  colors                  String[]
  discount                Decimal?                  @db.Decimal(12, 2)
  images                  Json?
  isEnableEcom            Boolean                   @default(false)
  sizes                   String[]
  wholesalePrice          Decimal?                  @db.Decimal(12, 2)
  featuredImage           String?
  bomAsFinishedGood       BOM[]                     @relation("BOMFinishedGood")
  bomAsRawMaterial        BOMItem[]                 @relation("BOMRawMaterial")
  InventoryAdjustmentItem InventoryAdjustmentItem[]
  category                Category?                 @relation(fields: [categoryId], references: [id])
  creator                 User                      @relation("ItemCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  unit                    Unit                      @relation(fields: [unitId], references: [id])
  productionOrders        ProductionOrder[]         @relation("ProductionOrderFG")
  purchaseItems           PurchaseItem[]
  saleItems               SaleItem[]
  stocks                  Stock[]
  stockLedgers            StockLedger[]

  @@index([code])
  @@index([name])
  @@index([itemType])
  @@index([categoryId])
  @@index([unitId])
  @@index([status])
  @@index([isTrash])
  @@index([createdBy])
}

model Warehouse {
  id                  String                @id @default(cuid())
  name                String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  code                String                @unique
  createdBy           String
  isTrash             Boolean               @default(false)
  status              String                @default("active")
  address             String?
  city                String?
  country             String?
  state               String?
  zip                 String?
  employees           Employee[]            @relation("WarehouseEmployees")
  holidays            Holiday[]
  InventoryAdjustment InventoryAdjustment[]
  productionOrders    ProductionOrder[]
  purchases           Purchase[]
  sales               Sale[]
  stocks              Stock[]
  stockLedgers        StockLedger[]
  defaultUsers        User[]                @relation("UserDefaultWarehouse")
  creator             User                  @relation("WarehouseCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([name])
  @@index([status])
  @@index([isTrash])
  @@index([createdBy])
}

model Stock {
  id               String    @id @default(cuid())
  itemId           String
  warehouseId      String
  quantity         Decimal   @default(0) @db.Decimal(12, 2)
  reservedQuantity Decimal   @default(0) @db.Decimal(12, 2)
  lastUpdated      DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  item             Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([itemId, warehouseId])
  @@index([itemId])
  @@index([warehouseId])
  @@index([lastUpdated])
}

model StockLedger {
  id              String               @id @default(cuid())
  itemId          String
  warehouseId     String
  transactionType StockTransactionType
  quantity        Decimal              @db.Decimal(12, 2)
  referenceType   String?
  referenceId     String?
  notes           String?
  createdAt       DateTime             @default(now())
  createdBy       String
  rate            Decimal?             @db.Decimal(12, 2)
  creator         User                 @relation("StockLedgerCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  item            Item                 @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse       Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([warehouseId])
  @@index([transactionType])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@index([createdBy])
}

model BOM {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  description      String?
  itemId           String
  quantityPerUnit  Decimal           @db.Decimal(12, 2)
  status           String            @default("active")
  isTrash          Boolean           @default(false)
  createdBy        String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  creator          User              @relation("BOMCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  item             Item              @relation("BOMFinishedGood", fields: [itemId], references: [id])
  items            BOMItem[]
  productionOrders ProductionOrder[]

  @@index([code])
  @@index([itemId])
  @@index([status])
  @@index([isTrash])
  @@index([createdBy])
}

model BOMItem {
  id               String   @id @default(cuid())
  bomId            String
  itemId           String
  quantityRequired Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  bom              BOM      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  item             Item     @relation("BOMRawMaterial", fields: [itemId], references: [id])

  @@unique([bomId, itemId])
  @@index([bomId])
  @@index([itemId])
}

model ProductionOrder {
  id          String                @id @default(cuid())
  code        String                @unique
  bomId       String
  itemId      String
  warehouseId String
  quantity    Decimal               @db.Decimal(12, 2)
  status      ProductionOrderStatus @default(PLANNED)
  notes       String?
  isTrash     Boolean               @default(false)
  createdBy   String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  completedAt DateTime?
  voucherId   String?
  bom         BOM                   @relation(fields: [bomId], references: [id])
  creator     User                  @relation("ProductionOrderCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  item        Item                  @relation("ProductionOrderFG", fields: [itemId], references: [id])
  voucher     Voucher?              @relation(fields: [voucherId], references: [id])
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id])

  @@index([code])
  @@index([bomId])
  @@index([itemId])
  @@index([warehouseId])
  @@index([status])
  @@index([voucherId])
  @@index([isTrash])
  @@index([createdBy])
}

model Client {
  id               String             @id @default(cuid())
  name             String?
  email            String             @unique
  phone            String?
  address          String?
  city             String?
  state            String?
  zip              String?
  country          String?
  company          String?
  image            String?
  createdBy        String
  status           String             @default("active")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  chartOfAccountId String?
  clientCode       String?            @unique
  openingBalance   Decimal            @default(0) @db.Decimal(12, 2)
  ChartOfAccount   ChartOfAccount?    @relation(fields: [chartOfAccountId], references: [id])
  createdByUser    User               @relation("ClientCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  JournalEntryLine JournalEntryLine[]
  sales            Sale[]
  Voucher          Voucher[]
  VoucherLine      VoucherLine[]

  @@index([status])
  @@index([createdBy])
  @@index([email])
  @@index([chartOfAccountId])
  @@index([clientCode])
}

model Supplier {
  id               String             @id @default(cuid())
  name             String?
  email            String             @unique
  phone            String?
  address          String?
  city             String?
  state            String?
  zip              String?
  country          String?
  company          String?
  image            String?
  createdBy        String
  status           String             @default("active")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  chartOfAccountId String?
  supplierCode     String?            @unique
  openingBalance   Decimal            @default(0) @db.Decimal(12, 2)
  JournalEntryLine JournalEntryLine[]
  Purchase         Purchase[]
  ChartOfAccount   ChartOfAccount?    @relation(fields: [chartOfAccountId], references: [id])
  createdByUser    User               @relation("SupplierCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  Voucher          Voucher[]
  VoucherLine      VoucherLine[]

  @@index([status])
  @@index([createdBy])
  @@index([email])
  @@index([chartOfAccountId])
  @@index([supplierCode])
}

model Purchase {
  id             String         @id @default(cuid())
  purchaseNumber String         @unique
  supplierId     String
  date           DateTime       @default(now())
  status         PurchaseStatus @default(DRAFT)
  notes          String?
  attachmentUrl  String?
  subTotal       Decimal        @db.Decimal(12, 2)
  discount       Decimal?       @db.Decimal(5, 2)
  tax            Decimal?       @db.Decimal(5, 2)
  grandTotal     Decimal        @db.Decimal(12, 2)
  isTrash        Boolean        @default(false)
  createdBy      String
  updatedBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  voucherId      String?
  warehouseId    String?
  createdByUser  User           @relation("PurchaseCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  updatedByUser  User?          @relation("PurchaseUpdatedBy", fields: [updatedBy], references: [id])
  voucher        Voucher?       @relation(fields: [voucherId], references: [id])
  warehouse      Warehouse?     @relation(fields: [warehouseId], references: [id])
  items          PurchaseItem[]

  @@index([supplierId])
  @@index([warehouseId])
  @@index([voucherId])
  @@index([status])
  @@index([date])
  @@index([isTrash])
  @@index([purchaseNumber])
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  itemId      String?
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  item        Item?    @relation(fields: [itemId], references: [id])
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([itemId])
}

model Sale {
  id            String     @id @default(cuid())
  saleNumber    String     @unique
  clientId      String
  warehouseId   String
  voucherId     String?
  date          DateTime   @default(now())
  status        SaleStatus @default(DRAFT)
  notes         String?
  attachmentUrl String?
  subTotal      Decimal    @db.Decimal(12, 2)
  discount      Decimal?   @db.Decimal(5, 2)
  tax           Decimal?   @db.Decimal(5, 2)
  grandTotal    Decimal    @db.Decimal(12, 2)
  isTrash       Boolean    @default(false)
  createdBy     String
  updatedBy     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  completedAt   DateTime?
  client        Client     @relation(fields: [clientId], references: [id])
  createdByUser User       @relation("SaleCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  updatedByUser User?      @relation("SaleUpdatedBy", fields: [updatedBy], references: [id])
  voucher       Voucher?   @relation(fields: [voucherId], references: [id])
  warehouse     Warehouse  @relation(fields: [warehouseId], references: [id])
  items         SaleItem[]

  @@index([clientId])
  @@index([warehouseId])
  @@index([voucherId])
  @@index([status])
  @@index([date])
  @@index([isTrash])
  @@index([saleNumber])
  @@index([createdBy])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  itemId      String
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  item        Item     @relation(fields: [itemId], references: [id])
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([itemId])
}

model Settings {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  title        String   @db.VarChar(255)
  code         String   @db.VarChar(100)
  category     String   @db.VarChar(100)
  settings     Json
  isActive     Boolean  @default(true) @map("is_active")
  isDefault    Boolean  @default(false) @map("is_default")
  isGlobal     Boolean  @default(false) @map("is_global")
  displayOrder Int      @default(0) @map("display_order")
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  creator      User?    @relation("SettingsCreator", fields: [createdBy], references: [id])
  user         User?    @relation("SettingsUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
  @@index([category])
  @@index([userId, code])
  @@index([userId, category])
  @@index([isGlobal])
  @@index([settings(ops: JsonbPathOps)], type: Gin)
  @@map("settings")
}

model PermissionTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]   @relation("UserDesignationTemplate")

  @@index([isActive])
  @@index([name])
}

model UserPermission {
  id         String   @id @default(cuid())
  userId     String
  module     String
  operations Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@index([userId])
  @@index([module])
}

model ModuleOperation {
  id          String   @id @default(cuid())
  module      String
  operation   String
  label       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([module, operation])
  @@index([module])
  @@index([isActive])
}

model CashBankAccount {
  id               String              @id @default(cuid())
  chartOfAccountId String              @unique
  type             CashBankAccountType
  status           String              @default("active")
  createdBy        String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime
  ChartOfAccount   ChartOfAccount      @relation(fields: [chartOfAccountId], references: [id], onDelete: Cascade)
  User             User                @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([chartOfAccountId])
  @@index([createdBy])
  @@index([status])
  @@index([type])
}

model ChartOfAccount {
  id                                                       String             @id @default(cuid())
  code                                                     String             @unique
  name                                                     String
  type                                                     AccountType
  parentId                                                 String?
  description                                              String?
  status                                                   String             @default("active")
  createdBy                                                String
  createdAt                                                DateTime           @default(now())
  updatedAt                                                DateTime           @updatedAt
  isControl                                                Boolean            @default(false)
  CashBankAccount                                          CashBankAccount?
  User                                                     User               @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  ChartOfAccount                                           ChartOfAccount?    @relation("ChartOfAccountToChartOfAccount", fields: [parentId], references: [id])
  other_ChartOfAccount                                     ChartOfAccount[]   @relation("ChartOfAccountToChartOfAccount")
  Client                                                   Client[]
  Employee_Employee_advanceAccountIdToChartOfAccount       Employee[]         @relation("Employee_advanceAccountIdToChartOfAccount")
  Employee_Employee_salaryPayableAccountIdToChartOfAccount Employee[]         @relation("Employee_salaryPayableAccountIdToChartOfAccount")
  JournalEntryLine                                         JournalEntryLine[]
  Supplier                                                 Supplier[]
  VoucherLine                                              VoucherLine[]

  @@index([code])
  @@index([createdBy])
  @@index([parentId])
  @@index([status])
  @@index([type])
}

model JournalEntry {
  id               String             @id @default(cuid())
  entryNumber      String             @unique
  date             DateTime           @default(now())
  voucherId        String
  description      String?
  status           String             @default("posted")
  createdBy        String
  postedBy         String
  postedAt         DateTime
  createdAt        DateTime           @default(now())
  Voucher          Voucher            @relation(fields: [voucherId], references: [id])
  JournalEntryLine JournalEntryLine[]

  @@index([date])
  @@index([entryNumber])
  @@index([status])
  @@index([voucherId])
}

model JournalEntryLine {
  id               String         @id @default(cuid())
  lineNumber       Int
  debitAmount      Decimal        @default(0) @db.Decimal(12, 2)
  creditAmount     Decimal        @default(0) @db.Decimal(12, 2)
  description      String?
  journalEntryId   String
  chartOfAccountId String
  createdAt        DateTime       @default(now())
  clientId         String?
  supplierId       String?
  userId           String?
  organizationId   String?
  ChartOfAccount   ChartOfAccount @relation(fields: [chartOfAccountId], references: [id])
  Client           Client?        @relation(fields: [clientId], references: [id])
  JournalEntry     JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  Organization     Organization?  @relation(fields: [organizationId], references: [id])
  Supplier         Supplier?      @relation(fields: [supplierId], references: [id])
  User             User?          @relation(fields: [userId], references: [id])

  @@index([chartOfAccountId])
  @@index([clientId])
  @@index([journalEntryId])
  @@index([organizationId])
  @@index([supplierId])
  @@index([userId])
}

model Voucher {
  id                            String               @id @default(cuid())
  voucherNumber                 String               @unique
  date                          DateTime             @default(now())
  type                          VoucherType
  reference                     String?
  description                   String?
  status                        String               @default("draft")
  createdBy                     String
  postedById                    String?
  postedAt                      DateTime?
  createdAt                     DateTime             @default(now())
  updatedAt                     DateTime             @updatedAt
  clientId                      String?
  supplierId                    String?
  userId                        String?
  organizationId                String?
  isLocked                      Boolean              @default(false)
  employeeLoans                 EmployeeLoan[]
  inventoryAdjustment           InventoryAdjustment?
  JournalEntry                  JournalEntry[]
  payrollPayment                Payroll?             @relation("PayrollPaymentVoucher")
  payrollAccrual                Payroll?             @relation("PayrollVoucher")
  productionOrders              ProductionOrder[]
  purchases                     Purchase[]
  sales                         Sale[]
  Client                        Client?              @relation(fields: [clientId], references: [id])
  User_Voucher_createdByToUser  User                 @relation("Voucher_createdByToUser", fields: [createdBy], references: [id], onDelete: Cascade)
  Organization                  Organization?        @relation(fields: [organizationId], references: [id])
  User_Voucher_postedByIdToUser User?                @relation("Voucher_postedByIdToUser", fields: [postedById], references: [id])
  Supplier                      Supplier?            @relation(fields: [supplierId], references: [id])
  User_Voucher_userIdToUser     User?                @relation("Voucher_userIdToUser", fields: [userId], references: [id])
  VoucherLine                   VoucherLine[]

  @@index([clientId])
  @@index([createdBy])
  @@index([date])
  @@index([organizationId])
  @@index([postedById])
  @@index([status])
  @@index([supplierId])
  @@index([type])
  @@index([userId])
  @@index([voucherNumber])
}

model VoucherLine {
  id               String         @id @default(cuid())
  lineNumber       Int
  debitAmount      Decimal        @default(0) @db.Decimal(12, 2)
  creditAmount     Decimal        @default(0) @db.Decimal(12, 2)
  description      String?
  voucherId        String
  chartOfAccountId String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  clientId         String?
  supplierId       String?
  userId           String?
  organizationId   String?
  ChartOfAccount   ChartOfAccount @relation(fields: [chartOfAccountId], references: [id])
  Client           Client?        @relation(fields: [clientId], references: [id])
  Organization     Organization?  @relation(fields: [organizationId], references: [id])
  Supplier         Supplier?      @relation(fields: [supplierId], references: [id])
  User             User?          @relation(fields: [userId], references: [id])
  Voucher          Voucher        @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([chartOfAccountId])
  @@index([clientId])
  @@index([organizationId])
  @@index([supplierId])
  @@index([userId])
  @@index([voucherId])
}

model AccountingPeriod {
  id        String    @id @default(cuid())
  name      String    @unique
  startDate DateTime
  endDate   DateTime
  isLocked  Boolean   @default(false)
  lockedAt  DateTime?
  lockedBy  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([startDate, endDate])
  @@index([isLocked])
}

model InventoryAdjustment {
  id               String                    @id @default(cuid())
  adjustmentNumber String                    @unique
  warehouseId      String
  date             DateTime                  @default(now())
  status           InventoryAdjustmentStatus @default(DRAFT)
  notes            String?
  voucherId        String?                   @unique
  createdBy        String
  updatedBy        String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  createdByUser    User                      @relation("InventoryAdjustment_createdBy", fields: [createdBy], references: [id])
  updatedByUser    User?                     @relation("InventoryAdjustment_updatedBy", fields: [updatedBy], references: [id])
  voucher          Voucher?                  @relation(fields: [voucherId], references: [id])
  warehouse        Warehouse                 @relation(fields: [warehouseId], references: [id])
  items            InventoryAdjustmentItem[]

  @@index([warehouseId])
  @@index([voucherId])
  @@index([createdBy])
  @@index([date])
  @@index([status])
}

model InventoryAdjustmentItem {
  id                    String              @id @default(cuid())
  inventoryAdjustmentId String
  itemId                String
  quantity              Decimal             @db.Decimal(12, 2)
  unitRate              Decimal             @default(0) @db.Decimal(12, 2)
  amount                Decimal             @default(0) @db.Decimal(12, 2)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  inventoryAdjustment   InventoryAdjustment @relation(fields: [inventoryAdjustmentId], references: [id], onDelete: Cascade)
  item                  Item                @relation(fields: [itemId], references: [id])

  @@index([inventoryAdjustmentId])
  @@index([itemId])
}

model Shift {
  id           String       @id @default(cuid())
  name         String
  startTime    String
  endTime      String
  graceMinutes Int          @default(0)
  lateAfter    Int          @default(15)
  halfDayAfter Int          @default(120)
  otStartAfter Int          @default(30)
  status       String       @default("active")
  isTrash      Boolean      @default(false)
  createdBy    String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  attendances  Attendance[]
  employees    Employee[]   @relation("EmployeeShift")
  creator      User         @relation("ShiftCreator", fields: [createdBy], references: [id])

  @@index([status])
  @@index([isTrash])
  @@index([createdBy])
}

model Holiday {
  id          String     @id @default(cuid())
  name        String
  date        DateTime   @db.Date
  warehouseId String?
  status      String     @default("active")
  isTrash     Boolean    @default(false)
  createdBy   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  creator     User       @relation("HolidayCreator", fields: [createdBy], references: [id])
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([date])
  @@index([warehouseId])
  @@index([createdBy])
}

model LeaveType {
  id           String             @id @default(cuid())
  name         String
  category     LeaveCategory
  defaultDays  Int                @default(0)
  isPaid       Boolean            @default(true)
  status       String             @default("active")
  isTrash      Boolean            @default(false)
  createdBy    String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  applications LeaveApplication[]
  creator      User               @relation("LeaveTypeCreator", fields: [createdBy], references: [id])
}

model LeaveApplication {
  id          String       @id @default(cuid())
  employeeId  String
  leaveTypeId String
  startDate   DateTime     @db.Date
  endDate     DateTime     @db.Date
  totalDays   Int
  reason      String?
  status      LeaveStatus  @default(PENDING)
  managerId   String?
  hrId        String?
  isTrash     Boolean      @default(false)
  createdBy   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attendances Attendance[]
  creator     User         @relation("LeaveAppCreator", fields: [createdBy], references: [id])
  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  hr          User?        @relation("LeaveHR", fields: [hrId], references: [id])
  leaveType   LeaveType    @relation(fields: [leaveTypeId], references: [id])
  manager     User?        @relation("LeaveManager", fields: [managerId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([managerId])
  @@index([hrId])
}

model AttendanceLog {
  id         String           @id @default(cuid())
  employeeId String
  timestamp  DateTime
  source     AttendanceSource
  deviceId   String?
  createdAt  DateTime         @default(now())
  device     BiometricDevice? @relation(fields: [deviceId], references: [id])
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, timestamp])
  @@index([employeeId])
  @@index([timestamp])
}

model Attendance {
  id                 String            @id @default(cuid())
  employeeId         String
  date               DateTime          @db.Date
  shiftId            String?
  checkIn            DateTime?
  checkOut           DateTime?
  workHours          Decimal           @default(0) @db.Decimal(5, 2)
  otHours            Decimal           @default(0) @db.Decimal(5, 2)
  status             AttendanceStatus
  isManual           Boolean           @default(false)
  notes              String?
  isLocked           Boolean           @default(false)
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  leaveApplicationId String?
  creator            User?             @relation("AttendanceCreator", fields: [createdBy], references: [id])
  employee           Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveApplication   LeaveApplication? @relation(fields: [leaveApplicationId], references: [id])
  shift              Shift?            @relation(fields: [shiftId], references: [id])
  updater            User?             @relation("AttendanceUpdater", fields: [updatedBy], references: [id])

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
  @@index([employeeId, date])
  @@index([isLocked])
}

model Overtime {
  id          String   @id @default(cuid())
  employeeId  String
  date        DateTime @db.Date
  hours       Decimal  @db.Decimal(5, 2)
  ratePerHour Decimal  @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(12, 2)
  status      String   @default("approved")
  isLocked    Boolean  @default(false)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  creator     User     @relation("OvertimeCreator", fields: [createdBy], references: [id])
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([date])
  @@index([status])
}

model EmployeeLoan {
  id                 String     @id @default(cuid())
  employeeId         String
  amount             Decimal    @db.Decimal(12, 2)
  monthlyInstallment Decimal    @db.Decimal(12, 2)
  remainingBalance   Decimal    @db.Decimal(12, 2)
  issueDate          DateTime   @db.Date
  status             LoanStatus @default(PENDING)
  voucherId          String?
  approvedBy         String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  approver           User?      @relation("LoanApprover", fields: [approvedBy], references: [id])
  employee           Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  voucher            Voucher?   @relation(fields: [voucherId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([status])
  @@index([voucherId])
}

model EmployeeSalary {
  id            String   @id @default(cuid())
  employeeId    String   @unique
  basic         Decimal  @default(0) @db.Decimal(12, 2)
  houseRent     Decimal  @default(0) @db.Decimal(12, 2)
  medical       Decimal  @default(0) @db.Decimal(12, 2)
  transport     Decimal  @default(0) @db.Decimal(12, 2)
  foodAllowance Decimal  @default(0) @db.Decimal(12, 2)
  taxPercentage Decimal  @default(0) @db.Decimal(5, 2)
  pfPercentage  Decimal  @default(0) @db.Decimal(5, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Payroll {
  id             String        @id @default(cuid())
  payrollNumber  String        @unique
  month          Int
  year           Int
  dateGenerated  DateTime      @default(now())
  status         PayrollStatus @default(DRAFT)
  totalAmount    Decimal       @default(0) @db.Decimal(12, 2)
  voucherId      String?       @unique
  paymentVchId   String?       @unique
  notes          String?
  isTrash        Boolean       @default(false)
  createdBy      String
  approvedBy     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  approver       User?         @relation("PayrollApprover", fields: [approvedBy], references: [id])
  creator        User          @relation("PayrollCreator", fields: [createdBy], references: [id])
  paymentVoucher Voucher?      @relation("PayrollPaymentVoucher", fields: [paymentVchId], references: [id], onDelete: Restrict)
  voucher        Voucher?      @relation("PayrollVoucher", fields: [voucherId], references: [id], onDelete: Restrict)
  items          PayrollItem[]

  @@index([month, year])
  @@index([status])
  @@index([voucherId])
  @@index([month, year, status])
}

model PayrollItem {
  id              String   @id @default(cuid())
  payrollId       String
  employeeId      String
  basic           Decimal  @default(0) @db.Decimal(12, 2)
  houseRent       Decimal  @default(0) @db.Decimal(12, 2)
  medical         Decimal  @default(0) @db.Decimal(12, 2)
  transport       Decimal  @default(0) @db.Decimal(12, 2)
  foodAllowance   Decimal  @default(0) @db.Decimal(12, 2)
  otAmount        Decimal  @default(0) @db.Decimal(12, 2)
  bonus           Decimal  @default(0) @db.Decimal(12, 2)
  grossPay        Decimal  @default(0) @db.Decimal(12, 2)
  absentDeduction Decimal  @default(0) @db.Decimal(12, 2)
  loanDeduction   Decimal  @default(0) @db.Decimal(12, 2)
  taxDeduction    Decimal  @default(0) @db.Decimal(12, 2)
  pfDeduction     Decimal  @default(0) @db.Decimal(12, 2)
  totalDeduction  Decimal  @default(0) @db.Decimal(12, 2)
  netPay          Decimal  @default(0) @db.Decimal(12, 2)
  status          String   @default("unpaid")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  employee        Employee @relation(fields: [employeeId], references: [id])
  payroll         Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@unique([payrollId, employeeId])
  @@index([employeeId])
  @@index([status])
  @@index([employeeId, status])
}

model BiometricSyncLog {
  id           String           @id @default(cuid())
  syncTime     DateTime         @default(now())
  vendor       String
  deviceId     String?
  recordsCount Int              @default(0)
  status       String           @default("SUCCESS")
  errorMessage String?
  syncedBy     String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  device       BiometricDevice? @relation(fields: [deviceId], references: [id])
  user         User             @relation(fields: [syncedBy], references: [id])

  @@index([syncTime])
  @@index([vendor])
}

model BiometricDevice {
  id             String             @id @default(cuid())
  name           String
  vendor         String
  connectionType String             @default("IP")
  ipAddress      String?
  port           Int?               @default(4370)
  apiKey         String?
  serialNumber   String?            @unique
  location       String?
  status         String             @default("active")
  lastSyncAt     DateTime?
  createdBy      String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  attendanceLogs AttendanceLog[]
  syncLogs       BiometricSyncLog[]

  @@index([vendor])
  @@index([status])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum VoucherType {
  PAYMENT
  RECEIPT
  JOURNAL
  CONTRA
  SALES
  PURCHASE
}

enum CashBankAccountType {
  CASH
  BANK
}

enum PurchaseStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ProductionOrderStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum ItemType {
  RAW_MATERIAL
  READY_PRODUCT
  RETAIL
}

enum StockTransactionType {
  IN
  OUT
  ADJUSTMENT
  PRODUCTION
}

enum EmploymentType {
  PERMANENT
  TEMPORARY
  CONTRACT
  INTERN
  DAILY_WORKER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  LATE
  HALF_DAY
  HOLIDAY
  WEEKEND
}

enum LeaveCategory {
  CASUAL
  SICK
  ANNUAL
  MATERNITY
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  MANAGER_APPROVED
  HR_APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  REVIEWED
  APPROVED
  POSTED
  PAID
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  CLOSED
}

enum AttendanceSource {
  MANUAL
  WEB
  MOBILE
  BIOMETRIC
  API
}

enum NotificationType {
  SYSTEM
  ADMIN
  INFO
  WARNING
  ERROR
  SUCCESS
}

enum InventoryAdjustmentStatus {
  DRAFT
  COMPLETED
  CANCELLED
}
