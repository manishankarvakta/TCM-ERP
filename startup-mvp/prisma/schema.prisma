model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("todo")
  priority    String    @default("medium")
  startDate   DateTime?
  dueDate     DateTime?
  estimatedHours Float? // [NEW] For Performance Engine Estimation Accuracy

  // Polymorphic Relations
  entityType String? // e.g., "lead", "opportunity", "project"
  entityId   String? // UUID of the related entity

  userId        String
  assigneeId    String?
  contactId     String?
  opportunityId String?
  leadId        String?
  projectId     String?
  milestoneId   String?
  issueId       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  Opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  Issue         Issue?       @relation(fields: [issueId], references: [id])
  Milestone     Milestone?   @relation(fields: [milestoneId], references: [id])
  Project       Project?     @relation(fields: [projectId], references: [id])
  User          User         @relation("TaskOwner", fields: [userId], references: [id], onDelete: Cascade)
  Assignee      User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  Lead          Lead?        @relation(fields: [leadId], references: [id])
  Contact       Contact?     @relation(fields: [contactId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([contactId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([projectId])
  @@index([projectId, status])
  @@index([projectId, priority])
  @@index([milestoneId])
  @@index([issueId])
  // Timeline optimization index
  @@index([entityType, entityId, createdAt(sort: Desc)], map: "idx_task_entity_created")

  // Enterprise Extensions
  parentId       String?
  ParentTask     Task?             @relation("TaskHierarchy", fields: [parentId], references: [id])
  Subtasks       Task[]            @relation("TaskHierarchy")
  
  isRecurring    Boolean           @default(false)
  recurrenceRule String?
  
  Watchers       TaskWatcher[]
  BlockedBy      TaskDependency[]  @relation("DependentTasks")
  Blocking       TaskDependency[]  @relation("BlockingTasks")
  
  Timesheets     Timesheet[]

  tags           Tag[]
  Checklists     Checklist[]

  @@index([parentId])
}

model TaskDependency {
  id               String   @id @default(cuid())
  blockingTaskId   String
  dependentTaskId  String
  BlockingTask     Task     @relation("BlockingTasks", fields: [blockingTaskId], references: [id], onDelete: Cascade)
  DependentTask    Task     @relation("DependentTasks", fields: [dependentTaskId], references: [id], onDelete: Cascade)
  
  createdAt        DateTime @default(now())
  
  @@unique([blockingTaskId, dependentTaskId])
  @@index([dependentTaskId])
}

model TaskWatcher {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  Task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([taskId, userId])
}

model Note {
