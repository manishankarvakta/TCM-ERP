generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                               String                 @id @default(cuid())
  name                             String?
  email                            String                 @unique
  emailVerified                    DateTime?
  password                         String
  image                            String?
  role                             String                 @default("user")
  status                           String                 @default("active")
  designationTemplateId            String?
  permissions                      Json?
  inchargeId                       String?
  createdAt                        DateTime               @default(now())
  updatedAt                        DateTime               @updatedAt
  accounts                         Account[]
  CashBankAccount                  CashBankAccount[]
  ChartOfAccount                   ChartOfAccount[]
  createdClients                   Client[]               @relation("ClientCreator")
  createdCoverLetters              CoverLetter[]          @relation("CoverLetterCreator")
  Delivery                         Delivery[]
  createdDeliveries                DeliveryLedger[]       @relation("DeliveryCreator")
  Employee                         Employee?              @relation("UserEmployee")
  files                            File[]
  createdInventoryTransactions     InventoryTransaction[] @relation("InvTxCreator")
  JournalEntryLine                 JournalEntryLine[]
  createdModuleGroups              ModuleGroup[]          @relation("ModuleGroupCreator")
  createdNotifications             Notification[]         @relation("NotificationCreator")
  notifications                    Notification[]
  createdOrganizations             Organization[]         @relation("OrganizationCreator")
  createdPurchases                 Purchase[]             @relation("PurchaseCreatedBy")
  updatedPurchases                 Purchase[]             @relation("PurchaseUpdatedBy")
  quotations                       Quotation[]            @relation("SubmittedBy")
  updatedQuotations                Quotation[]            @relation("UpdatedBy")
  sections                         Section[]              @relation("PreparedBy")
  sessions                         Session[]
  createdSuppliers                 Supplier[]             @relation("SupplierCreator")
  createdUnits                     Unit[]                 @relation("UnitCreator")
  designationTemplate              PermissionTemplate?    @relation("UserDesignationTemplate", fields: [designationTemplateId], references: [id])
  incharge                         User?                  @relation("UserIncharge", fields: [inchargeId], references: [id])
  inchargeOf                       User[]                 @relation("UserIncharge")
  userLogs                         UserLog[]
  userPermissions                  UserPermission[]
  Voucher_Voucher_createdByToUser  Voucher[]              @relation("Voucher_createdByToUser")
  Voucher_Voucher_postedByIdToUser Voucher[]              @relation("Voucher_postedByIdToUser")
  Voucher_Voucher_userIdToUser     Voucher[]              @relation("Voucher_userIdToUser")
  VoucherLine                      VoucherLine[]
  createdWorkOrders                WorkOrder[]            @relation("WorkOrderCreator")
  createdSettings                  Settings[]             @relation("SettingsCreator")
  settings                         Settings[]             @relation("SettingsUser")

  @@index([status])
  @@index([designationTemplateId])
  @@index([inchargeId])
}

model Employee {
  id                     String          @id @default(cuid())
  name                   String
  employeeCode           String?         @unique
  userId                 String?         @unique
  status                 String          @default("active")
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  salaryPayableAccountId String?
  advanceAccountId       String?
  email                  String?
  phone                  String?
  advanceAccount         ChartOfAccount? @relation("Employee_advanceAccountIdToChartOfAccount", fields: [advanceAccountId], references: [id])
  salaryPayableAccount   ChartOfAccount? @relation("Employee_salaryPayableAccountIdToChartOfAccount", fields: [salaryPayableAccountId], references: [id])
  user                   User?           @relation("UserEmployee", fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([employeeCode])
  @@index([email])
  @@index([salaryPayableAccountId])
  @@index([advanceAccountId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  code      String
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([code])
  @@index([expires])
}

model UserLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model File {
  id         String   @id @default(cuid())
  ownerId    String
  name       String
  path       String
  storageKey String   @unique
  size       Int
  mimeType   String
  isFolder   Boolean  @default(false)
  etag       String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([storageKey])
  @@index([path])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType
  userId    String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  readAt    DateTime?
  createdBy String?
  creator   User?            @relation("NotificationCreator", fields: [createdBy], references: [id])
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
  @@index([createdBy])
}

model Unit {
  id        String   @id @default(cuid())
  details   String
  symbol    String   @unique
  status    String   @default("active")
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     Item[]   @relation("unit")
  creator   User     @relation("UnitCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdBy])
}

model Organization {
  id               String             @id @default(cuid())
  name             String
  details          String?
  address          String?
  phone            String?
  email            String?
  website          String?
  logo             String?
  status           String             @default("active")
  createdBy        String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  JournalEntryLine JournalEntryLine[]
  creator          User               @relation("OrganizationCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  quotations       Quotation[]
  Voucher          Voucher[]
  VoucherLine      VoucherLine[]

  @@index([status])
  @@index([createdBy])
  @@index([name])
}

model Category {
  id             String          @id @default(cuid())
  name           String
  description    String?
  status         String          @default("active")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  categoryGroups CategoryGroup[]
  items          ItemCategory[]

  @@index([name])
  @@index([status])
}

model Item {
  id                    String                 @id @default(cuid())
  code                  String                 @unique
  description           String
  unitId                String
  unitPrice             Decimal                @db.Decimal(10, 2)
  costPrice             Decimal                @default(0) @db.Decimal(10, 2)
  image                 String?
  status                String                 @default("active")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  minStock              Decimal                @default(0) @db.Decimal(10, 2)
  quantity              Decimal                @default(0) @db.Decimal(10, 2)
  inventoryTransactions InventoryTransaction[]
  unit                  Unit                   @relation("unit", fields: [unitId], references: [id])
  categories            ItemCategory[]
  purchaseItems         PurchaseItem[]
  quotationItems        QuotationItem[]

  @@index([code])
  @@index([unitId])
  @@index([status])
}

model ModuleGroup {
  id            String            @id @default(cuid())
  code          String?
  description   String?
  sortOrder     Int               @default(0)
  status        String            @default("active")
  createdBy     String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  costPrice     Decimal           @default(0) @db.Decimal(10, 2)
  baseUnit      String?
  baseUnitPrice Decimal?          @db.Decimal(10, 2)
  creator       User              @relation("ModuleGroupCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  items         ModuleGroupItem[]

  @@index([status])
  @@index([createdBy])
}

model ModuleGroupItem {
  id             String          @id @default(cuid())
  sl             Int
  code           String?
  description    String?
  height         Decimal?        @db.Decimal(10, 2)
  width          Decimal?        @db.Decimal(10, 2)
  depth          Decimal?        @db.Decimal(10, 2)
  unit           String?
  unitPrice      Decimal         @db.Decimal(10, 2)
  amount         Decimal         @db.Decimal(12, 2)
  sortOrder      Int             @default(0)
  quantity       Decimal?        @db.Decimal(10, 2)
  moduleGroupId  String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  moduleGroup    ModuleGroup     @relation(fields: [moduleGroupId], references: [id], onDelete: Cascade)
  quotationItems QuotationItem[]

  @@index([moduleGroupId])
}

model ItemCategory {
  id         String   @id @default(cuid())
  itemId     String
  categoryId String
  createdAt  DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, categoryId])
  @@index([itemId])
  @@index([categoryId])
}

model Client {
  id               String             @id @default(cuid())
  name             String?
  email            String             @unique
  phone            String?
  address          String?
  city             String?
  state            String?
  zip              String?
  country          String?
  company          String?
  image            String?
  createdBy        String
  status           String             @default("active")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  chartOfAccountId String?
  clientCode       String?            @unique
  ChartOfAccount   ChartOfAccount?    @relation(fields: [chartOfAccountId], references: [id])
  createdByUser    User               @relation("ClientCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  JournalEntryLine JournalEntryLine[]
  orders           Order[]
  Quotation        Quotation[]
  Voucher          Voucher[]
  VoucherLine      VoucherLine[]

  @@index([status])
  @@index([createdBy])
  @@index([email])
  @@index([chartOfAccountId])
  @@index([clientCode])
}

model Supplier {
  id               String             @id @default(cuid())
  name             String?
  email            String             @unique
  phone            String?
  address          String?
  city             String?
  state            String?
  zip              String?
  country          String?
  company          String?
  image            String?
  createdBy        String
  status           String             @default("active")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  chartOfAccountId String?
  supplierCode     String?            @unique
  JournalEntryLine JournalEntryLine[]
  Purchase         Purchase[]
  ChartOfAccount   ChartOfAccount?    @relation(fields: [chartOfAccountId], references: [id])
  createdByUser    User               @relation("SupplierCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  Voucher          Voucher[]
  VoucherLine      VoucherLine[]

  @@index([status])
  @@index([createdBy])
  @@index([email])
  @@index([chartOfAccountId])
  @@index([supplierCode])
}

model Quotation {
  id                 String          @id @default(cuid())
  quotationNumber    String          @unique
  subject            String
  date               DateTime        @default(now())
  coverLetter        String?
  financialStatement String?
  tos                String?
  total              Decimal?        @db.Decimal(12, 2)
  discount           Decimal?        @db.Decimal(5, 2)
  grandTotal         Decimal?        @db.Decimal(12, 2)
  status             QuotationStatus @default(DRAFT)
  clientId           String
  organizationId     String?
  submittedById      String
  updatedById        String?
  shippingCharges    Decimal?        @db.Decimal(10, 2)
  vatIncluded        Boolean?        @default(false)
  projectLocation    String?
  isTrash            Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  expiredDate        DateTime?
  order              Order?
  client             Client          @relation(fields: [clientId], references: [id])
  organization       Organization?   @relation(fields: [organizationId], references: [id])
  submittedBy        User            @relation("SubmittedBy", fields: [submittedById], references: [id])
  updatedBy          User?           @relation("UpdatedBy", fields: [updatedById], references: [id])
  section            Section[]
  workOrders         WorkOrder[]

  @@index([clientId])
  @@index([organizationId])
  @@index([submittedById])
  @@index([updatedById])
  @@index([status])
  @@index([isTrash])
}

model Purchase {
  id             String         @id @default(cuid())
  purchaseNumber String         @unique
  supplierId     String
  date           DateTime       @default(now())
  status         PurchaseStatus @default(DRAFT)
  notes          String?
  attachmentUrl  String?
  subTotal       Decimal        @db.Decimal(12, 2)
  discount       Decimal?       @db.Decimal(5, 2)
  tax            Decimal?       @db.Decimal(5, 2)
  grandTotal     Decimal        @db.Decimal(12, 2)
  isTrash        Boolean        @default(false)
  createdBy      String
  updatedBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdByUser  User           @relation("PurchaseCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  updatedByUser  User?          @relation("PurchaseUpdatedBy", fields: [updatedBy], references: [id])
  items          PurchaseItem[]

  @@index([supplierId])
  @@index([status])
  @@index([date])
  @@index([isTrash])
  @@index([purchaseNumber])
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  itemId      String?
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  item        Item?    @relation(fields: [itemId], references: [id])
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([itemId])
}

model WorkOrder {
  id          String          @id @default(cuid())
  code        String          @unique
  quotationId String
  createdById String
  amount      Decimal         @db.Decimal(12, 2)
  advance     Decimal?        @db.Decimal(12, 2)
  balance     Decimal         @db.Decimal(12, 2)
  status      WorkOrderStatus @default(PROGRESS)
  isTrash     Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdBy   User            @relation("WorkOrderCreator", fields: [createdById], references: [id])
  quotation   Quotation       @relation(fields: [quotationId], references: [id])

  @@index([quotationId])
  @@index([createdById])
  @@index([status])
}

model Section {
  id             String          @id @default(cuid())
  title          String
  note           String?
  discount       Decimal?        @db.Decimal(5, 2)
  total          Decimal?        @db.Decimal(12, 2)
  grandTotal     Decimal?        @db.Decimal(12, 2)
  sortOrder      Int             @default(0)
  categoryId     String?
  quotationId    String
  preparedById   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  categoryGroups CategoryGroup[]
  groups         ItemGroup[]
  items          QuotationItem[]
  preparedBy     User?           @relation("PreparedBy", fields: [preparedById], references: [id])
  quotation      Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model ItemGroup {
  id            String          @id @default(cuid())
  code          String?
  description   String
  quantity      Decimal?        @db.Decimal(10, 2)
  number        Int?
  sortOrder     Int             @default(0)
  moduleGroupId String?
  sectionId     String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  baseUnit      String?
  baseUnitPrice Decimal?        @db.Decimal(10, 2)
  section       Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  items         QuotationItem[]

  @@index([sectionId])
}

model CategoryGroup {
  id         String          @id @default(cuid())
  categoryId String?
  sortOrder  Int             @default(0)
  sectionId  String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  category   Category?       @relation(fields: [categoryId], references: [id])
  section    Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  items      QuotationItem[]

  @@index([sectionId])
  @@index([categoryId])
}

model QuotationItem {
  id                String           @id @default(cuid())
  sl                Int
  code              String?
  description       String?
  height            Decimal?         @db.Decimal(10, 2)
  width             Decimal?         @db.Decimal(10, 2)
  depth             Decimal?         @db.Decimal(10, 2)
  unit              String?
  unitPrice         Decimal          @db.Decimal(10, 2)
  quantity          Decimal          @db.Decimal(10, 2)
  unitShutter       Decimal?         @db.Decimal(10, 2)
  totalShutter      Decimal?         @db.Decimal(10, 2)
  amount            Decimal          @db.Decimal(12, 2)
  note              String?
  sortOrder         Int              @default(0)
  itemId            String?
  moduleGroupItemId String?
  sectionId         String?
  groupId           String?
  categoryGroupId   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  discount          Decimal?         @db.Decimal(10, 2)
  no                String?
  orderItems        OrderItem[]
  categoryGroup     CategoryGroup?   @relation(fields: [categoryGroupId], references: [id], onDelete: Cascade)
  group             ItemGroup?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  item              Item?            @relation(fields: [itemId], references: [id])
  moduleGroupItem   ModuleGroupItem? @relation(fields: [moduleGroupItemId], references: [id])
  section           Section?         @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([sectionId])
  @@index([groupId])
  @@index([categoryGroupId])
  @@index([moduleGroupItemId])
}

model CoverLetter {
  id        String   @id @default(cuid())
  title     String
  content   String
  status    String   @default("active")
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator   User     @relation("CoverLetterCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdBy])
  @@index([title])
}

model Settings {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  title        String   @db.VarChar(255)
  code         String   @db.VarChar(100)
  category     String   @db.VarChar(100)
  settings     Json
  isActive     Boolean  @default(true) @map("is_active")
  isDefault    Boolean  @default(false) @map("is_default")
  isGlobal     Boolean  @default(false) @map("is_global")
  displayOrder Int      @default(0) @map("display_order")
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  creator      User?    @relation("SettingsCreator", fields: [createdBy], references: [id])
  user         User?    @relation("SettingsUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
  @@index([category])
  @@index([userId, code])
  @@index([userId, category])
  @@index([isGlobal])
  @@index([settings(ops: JsonbPathOps)], type: Gin)
  @@map("settings")
}

model PermissionTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]   @relation("UserDesignationTemplate")

  @@index([isActive])
  @@index([name])
}

model UserPermission {
  id         String   @id @default(cuid())
  userId     String
  module     String
  operations Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@index([userId])
  @@index([module])
}

model ModuleOperation {
  id          String   @id @default(cuid())
  module      String
  operation   String
  label       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([module, operation])
  @@index([module])
  @@index([isActive])
}

model CashBankAccount {
  id               String              @id
  chartOfAccountId String              @unique
  type             CashBankAccountType
  status           String              @default("active")
  createdBy        String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime
  ChartOfAccount   ChartOfAccount      @relation(fields: [chartOfAccountId], references: [id], onDelete: Cascade)
  User             User                @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([chartOfAccountId])
  @@index([createdBy])
  @@index([status])
  @@index([type])
}

model ChartOfAccount {
  id                                                       String             @id
  code                                                     String             @unique
  name                                                     String
  type                                                     AccountType
  parentId                                                 String?
  description                                              String?
  status                                                   String             @default("active")
  createdBy                                                String
  createdAt                                                DateTime           @default(now())
  updatedAt                                                DateTime           @updatedAt
  isControl                                                Boolean            @default(false)
  CashBankAccount                                          CashBankAccount?
  User                                                     User               @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  ChartOfAccount                                           ChartOfAccount?    @relation("ChartOfAccountToChartOfAccount", fields: [parentId], references: [id])
  other_ChartOfAccount                                     ChartOfAccount[]   @relation("ChartOfAccountToChartOfAccount")
  Client                                                   Client[]
  Employee_Employee_advanceAccountIdToChartOfAccount       Employee[]         @relation("Employee_advanceAccountIdToChartOfAccount")
  Employee_Employee_salaryPayableAccountIdToChartOfAccount Employee[]         @relation("Employee_salaryPayableAccountIdToChartOfAccount")
  JournalEntryLine                                         JournalEntryLine[]
  Supplier                                                 Supplier[]
  VoucherLine                                              VoucherLine[]

  @@index([code])
  @@index([createdBy])
  @@index([parentId])
  @@index([status])
  @@index([type])
}

model JournalEntry {
  id               String             @id @default(cuid())
  entryNumber      String             @unique
  date             DateTime           @default(now())
  voucherId        String
  description      String?
  status           String             @default("posted")
  createdBy        String
  postedBy         String
  postedAt         DateTime
  createdAt        DateTime           @default(now())
  Voucher          Voucher            @relation(fields: [voucherId], references: [id])
  JournalEntryLine JournalEntryLine[]

  @@index([date])
  @@index([entryNumber])
  @@index([status])
  @@index([voucherId])
}

model JournalEntryLine {
  id               String         @id @default(cuid())
  lineNumber       Int
  debitAmount      Decimal        @default(0) @db.Decimal(12, 2)
  creditAmount     Decimal        @default(0) @db.Decimal(12, 2)
  description      String?
  journalEntryId   String
  chartOfAccountId String
  createdAt        DateTime       @default(now())
  clientId         String?
  supplierId       String?
  userId           String?
  organizationId   String?
  ChartOfAccount   ChartOfAccount @relation(fields: [chartOfAccountId], references: [id])
  Client           Client?        @relation(fields: [clientId], references: [id])
  JournalEntry     JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  Organization     Organization?  @relation(fields: [organizationId], references: [id])
  Supplier         Supplier?      @relation(fields: [supplierId], references: [id])
  User             User?          @relation(fields: [userId], references: [id])

  @@index([chartOfAccountId])
  @@index([clientId])
  @@index([journalEntryId])
  @@index([organizationId])
  @@index([supplierId])
  @@index([userId])
}

model Voucher {
  id                            String         @id @default(cuid())
  voucherNumber                 String         @unique
  date                          DateTime       @default(now())
  type                          VoucherType
  reference                     String?
  description                   String?
  status                        String         @default("draft")
  createdBy                     String
  postedById                    String?
  postedAt                      DateTime?
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt
  clientId                      String?
  supplierId                    String?
  userId                        String?
  organizationId                String?
  orderId                       String?
  invoiceId                     String?
  RevenueInvoice                Invoice?       @relation("RevenueVoucher")
  JournalEntry                  JournalEntry[]
  Client                        Client?        @relation(fields: [clientId], references: [id])
  User_Voucher_createdByToUser  User           @relation("Voucher_createdByToUser", fields: [createdBy], references: [id], onDelete: Cascade)
  Invoice                       Invoice?       @relation("InvoiceVouchers", fields: [invoiceId], references: [id])
  Order                         Order?         @relation(fields: [orderId], references: [id])
  Organization                  Organization?  @relation(fields: [organizationId], references: [id])
  User_Voucher_postedByIdToUser User?          @relation("Voucher_postedByIdToUser", fields: [postedById], references: [id])
  Supplier                      Supplier?      @relation(fields: [supplierId], references: [id])
  User_Voucher_userIdToUser     User?          @relation("Voucher_userIdToUser", fields: [userId], references: [id])
  VoucherLine                   VoucherLine[]

  @@index([clientId])
  @@index([createdBy])
  @@index([date])
  @@index([organizationId])
  @@index([postedById])
  @@index([status])
  @@index([supplierId])
  @@index([type])
  @@index([userId])
  @@index([voucherNumber])
}

model InventoryTransaction {
  id        String                   @id @default(cuid())
  itemId    String
  quantity  Decimal                  @db.Decimal(10, 2)
  type      InventoryTransactionType
  reference String?
  note      String?
  createdAt DateTime                 @default(now())
  createdBy String
  creator   User                     @relation("InvTxCreator", fields: [createdBy], references: [id])
  item      Item                     @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([createdAt])
  @@index([type])
}

model VoucherLine {
  id               String         @id @default(cuid())
  lineNumber       Int
  debitAmount      Decimal        @default(0) @db.Decimal(12, 2)
  creditAmount     Decimal        @default(0) @db.Decimal(12, 2)
  description      String?
  voucherId        String
  chartOfAccountId String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  clientId         String?
  supplierId       String?
  userId           String?
  organizationId   String?
  ChartOfAccount   ChartOfAccount @relation(fields: [chartOfAccountId], references: [id])
  Client           Client?        @relation(fields: [clientId], references: [id])
  Organization     Organization?  @relation(fields: [organizationId], references: [id])
  Supplier         Supplier?      @relation(fields: [supplierId], references: [id])
  User             User?          @relation(fields: [userId], references: [id])
  Voucher          Voucher        @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([chartOfAccountId])
  @@index([clientId])
  @@index([organizationId])
  @@index([supplierId])
  @@index([userId])
  @@index([voucherId])
}

model Order {
  id          String           @id @default(cuid())
  orderNumber String           @unique
  quotationId String           @unique
  clientId    String
  totalValue  Decimal          @db.Decimal(12, 2)
  status      OrderStatus      @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  Delivery    Delivery[]
  deliveries  DeliveryLedger[]
  invoices    Invoice[]
  client      Client           @relation(fields: [clientId], references: [id])
  quotation   Quotation        @relation(fields: [quotationId], references: [id])
  items       OrderItem[]
  vouchers    Voucher[]

  @@index([clientId])
  @@index([status])
  @@index([quotationId])
}

model OrderItem {
  id              String           @id @default(cuid())
  orderId         String
  quotationItemId String
  itemId          String?
  description     String
  quantity        Decimal          @db.Decimal(10, 2)
  unitPrice       Decimal          @db.Decimal(10, 2)
  amount          Decimal          @db.Decimal(12, 2)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deliveries      DeliveryLedger[]
  invoiceItems    InvoiceItem[]
  order           Order            @relation(fields: [orderId], references: [id])
  quotationItem   QuotationItem    @relation(fields: [quotationItemId], references: [id])

  @@index([orderId])
  @@index([quotationItemId])
}

model DeliveryLedger {
  id           String        @id @default(cuid())
  orderId      String
  orderItemId  String
  quantity     Decimal       @db.Decimal(10, 2)
  date         DateTime      @default(now())
  status       String        @default("posted")
  description  String?
  createdBy    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deliveryId   String?
  creator      User          @relation("DeliveryCreator", fields: [createdBy], references: [id])
  Delivery     Delivery?     @relation(fields: [deliveryId], references: [id])
  order        Order         @relation(fields: [orderId], references: [id])
  orderItem    OrderItem     @relation(fields: [orderItemId], references: [id])
  invoiceItems InvoiceItem[]

  @@index([orderId])
  @@index([orderItemId])
  @@index([date])
  @@index([status])
  @@index([deliveryId])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  date          DateTime      @default(now())
  orderId       String
  voucherId     String?       @unique
  status        String        @default("draft")
  totalAmount   Decimal       @db.Decimal(12, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  order         Order         @relation(fields: [orderId], references: [id])
  voucher       Voucher?      @relation("RevenueVoucher", fields: [voucherId], references: [id])
  items         InvoiceItem[]
  vouchers      Voucher[]     @relation("InvoiceVouchers")

  @@index([orderId])
  @@index([invoiceNumber])
  @@index([status])
}

model InvoiceItem {
  id               String          @id @default(cuid())
  invoiceId        String
  orderItemId      String
  deliveryLedgerId String?
  quantity         Decimal         @db.Decimal(10, 2)
  unitPrice        Decimal         @db.Decimal(10, 2)
  amount           Decimal         @db.Decimal(12, 2)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deliveryLedger   DeliveryLedger? @relation(fields: [deliveryLedgerId], references: [id])
  invoice          Invoice         @relation(fields: [invoiceId], references: [id])
  orderItem        OrderItem       @relation(fields: [orderItemId], references: [id])

  @@index([invoiceId])
  @@index([orderItemId])
}

model Delivery {
  id             String           @id
  deliveryNumber String           @unique
  date           DateTime         @default(now())
  description    String?
  status         String           @default("posted")
  orderId        String
  createdBy      String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  User           User             @relation(fields: [createdBy], references: [id])
  Order          Order            @relation(fields: [orderId], references: [id])
  DeliveryLedger DeliveryLedger[]

  @@index([deliveryNumber])
  @@index([orderId])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum VoucherType {
  PAYMENT
  RECEIPT
  JOURNAL
  CONTRA
  SALES
  PURCHASE
  ADJUSTMENT
}

enum CashBankAccountType {
  CASH
  BANK
}

enum PurchaseStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  INITIAL
}

enum QuotationStatus {
  DRAFT
  REVIEW
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  APPROVED
}

enum WorkOrderStatus {
  PROGRESS
  COMPLETE
  CANCELED
  HOLD
}

enum NotificationType {
  SYSTEM
  ADMIN
  INFO
  WARNING
  ERROR
  SUCCESS
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  COMPLETED
}
