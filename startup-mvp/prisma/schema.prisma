generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Activity {
  id          String  @id @default(cuid())
  type        String // Action type: TASK_CREATED, NOTE_CREATED, DOC_CREATED, etc.
  subject     String // Human-readable subject line
  description String? // Detailed description

  // Context (Timeline Owner - where activity appears)
  contextType String? // "lead", "opportunity", "contact", "project", "issue"
  contextId   String? // UUID of context entity

  // Subject (Affected Object - what changed)
  subjectType String? // "task", "note", "doc", "event", "lead", "opportunity"
  subjectId   String? // UUID of subject entity

  // Metadata for additional context
  metadata Json? // Old/new values, titles, etc.

  // Scheduling & Status (for activity-type records like calls, meetings)
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  status      String    @default("TODO")
  priority    String    @default("NORMAL")

  // Ownership
  ownerId      String? // Actor - who performed the action (Optional for system actions)
  assignedToId String? // Assignee (for activity-type records)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  Owner      User?  @relation("ActivityOwner", fields: [ownerId], references: [id])
  AssignedTo User?  @relation("ActivityAssignedTo", fields: [assignedToId], references: [id])
  File       File[]

  // Indexes for timeline queries
  @@index([contextType, contextId, createdAt(sort: Desc)], map: "idx_activity_context_timeline")
  @@index([subjectType, subjectId, createdAt(sort: Desc)], map: "idx_activity_subject_history")
  @@index([ownerId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([type])
  @@index([type, createdAt(sort: Desc)])
}

model CashBankAccount {
  id               String              @id @default(cuid())
  chartOfAccountId String              @unique
  type             CashBankAccountType
  status           String              @default("active")
  createdBy        String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  ChartOfAccount   ChartOfAccount      @relation(fields: [chartOfAccountId], references: [id], onDelete: Cascade)
  User             User                @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([chartOfAccountId])
  @@index([createdBy])
  @@index([status])
  @@index([type])
}

model Category {
  id            String          @id @default(cuid())
  name          String
  description   String?
  status        String          @default("active")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  CategoryGroup CategoryGroup[]
  ItemCategory  ItemCategory[]
  Lead          Lead[]

  @@index([name])
  @@index([status])
}

model CategoryGroup {
  id            String          @id @default(cuid())
  categoryId    String?
  sortOrder     Int             @default(0)
  sectionId     String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  Category      Category?       @relation(fields: [categoryId], references: [id])
  Section       Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  QuotationItem QuotationItem[]

  @@index([categoryId])
  @@index([sectionId])
}

model ChartOfAccount {
  id                                                       String             @id @default(cuid())
  code                                                     String             @unique
  name                                                     String
  type                                                     AccountType
  parentId                                                 String?
  description                                              String?
  status                                                   String             @default("active")
  createdBy                                                String
  createdAt                                                DateTime           @default(now())
  updatedAt                                                DateTime           @updatedAt
  isControl                                                Boolean            @default(false)
  CashBankAccount                                          CashBankAccount?
  User                                                     User               @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  ChartOfAccount                                           ChartOfAccount?    @relation("ChartOfAccountToChartOfAccount", fields: [parentId], references: [id])
  other_ChartOfAccount                                     ChartOfAccount[]   @relation("ChartOfAccountToChartOfAccount")
  Client                                                   Client[]
  Employee_Employee_advanceAccountIdToChartOfAccount       Employee[]         @relation("Employee_advanceAccountIdToChartOfAccount")
  Employee_Employee_salaryPayableAccountIdToChartOfAccount Employee[]         @relation("Employee_salaryPayableAccountIdToChartOfAccount")
  JournalEntryLine                                         JournalEntryLine[]
  Supplier                                                 Supplier[]
  VoucherLine                                              VoucherLine[]

  @@index([code])
  @@index([createdBy])
  @@index([parentId])
  @@index([status])
  @@index([type])
}

model Client {
  id               String             @id @default(cuid())
  name             String?
  email            String             @unique
  phone            String?
  address          String?
  city             String?
  state            String?
  zip              String?
  country          String?
  company          String?
  image            String?
  createdBy        String
  status           String             @default("active")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  chartOfAccountId String?
  clientCode       String?            @unique
  ChartOfAccount   ChartOfAccount?    @relation(fields: [chartOfAccountId], references: [id])
  User             User               @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  Contact          Contact[]
  JournalEntryLine JournalEntryLine[]
  Opportunity      Opportunity[]
  Order            Order[]
  Quotation        Quotation[]
  Voucher          Voucher[]
  VoucherLine      VoucherLine[]
  Project          Project[]

  @@index([chartOfAccountId])
  @@index([clientCode])
  @@index([createdBy])
  @@index([email])
  @@index([status])
}

model Contact {
  id          String        @id @default(cuid())
  firstName   String
  lastName    String
  email       String?       @unique
  phone       String?
  role        String?
  clientId    String
  isPrimary   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  Client      Client        @relation(fields: [clientId], references: [id])
  Opportunity Opportunity[]
  Note        Note[]
  Task        Task[]

  @@index([clientId])
  @@index([email])
}

model CoverLetter {
  id        String   @id @default(cuid())
  title     String
  subject   String? // Optional subject line for the cover letter
  content   String
  status    String   @default("active")
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdBy])
  @@index([status])
  @@index([title])
}

model QuotationTerms {
  id                String   @id @default(cuid())
  title             String
  content           String   @db.Text // TOS
  paymentTerms      String   @db.Text
  refundPolicy      String   @db.Text
  terminationPolicy String   @db.Text
  status            String   @default("active") // active, inactive, trash
  isDefault         Boolean  @default(false)
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  User              User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdBy])
  @@index([status])
  @@index([title])
}

model Delivery {
  id             String           @id @default(cuid())
  deliveryNumber String           @unique
  date           DateTime         @default(now())
  description    String?
  status         String           @default("posted")
  orderId        String
  createdBy      String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  User           User             @relation(fields: [createdBy], references: [id])
  Order          Order            @relation(fields: [orderId], references: [id])
  DeliveryLedger DeliveryLedger[]

  @@index([deliveryNumber])
  @@index([orderId])
}

model DeliveryLedger {
  id          String        @id @default(cuid())
  orderId     String
  orderItemId String
  quantity    Decimal       @db.Decimal(10, 2)
  date        DateTime      @default(now())
  status      String        @default("posted")
  description String?
  createdBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deliveryId  String?
  User        User          @relation(fields: [createdBy], references: [id])
  Delivery    Delivery?     @relation(fields: [deliveryId], references: [id])
  Order       Order         @relation(fields: [orderId], references: [id])
  OrderItem   OrderItem     @relation(fields: [orderItemId], references: [id])
  InvoiceItem InvoiceItem[]

  @@index([date])
  @@index([deliveryId])
  @@index([orderId])
  @@index([orderItemId])
  @@index([status])
}

model DeliverySchedule {
  id                   String                 @id @default(cuid())
  orderId              String
  scheduledDate        DateTime
  status               String                 @default("scheduled")
  description          String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  Order                Order                  @relation(fields: [orderId], references: [id])
  DeliveryScheduleItem DeliveryScheduleItem[]

  @@index([orderId])
}

model DeliveryScheduleItem {
  id               String           @id @default(cuid())
  scheduleId       String
  orderItemId      String
  description      String
  unitPrice        Decimal          @db.Decimal(10, 2)
  quantity         Decimal          @db.Decimal(10, 2)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  OrderItem        OrderItem        @relation(fields: [orderItemId], references: [id])
  DeliverySchedule DeliverySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
}

model Employee {
  id                                                             String             @id @default(cuid())
  name                                                           String
  employeeCode                                                   String?            @unique
  email                                                          String?
  phone                                                          String?
  userId                                                         String?            @unique
  status                                                         String             @default("active")
  createdAt                                                      DateTime           @default(now())
  updatedAt                                                      DateTime           @updatedAt
  salaryPayableAccountId                                         String?
  advanceAccountId                                               String?
  address                                                        Json?
  dateOfBirth                                                    DateTime?
  department                                                     String?
  designation                                                    String?
  emergencyContact                                               Json?
  gender                                                         String?
  joiningDate                                                    DateTime?
  nationalId                                                     String?
  photo                                                          String?
  salary                                                         Decimal?           @db.Decimal(12, 2)
  warehouseId                                                    String?
  employmentType                                                 EmploymentType?    @default(PERMANENT)
  utilizationTarget                                              Float?             @default(80.0)
  shiftId                                                        String?
  attendances                                                    Attendance[]
  attendanceLogs                                                 AttendanceLog[]
  advanceAccount                                                 ChartOfAccount?    @relation("Employee_advanceAccountIdToChartOfAccount", fields: [advanceAccountId], references: [id])
  salaryPayableAccount                                           ChartOfAccount?    @relation("Employee_salaryPayableAccountIdToChartOfAccount", fields: [salaryPayableAccountId], references: [id])
  shift                                                          Shift?             @relation("EmployeeShift", fields: [shiftId], references: [id])
  user                                                           User?              @relation("UserEmployee", fields: [userId], references: [id])
  warehouse                                                      Warehouse?         @relation("WarehouseEmployees", fields: [warehouseId], references: [id])
  loans                                                          EmployeeLoan[]
  salaryStructure                                                EmployeeSalary?
  leaveApps                                                      LeaveApplication[]
  overtimes                                                      Overtime[]
  payrollItems                                                   PayrollItem[]
  timesheets                                                     Timesheet[]

  @@index([userId])
  @@index([status])
  @@index([employeeCode])
  @@index([email])
  @@index([salaryPayableAccountId])
  @@index([advanceAccountId])
  @@index([warehouseId])
}

model File {
  id              String           @id @default(cuid())
  ownerId         String
  name            String
  path            String
  storageKey      String           @unique
  size            Int
  mimeType        String
  isFolder        Boolean          @default(false)
  etag            String?
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  activityId      String?
  Activity        Activity?        @relation(fields: [activityId], references: [id])
  User            User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  EntityFileLinks EntityFileLink[]

  @@index([createdAt])
  @@index([ownerId])
  @@index([path])
  @@index([storageKey])
  @@index([activityId])
}

model InventoryTransaction {
  id        String                   @id @default(cuid())
  itemId    String
  quantity  Decimal                  @db.Decimal(10, 2)
  type      InventoryTransactionType
  reference String?
  note      String?
  createdAt DateTime                 @default(now())
  createdBy String
  User      User                     @relation(fields: [createdBy], references: [id])
  Item      Item                     @relation(fields: [itemId], references: [id])

  @@index([createdAt])
  @@index([itemId])
  @@index([type])
}

model Invoice {
  id                                 String        @id @default(cuid())
  invoiceNumber                      String        @unique
  date                               DateTime      @default(now())
  orderId                            String
  voucherId                          String?       @unique
  status                             String        @default("draft")
  totalAmount                        Decimal       @db.Decimal(12, 2)
  createdAt                          DateTime      @default(now())
  updatedAt                          DateTime      @updatedAt
  Order                              Order         @relation(fields: [orderId], references: [id])
  Voucher_Invoice_voucherIdToVoucher Voucher?      @relation("Invoice_voucherIdToVoucher", fields: [voucherId], references: [id])
  InvoiceItem                        InvoiceItem[]
  Voucher_Voucher_invoiceIdToInvoice Voucher[]     @relation("Voucher_invoiceIdToInvoice")

  @@index([invoiceNumber])
  @@index([orderId])
  @@index([status])
}

model InvoiceItem {
  id               String          @id @default(cuid())
  invoiceId        String
  orderItemId      String
  deliveryLedgerId String?
  quantity         Decimal         @db.Decimal(10, 2)
  unitPrice        Decimal         @db.Decimal(10, 2)
  amount           Decimal         @db.Decimal(12, 2)
  projectId        String?
  Project          Project?        @relation(fields: [projectId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  DeliveryLedger   DeliveryLedger? @relation(fields: [deliveryLedgerId], references: [id])
  Invoice          Invoice         @relation(fields: [invoiceId], references: [id])
  OrderItem        OrderItem       @relation(fields: [orderItemId], references: [id])

  @@index([invoiceId])
  @@index([orderItemId])
}

model Item {
  id                   String                 @id @default(cuid())
  code                 String                 @unique
  description          String
  unitId               String
  unitPrice            Decimal                @db.Decimal(10, 2)
  costPrice            Decimal                @default(0) @db.Decimal(10, 2)
  image                String?
  status               String                 @default("active")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  minStock             Decimal                @default(0) @db.Decimal(10, 2)
  quantity             Decimal                @default(0) @db.Decimal(10, 2)
  height               Decimal?               @db.Decimal(10, 2)
  width                Decimal?               @db.Decimal(10, 2)
  depth                Decimal?               @db.Decimal(10, 2)
  InventoryTransaction InventoryTransaction[]
  Unit                 Unit                   @relation(fields: [unitId], references: [id])
  ItemCategory         ItemCategory[]
  PurchaseItem         PurchaseItem[]
  QuotationItem        QuotationItem[]
  ModuleGroupItem      ModuleGroupItem[]

  @@index([code])
  @@index([status])
  @@index([unitId])
}

model ItemCategory {
  id         String   @id @default(cuid())
  itemId     String
  categoryId String
  createdAt  DateTime @default(now())
  Category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  Item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, categoryId])
  @@index([categoryId])
  @@index([itemId])
}

model ItemGroup {
  id            String          @id @default(cuid())
  code          String?
  description   String
  quantity      Decimal?        @db.Decimal(10, 2)
  number        Int?
  sortOrder     Int             @default(0)
  moduleGroupId String?
  sectionId     String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  baseUnit      String?
  baseUnitPrice Decimal?        @db.Decimal(10, 2)
  Section       Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  QuotationItem QuotationItem[]

  @@index([sectionId])
}

model JournalEntry {
  id               String             @id @default(cuid())
  entryNumber      String             @unique
  date             DateTime           @default(now())
  voucherId        String
  description      String?
  status           String             @default("posted")
  createdBy        String
  postedBy         String
  postedAt         DateTime
  createdAt        DateTime           @default(now())
  Voucher          Voucher            @relation(fields: [voucherId], references: [id])
  JournalEntryLine JournalEntryLine[]

  @@index([date])
  @@index([entryNumber])
  @@index([status])
  @@index([voucherId])
}

model JournalEntryLine {
  id               String         @id @default(cuid())
  lineNumber       Int
  debitAmount      Decimal        @default(0) @db.Decimal(12, 2)
  creditAmount     Decimal        @default(0) @db.Decimal(12, 2)
  description      String?
  journalEntryId   String
  chartOfAccountId String
  createdAt        DateTime       @default(now())
  clientId         String?
  supplierId       String?
  userId           String?
  organizationId   String?
  projectId        String?
  Project          Project?       @relation(fields: [projectId], references: [id])
  ChartOfAccount   ChartOfAccount @relation(fields: [chartOfAccountId], references: [id])
  Client           Client?        @relation(fields: [clientId], references: [id])
  JournalEntry     JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  Organization     Organization?  @relation(fields: [organizationId], references: [id])
  Supplier         Supplier?      @relation(fields: [supplierId], references: [id])
  User             User?          @relation(fields: [userId], references: [id])

  @@index([chartOfAccountId])
  @@index([clientId])
  @@index([journalEntryId])
  @@index([organizationId])
  @@index([supplierId])
  @@index([userId])
  @@index([projectId])
}

model Lead {
  id         String     @id @default(cuid())
  leadNumber String?    @unique
  name       String
  email      String?    @unique
  phone      String
  company    String?
  source     String?
  website    String?
  facebook   String?
  status     LeadStatus @default(NEW)
  ownerId    String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  isTrash    Boolean    @default(false)
  deletedAt  DateTime?
  User       User       @relation(fields: [ownerId], references: [id])
  Note       Note[]
  Task       Task[]
  
  categoryId String?
  Category   Category?  @relation(fields: [categoryId], references: [id])
  reference  String?
  photo      String?

  @@index([ownerId])
  @@index([status])
  @@index([isTrash])
  @@index([categoryId])
}

model ModuleGroup {
  id              String            @id @default(cuid())
  code            String?           @unique
  name            String
  description     String?
  type            String            @default("Combo") // Combo, Offer, etc.
  price           Decimal           @default(0) @db.Decimal(12, 2)
  sortOrder       Int               @default(0)
  status          String            @default("active")
  createdBy       String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  User            User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  ModuleGroupItem ModuleGroupItem[]

  @@index([createdBy])
  @@index([status])
}

model ModuleGroupItem {
  id            String          @id @default(cuid())
  sl            Int
  itemId        String
  quantity      Decimal         @default(1) @db.Decimal(10, 2)
  unitPrice     Decimal?        @db.Decimal(10, 2) // Optional individual price override
  amount        Decimal?        @db.Decimal(12, 2)
  sortOrder     Int             @default(0)
  moduleGroupId String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  ModuleGroup   ModuleGroup     @relation(fields: [moduleGroupId], references: [id], onDelete: Cascade)
  Item          Item            @relation(fields: [itemId], references: [id])
  QuotationItem QuotationItem[]

  @@index([moduleGroupId])
  @@index([itemId])
}

model ModuleOperation {
  id          String   @id @default(cuid())
  module      String
  operation   String
  label       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([module, operation])
  @@index([isActive])
  @@index([module])
}

// Notification model moved to end

model Opportunity {
  id                String           @id @default(cuid())
  opportunityNumber String?          @unique
  title             String
  clientId          String
  value             Decimal?         @db.Decimal(12, 2)
  stage             OpportunityStage @default(DISCOVERY)
  ownerId           String
  contactId         String
  expectedCloseDate DateTime?
  nextActivityAt    DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  Client            Client           @relation(fields: [clientId], references: [id])
  Contact           Contact          @relation(fields: [contactId], references: [id])
  User              User             @relation(fields: [ownerId], references: [id])
  Note              Note[]
  Task              Task[]
  Quotation         Quotation[]
  Project           Project[]

  @@index([clientId])
  @@index([contactId])
  @@index([ownerId])
  @@index([stage])
  @@index([opportunityNumber])
}

model Order {
  id               String             @id @default(cuid())
  orderNumber      String             @unique
  quotationId      String             @unique
  clientId         String
  totalValue       Decimal            @db.Decimal(12, 2)
  status           OrderStatus        @default(PENDING)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  Delivery         Delivery[]
  DeliveryLedger   DeliveryLedger[]
  DeliverySchedule DeliverySchedule[]
  Invoice          Invoice[]
  Client           Client             @relation(fields: [clientId], references: [id])
  Quotation        Quotation          @relation(fields: [quotationId], references: [id])
  OrderItem        OrderItem[]
  Voucher          Voucher[]
  Project          Project[]

  @@index([clientId])
  @@index([quotationId])
  @@index([status])
}

model OrderItem {
  id                   String                 @id @default(cuid())
  orderId              String
  quotationItemId      String
  itemId               String?
  description          String
  quantity             Decimal                @db.Decimal(10, 2)
  unitPrice            Decimal                @db.Decimal(10, 2)
  amount               Decimal                @db.Decimal(12, 2)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  DeliveryLedger       DeliveryLedger[]
  DeliveryScheduleItem DeliveryScheduleItem[]
  InvoiceItem          InvoiceItem[]
  Order                Order                  @relation(fields: [orderId], references: [id])
  QuotationItem        QuotationItem          @relation(fields: [quotationItemId], references: [id])

  @@index([orderId])
  @@index([quotationItemId])
}

model Organization {
  id               String             @id @default(cuid())
  name             String
  details          String?
  address          String?
  phone            String?
  email            String?
  website          String?
  logo             String?
  status           String             @default("active")
  createdBy        String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  JournalEntryLine JournalEntryLine[]
  User             User               @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  Quotation        Quotation[]
  Voucher          Voucher[]
  VoucherLine      VoucherLine[]

  @@index([createdBy])
  @@index([name])
  @@index([status])
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  code      String
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([code])
  @@index([email])
  @@index([expires])
}

model PermissionTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  User        User[]

  @@index([isActive])
  @@index([name])
}

model Purchase {
  id                            String         @id @default(cuid())
  purchaseNumber                String         @unique
  supplierId                    String
  date                          DateTime       @default(now())
  status                        PurchaseStatus @default(DRAFT)
  notes                         String?
  attachmentUrl                 String?
  subTotal                      Decimal        @db.Decimal(12, 2)
  discount                      Decimal?       @db.Decimal(12, 2)
  tax                           Decimal?       @db.Decimal(12, 2)
  grandTotal                    Decimal        @db.Decimal(12, 2)
  isTrash                       Boolean        @default(false)
  createdBy                     String
  updatedBy                     String?
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt
  User_Purchase_createdByToUser User           @relation("Purchase_createdByToUser", fields: [createdBy], references: [id], onDelete: Cascade)
  Supplier                      Supplier       @relation(fields: [supplierId], references: [id])
