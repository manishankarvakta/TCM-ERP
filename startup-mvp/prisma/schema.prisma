  status           ProjectStatus @default(PLANNING)
  priority         String        @default("NORMAL")
  startDate        DateTime?
  endDate          DateTime?
  budget           Decimal?      @db.Decimal(12, 2)
  clientId         String
  opportunityId    String?
  orderId          String?
  ownerId          String
  projectManagerId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  Client           Client        @relation(fields: [clientId], references: [id])
  Opportunity      Opportunity?  @relation(fields: [opportunityId], references: [id])
  Order            Order?        @relation(fields: [orderId], references: [id])
  Owner            User          @relation("ProjectOwner", fields: [ownerId], references: [id])
  ProjectManager   User?         @relation("ProjectManager", fields: [projectManagerId], references: [id])
  Milestones       Milestone[]
  Tasks            Task[]
  Notes            Note[]
  Docs             Doc[]
  Timesheets       Timesheet[]
  JournalEntryLines JournalEntryLine[]
  VoucherLines      VoucherLine[]
  PurchaseItems     PurchaseItem[]
  InvoiceItems      InvoiceItem[]
  PayrollItems      PayrollItem[]
  ProjectBudgets    ProjectBudget[]

  @@index([clientId])
  @@index([opportunityId])
  @@index([orderId])
  @@index([ownerId])
  @@index([projectManagerId])
  @@index([status])
}

model Milestone {
  id          String          @id @default(cuid())
  title       String
  description String?
  status      MilestoneStatus @default(PLANNED)
  startDate   DateTime?
  dueDate     DateTime?
  order       Int             @default(0)
  projectId   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  Project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  Issues      Issue[]
  Tasks       Task[]
  Notes       Note[]
  Docs        Doc[]
  
  tags        Tag[]
  Checklists  Checklist[]
  
  BlockedBy   MilestoneDependency[] @relation("DependentMilestones")
  Blocking    MilestoneDependency[] @relation("BlockingMilestones")

  @@index([projectId])
  @@index([status])
}

model MilestoneDependency {
  id               String    @id @default(cuid())
  blockingId       String
  dependentId      String
  BlockingMilestone  Milestone @relation("BlockingMilestones", fields: [blockingId], references: [id], onDelete: Cascade)
  DependentMilestone Milestone @relation("DependentMilestones", fields: [dependentId], references: [id], onDelete: Cascade)
  
  createdAt        DateTime  @default(now())
  
  @@unique([blockingId, dependentId])
}

model Issue {
  id          String      @id @default(cuid())
  issueNumber String?     @unique
  title       String
  description String?
  status      IssueStatus @default(OPEN)
  priority    String      @default("NORMAL")
  type        String      @default("TASK")
  startDate   DateTime?
  estimatedHours Float?
  actualHours    Float?
  milestoneId String
  reporterId  String
  assigneeId  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  Milestone   Milestone   @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  Reporter    User        @relation("IssueReporter", fields: [reporterId], references: [id])
  Assignee    User?       @relation("IssueAssignee", fields: [assigneeId], references: [id])
  Tasks       Task[]
  Notes       Note[]
  Docs        Doc[]
  Timesheets  Timesheet[]

  tags        Tag[]
  Checklists  Checklist[]

  @@index([milestoneId])
  @@index([reporterId])
  @@index([assigneeId])
  @@index([status])
}

enum TimesheetStatus {
  PENDING
  APPROVED
  REJECTED
}

model Timesheet {
  id          String   @id @default(cuid())
  hours       Decimal  @db.Decimal(5, 2)
  date        DateTime
  description String?
  projectId   String
  issueId     String?
  employeeId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  Project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  Issue       Issue?   @relation(fields: [issueId], references: [id], onDelete: SetNull)
  Employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  status       TimesheetStatus @default(PENDING)
  isBillable   Boolean         @default(true)
  taskId       String?
  Task         Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  approvedById String?
  ApprovedBy   User?           @relation("TimesheetApprover", fields: [approvedById], references: [id])

  @@index([projectId])
  @@index([employeeId])
  @@index([issueId])
  @@index([taskId])
  @@index([date])
  @@index([status])
  @@index([projectId, taskId])
  @@index([employeeId, date])
}

enum ProjectStatus {
  DRAFT
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  REVIEW
  COMPLETED
  CLOSED
}

model Warehouse {
  id        String     @id @default(cuid())
  name      String
  code      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  isTrash   Boolean    @default(false)
  status    String     @default("active")
  employees Employee[] @relation("WarehouseEmployees")
  holidays  Holiday[]
  defaultUsers User[]   @relation("UserDefaultWarehouse")
}

model Shift {
  id           String       @id @default(cuid())
  name         String
  startTime    String
  endTime      String
  graceMinutes Int          @default(0)
  lateAfter    Int          @default(15)
  halfDayAfter Int          @default(120)
  otStartAfter Int          @default(30)
  status       String       @default("active")
  isTrash      Boolean      @default(false)
  createdBy    String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  attendances  Attendance[]
  employees    Employee[]   @relation("EmployeeShift")
  creator      User         @relation("ShiftCreator", fields: [createdBy], references: [id])

  @@index([status])
  @@index([isTrash])
  @@index([createdBy])
}

model Holiday {
  id          String     @id @default(cuid())
  name        String
  date        DateTime   @db.Date
  warehouseId String?
  status      String     @default("active")
  isTrash     Boolean    @default(false)
  createdBy   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  creator     User       @relation("HolidayCreator", fields: [createdBy], references: [id])
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([date])
  @@index([warehouseId])
  @@index([createdBy])
}

model LeaveType {
  id           String             @id @default(cuid())
  name         String
  category     LeaveCategory
  defaultDays  Int                @default(0)
  isPaid       Boolean            @default(true)
  status       String             @default("active")
  isTrash      Boolean            @default(false)
  createdBy    String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  applications LeaveApplication[]
  creator      User               @relation("LeaveTypeCreator", fields: [createdBy], references: [id])
}

model LeaveApplication {
  id          String       @id @default(cuid())
  employeeId  String
  leaveTypeId String
  startDate   DateTime     @db.Date
  endDate     DateTime     @db.Date
  totalDays   Int
  reason      String?
  status      LeaveStatus  @default(PENDING)
  managerId   String?
  hrId        String?
  isTrash     Boolean      @default(false)
  createdBy   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attendances Attendance[]
  creator     User         @relation("LeaveAppCreator", fields: [createdBy], references: [id])
  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  hr          User?        @relation("LeaveHR", fields: [hrId], references: [id])
  leaveType   LeaveType    @relation(fields: [leaveTypeId], references: [id])
  manager     User?        @relation("LeaveManager", fields: [managerId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([managerId])
  @@index([hrId])
}

model AttendanceLog {
  id         String           @id @default(cuid())
  employeeId String
  timestamp  DateTime
  source     AttendanceSource
  deviceId   String?
  createdAt  DateTime         @default(now())
  device     BiometricDevice? @relation(fields: [deviceId], references: [id])
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, timestamp])
  @@index([employeeId])
  @@index([timestamp])
}

model Attendance {
  id                 String            @id @default(cuid())
  employeeId         String
  date               DateTime          @db.Date
  shiftId            String?
  checkIn            DateTime?
  checkOut           DateTime?
  workHours          Decimal           @default(0) @db.Decimal(5, 2)
  otHours            Decimal           @default(0) @db.Decimal(5, 2)
  status             AttendanceStatus
  isManual           Boolean           @default(false)
  notes              String?
  isLocked           Boolean           @default(false)
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  leaveApplicationId String?
  creator            User?             @relation("AttendanceCreator", fields: [createdBy], references: [id])
  employee           Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveApplication   LeaveApplication? @relation(fields: [leaveApplicationId], references: [id])
  shift              Shift?            @relation(fields: [shiftId], references: [id])
  updater            User?             @relation("AttendanceUpdater", fields: [updatedBy], references: [id])

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
  @@index([employeeId, date])
  @@index([isLocked])
}

model Overtime {
  id          String   @id @default(cuid())
  employeeId  String
  date        DateTime @db.Date
  hours       Decimal  @db.Decimal(5, 2)
  ratePerHour Decimal  @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(12, 2)
  status      String   @default("approved")
  isLocked    Boolean  @default(false)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  creator     User     @relation("OvertimeCreator", fields: [createdBy], references: [id])
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([date])
  @@index([status])
}

model EmployeeLoan {
  id                 String     @id @default(cuid())
  employeeId         String
  amount             Decimal    @db.Decimal(12, 2)
  monthlyInstallment Decimal    @db.Decimal(12, 2)
  remainingBalance   Decimal    @db.Decimal(12, 2)
  issueDate          DateTime   @db.Date
  tenureMonths       Int
  purpose            String?
  status             LoanStatus @default(PENDING)
  voucherId          String?
  approvedBy         String?
  createdBy          String
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  approver           User?      @relation("LoanApprover", fields: [approvedBy], references: [id])
  employee           Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  voucher            Voucher?   @relation(fields: [voucherId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([status])
  @@index([voucherId])
}

model EmployeeSalary {
  id            String   @id @default(cuid())
  employeeId    String   @unique
  basic         Decimal  @default(0) @db.Decimal(12, 2)
  houseRent     Decimal  @default(0) @db.Decimal(12, 2)
  medical       Decimal  @default(0) @db.Decimal(12, 2)
  transport     Decimal  @default(0) @db.Decimal(12, 2)
  foodAllowance Decimal  @default(0) @db.Decimal(12, 2)
  taxPercentage Decimal  @default(0) @db.Decimal(5, 2)
  pfPercentage  Decimal  @default(0) @db.Decimal(5, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Payroll {
  id             String        @id @default(cuid())
  payrollNumber  String        @unique
  month          Int
  year           Int
  dateGenerated  DateTime      @default(now())
  status         PayrollStatus @default(DRAFT)
  totalAmount    Decimal       @default(0) @db.Decimal(12, 2)
  voucherId      String?       @unique
  paymentVchId   String?       @unique
  notes          String?
  isTrash        Boolean       @default(false)
  createdBy      String
  approvedBy     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  approver       User?         @relation("PayrollApprover", fields: [approvedBy], references: [id])
  creator        User          @relation("PayrollCreator", fields: [createdBy], references: [id])
  paymentVoucher Voucher?      @relation("PayrollPaymentVoucher", fields: [paymentVchId], references: [id], onDelete: Restrict)
  voucher        Voucher?      @relation("PayrollVoucher", fields: [voucherId], references: [id], onDelete: Restrict)
  items          PayrollItem[]

  @@index([month, year])
  @@index([status])
  @@index([voucherId])
  @@index([month, year, status])
}

model PayrollItem {
  id              String   @id @default(cuid())
  payrollId       String
  employeeId      String
  basic           Decimal  @default(0) @db.Decimal(12, 2)
  houseRent       Decimal  @default(0) @db.Decimal(12, 2)
  medical         Decimal  @default(0) @db.Decimal(12, 2)
  transport       Decimal  @default(0) @db.Decimal(12, 2)
  foodAllowance   Decimal  @default(0) @db.Decimal(12, 2)
  otAmount        Decimal  @default(0) @db.Decimal(12, 2)
  bonus           Decimal  @default(0) @db.Decimal(12, 2)
  grossPay        Decimal  @default(0) @db.Decimal(12, 2)
  absentDeduction Decimal  @default(0) @db.Decimal(12, 2)
  loanDeduction   Decimal  @default(0) @db.Decimal(12, 2)
  taxDeduction    Decimal  @default(0) @db.Decimal(12, 2)
  pfDeduction     Decimal  @default(0) @db.Decimal(12, 2)
  totalDeduction  Decimal  @default(0) @db.Decimal(12, 2)
  netPay          Decimal  @default(0) @db.Decimal(12, 2)
  status          String   @default("unpaid")
  projectId       String?
  Project         Project? @relation(fields: [projectId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  employee        Employee @relation(fields: [employeeId], references: [id])
  payroll         Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@unique([payrollId, employeeId])
  @@index([employeeId])
  @@index([status])
  @@index([employeeId, status])
}

model BiometricSyncLog {
  id           String           @id @default(cuid())
  syncTime     DateTime         @default(now())
  vendor       String
  deviceId     String?
  recordsCount Int              @default(0)
  status       String           @default("SUCCESS")
  errorMessage String?
  syncedBy     String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  device       BiometricDevice? @relation(fields: [deviceId], references: [id])
  user         User             @relation(fields: [syncedBy], references: [id])

  @@index([syncTime])
  @@index([vendor])
}

model BiometricDevice {
  id             String             @id @default(cuid())
  name           String
  vendor         String
  connectionType String             @default("IP")
  ipAddress      String?
  port           Int?               @default(4370)
  apiKey         String?
  serialNumber   String?            @unique
  location       String?
  status         String             @default("active")
  lastSyncAt     DateTime?
  createdBy      String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  attendanceLogs AttendanceLog[]
  syncLogs       BiometricSyncLog[]

  @@index([vendor])
  @@index([status])
}

enum EmploymentType {
  PERMANENT
  TEMPORARY
  CONTRACT
  INTERN
  DAILY_WORKER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  LATE
  HALF_DAY
  HOLIDAY
  WEEKEND
}

enum LeaveCategory {
  CASUAL
  SICK
  ANNUAL
  MATERNITY
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  MANAGER_APPROVED
  HR_APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  REVIEWED
  APPROVED
  POSTED
  PAID
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  CLOSED
}

model ProjectBudget {
  id          String   @id @default(cuid())
  projectId   String
  category    String   // "LABOR", "MATERIALS", "SOFTWARE", "OTHER"
  amount      Decimal  @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  Project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@index([projectId])
}

enum AttendanceSource {
  MANUAL
  WEB
  MOBILE
  BIOMETRIC
  API
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  
  Tasks       Task[]
  Issues      Issue[]
  Milestones  Milestone[]
  
  createdAt DateTime @default(now())
}

model Checklist {
  id          String   @id @default(cuid())
  title       String   @default("Checklist")
  
  entityType  String
  entityId    String
  
  Items       ChecklistItem[]
  
  Task        Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      String?
  Issue       Issue?      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  issueId     String?
  Milestone   Milestone?  @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  milestoneId String?
  
  createdAt   DateTime @default(now())
}

model ChecklistItem {
  id          String   @id @default(cuid())
  checklistId String
  content     String
  isCompleted Boolean  @default(false)
  order       Int      @default(0)
  
  Checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}
