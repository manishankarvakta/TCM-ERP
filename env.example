# ============================================
# DATABASE CONFIGURATION
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=startup_mvp
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/startup_mvp?schema=public"

# ============================================
# MINIO CONFIGURATION
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your-minio-root-password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=espaciofiles
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your-minio-secret-key

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_PASSWORD=your-redis-password
REDIS_URL=redis://localhost:6379

# ============================================
# NEXTAUTH CONFIGURATION
# Generate with: openssl rand -base64 32
# ============================================
NEXTAUTH_SECRET=your-nextauth-secret-key-base64
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ============================================
# APPLICATION URLS
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=YourAppName

# ============================================
# BACKUP ENCRYPTION CONFIGURATION
# Generate encryption key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hexadecimal characters (32 bytes = 256 bits)
# ============================================
BACKUP_ENCRYPTION_KEY=your-64-character-hexadecimal-encryption-key-here
BACKUP_ENCRYPTION_ENABLED=true

# ============================================
# LOCAL FILE STORAGE
# ============================================
UPLOAD_DIR=./uploads
BACKUP_ROOT_DIR=./backups

# ============================================
# BIOMETRIC INTEGRATION
# ============================================
# Secret key used by the biometric Python script to securely communicate with this Next.js app.
BIOMETRIC_API_KEY=your-secure-biometric-api-key
