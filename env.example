# Dokploy Environment Variables Configuration
# Copy this file to your Dokploy Environment section or use as .env

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
POSTGRES_USER=postgresUser
POSTGRES_PASSWORD=postgresPass
POSTGRES_DB=startup_mvp

# ==========================================
# Authentication Configuration (NextAuth)
# ==========================================
NEXTAUTH_SECRET=I5p97Jpv0Xr7Zz7Ay8W6+O2eLmBR6N2gllGrZO01Szo=

# Replace with your actual Dokploy public domain (e.g. https://erp.yourdomain.com)
NEXTAUTH_URL=https://your-dokploy-domain.com
AUTH_URL=https://your-dokploy-domain.com
AUTH_TRUST_HOST=true

# ==========================================
# Application Configuration
# ==========================================
# Replace with your actual Dokploy public domain
NEXT_PUBLIC_APP_URL=https://your-dokploy-domain.com

# Secret key used by the biometric Python script to securely communicate with this Next.js app.
# Generate a strong random string (e.g. using `openssl rand -hex 32`)
BIOMETRIC_API_KEY=your-secure-biometric-api-key

# ==========================================
# Redis Configuration
# ==========================================
# Must match the service name defined in docker-compose-dokploy.yml
REDIS_URL=redis://fferp-redis:6379

# ==========================================
# Email / SMTP Configuration (Optional)
# ==========================================
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your-email-password-here
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME="Startup MVP"

# ==========================================
# Backup Encryption Configuration
# ==========================================
# Generate encryption key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hexadecimal characters (32 bytes = 256 bits)
BACKUP_ENCRYPTION_KEY=your-64-character-hexadecimal-encryption-key-here
BACKUP_ENCRYPTION_ENABLED=true
