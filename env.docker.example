# Docker Compose Environment Variables
# Copy this file to .env.docker at the root level (APP_TEMPLATE/) and update with your values

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=startup_mvp
POSTGRES_PORT=5432

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=espacio-files
MINIO_USE_SSL=false
# Whether MinIO is publicly accessible (affects download URLs)
MINIO_PUBLICLY_ACCESSIBLE=false

# MinIO Public URL
# Local development: Use localhost (MinIO port is exposed)
MINIO_PUBLIC_URL=http://localhost:9000

# Dokploy/Production: Use public MinIO domain
MINIO_PUBLIC_URL=https://minio.espaciobd.com
MINIO_USE_SSL=true
MINIO_CORS_ORIGIN=https://dev.espaciobd.com

# Application Configuration
APP_PORT=3000
NEXTAUTH_SECRET=I5p97Jpv0Xr7Zz7Ay8W6+O2eLmBR6N2gllGrZO01Szo=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Redis Configuration (optional)
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Email Configuration - Techsoul BD SMTP
SMTP_HOST=mail.techsoulbd.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@techsoulbd.com
SMTP_PASS=your-email-password-here
EMAIL_FROM=no-reply@techsoulbd.com
EMAIL_FROM_NAME=Startup MVP

