# Docker Compose Environment Variables
# Copy this file to .env.docker at the root level (APP_TEMPLATE/) and update with your values

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=startup_mvp
POSTGRES_PORT=5432

# Application Configuration
APP_PORT=3000
NEXTAUTH_SECRET=I5p97Jpv0Xr7Zz7Ay8W6+O2eLmBR6N2gllGrZO01Szo=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=fferp.aamardokan.online,ferrarifashionbd.cloud,www.ferrarifashionbd.cloud,www.fferp.aamardokan.online

# Redis Configuration (optional)
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Email Configuration - Techsoul BD SMTP
SMTP_HOST=mail.techsoulbd.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@techsoulbd.com
SMTP_PASS=your-email-password-here
EMAIL_FROM=no-reply@techsoulbd.com
EMAIL_FROM_NAME=Startup MVP

# Backup Encryption Configuration
# Generate encryption key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hexadecimal characters (32 bytes = 256 bits)
BACKUP_ENCRYPTION_KEY=your-64-character-hexadecimal-encryption-key-here
BACKUP_ENCRYPTION_ENABLED=true

