# Local files
PORT=5555
DATA_DIR=./data
LOG_DIR=./logs

# Device defaults
ZKTECO_DEFAULT_PORT=4370
DEVICE_CONNECT_TIMEOUT_MS=10000

# Optional local mode
LOCAL_CONFIG_FALLBACK=true
